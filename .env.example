NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/school_erp?schema=public"

JWT_SECRET="change-this-to-a-32-character-random-string"
JWT_REFRESH_SECRET="change-this-to-another-32-character-random-string"
JWT_EXPIRES_IN="4h"
JWT_REFRESH_EXPIRES_IN="4h"

CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# Razorpay (leave blank until KYC/setup is complete — checkout stays in stub mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP (leave blank until ready — renewal reminders/receipts log-only until configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ShikshaMatrix <billing@shikshamatrix.in>"
SMTP_SECURE="false"
