  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([scheduledDate])
  @@index([assignedToId])
  @@map("due_follow_ups")
}

model DueWaiver {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  waiverNo  String  @unique @db.VarChar(30)
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  invoiceId Int?

  waiverType      WaiverType @default(PARTIAL_FEE_WAIVER)
  requestedAmount Decimal    @db.Decimal(12, 2)
  approvedAmount  Decimal?   @db.Decimal(12, 2)
  reason          String     @db.VarChar(500)
  supportingDoc   String?    @db.VarChar(500)

  status                 WaiverStatus @default(PENDING)
  // 3-level approval
  accountantApprovedById Int?
  accountantApprovedBy   User?        @relation("WaiverAccountant", fields: [accountantApprovedById], references: [id])
  accountantApprovedAt   DateTime?
  principalApprovedById  Int?
  principalApprovedBy    User?        @relation("WaiverPrincipal", fields: [principalApprovedById], references: [id])
  principalApprovedAt    DateTime?
  mgmtApprovedById       Int?
  mgmtApprovedBy         User?        @relation("WaiverMgmt", fields: [mgmtApprovedById], references: [id])
  mgmtApprovedAt         DateTime?

  rejectedById    Int?
  rejectedBy      User?     @relation("WaiverRejecter", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(300)

  requestedById Int
  requestedBy   User     @relation("WaiverRequester", fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  approvedById  Int?
  approvedBy    User?    @relation("WaiverApprover", fields: [approvedById], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("due_waivers")
}

// ── DISCOUNTS & SCHOLARSHIPS MODELS ──────────────────────────

model ScholarshipProgram {
  id              Int               @id @default(autoincrement())
  schoolId        Int
  school          School            @relation(fields: [schoolId], references: [id])
  name            String            @db.VarChar(200)
  code            String            @db.VarChar(30)
  description     String?           @db.VarChar(600)
  scholarshipType ScholarshipType   @default(MERIT)
  status          ScholarshipStatus @default(ACTIVE)

  // Eligibility
  minPercentage     Decimal? @db.Decimal(5, 2) // min % to qualify
  applicableClasses Int[]
  academicYearId    Int?

  // Benefit
  discountType     DiscountType @default(PERCENTAGE)
  discountValue    Decimal      @db.Decimal(10, 2) // % or ₹
  maxBenefitAmount Decimal?     @db.Decimal(12, 2) // cap

  // Duration
  validFrom   DateTime? @db.Date
  validUntil  DateTime? @db.Date
  isRenewable Boolean   @default(false)

  totalSeats  Int? // max students
  filledSeats Int  @default(0)

  studentScholarships StudentScholarship[]

  createdById Int
  createdBy   User     @relation("ScholarshipCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("scholarship_programs")
}

model StudentScholarship {
  id        Int                 @id @default(autoincrement())
  schoolId  Int
  school    School              @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student             @relation(fields: [studentId], references: [id])
  programId Int?
  program   ScholarshipProgram? @relation(fields: [programId], references: [id])

  name            String       @db.VarChar(200) // can be custom
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Decimal      @db.Decimal(10, 2)
  academicYearId  Int?
  applicableHeads String[]

  // Benefit preview
  originalFee   Decimal? @db.Decimal(12, 2)
  benefitAmount Decimal? @db.Decimal(12, 2)
  finalFee      Decimal? @db.Decimal(12, 2)

  validFrom  DateTime? @db.Date
  validUntil DateTime? @db.Date
  isActive   Boolean   @default(true)
  remarks    String?   @db.VarChar(300)

  // 3-level approval
  status         WaiverStatus @default(PENDING)
  assignedById   Int?
  assignedBy     User?        @relation("ScholarshipAssigner", fields: [assignedById], references: [id])
  approvedById   Int?
  approvedBy     User?        @relation("ScholarshipApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?      @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, programId])
  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("student_scholarships")
}

// ── TRANSACTIONS MODELS ───────────────────────────────────────

model TxnAdjustment {
  id           Int      @id @default(autoincrement())
