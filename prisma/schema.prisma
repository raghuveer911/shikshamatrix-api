// ─────────────────────────────────────────
// PARENT-STUDENT
// ─────────────────────────────────────────

model ParentStudent {
  id        Int    @id @default(autoincrement())
  parentId  Int
  studentId Int
  relation  String @default("parent") @db.VarChar(20)

  parent  User @relation("ParentRelation", fields: [parentId], references: [id])
  student User @relation("StudentRelation", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

// ─────────────────────────────────────────
// STUDENTS
// ─────────────────────────────────────────

model Student {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  schoolId        Int
  school          School    @relation(fields: [schoolId], references: [id])
  classId         Int?
  class           Class?    @relation(fields: [classId], references: [id])
  rollNumber      String    @db.VarChar(20)
  admissionNumber String    @db.VarChar(30)
  dateOfBirth     DateTime?
  bloodGroup      String?   @db.VarChar(5)
  address         String?   @db.VarChar(500)
  admissionDate   DateTime  @default(now())
  isActive        Boolean   @default(true)

  //academicDetails
  admissionSource   AdmissionSource @default(WALK_IN)
  studentStatus     StudentStatus   @default(ACTIVE)
  houseAssignment   String?         @db.VarChar(50)
  openingDueBalance Decimal         @default(0) @db.Decimal(10, 2)
  previousSchool    String?         @db.VarChar(200)
  previousBoard     String?         @db.VarChar(100)
  previousTcNumber  String?         @db.VarChar(50)
  previousClass     String?         @db.VarChar(20)
  previousPercent   Decimal?        @db.Decimal(5, 2)

  // personalDetails
  firstName     String? @db.VarChar(50)
  middleName    String? @db.VarChar(50)
  lastName      String? @db.VarChar(50)
  category      String? @db.VarChar(20)
  religion      String? @db.VarChar(50)
  caste         String? @db.VarChar(50)
  subCaste      String? @db.VarChar(50)
  motherTongue  String? @db.VarChar(50)
  placeOfBirth  String? @db.VarChar(100)
  nationality   String  @default("India") @db.VarChar(50)
  aadhaarNumber String? @db.VarChar(12)
  isBPL         Boolean @default(false)
  isRTE         Boolean @default(false)
  studentPhone  String? @db.VarChar(15)
  studentEmail  String? @db.VarChar(150)
  photoUrl      String? @db.VarChar(500)
  rfidNumber    String? @db.VarChar(50)

  //health
  height            Decimal? @db.Decimal(5, 2)
  weight            Decimal? @db.Decimal(5, 2)
  medicalHistory    String?  @db.VarChar(1000)
  allergies         String?  @db.VarChar(500)
  currentMedication String?  @db.VarChar(300)
  doctorContact     String?  @db.VarChar(15)
  disabilityInfo    String?  @db.VarChar(300)

  //bank
  bankName          String?  @db.VarChar(100)
  bankAccountHolder String?  @db.VarChar(100)
  bankAccountNumber String?  @db.VarChar(30)
  bankIfsc          String?  @db.VarChar(11)
  scholarshipType   String?  @db.VarChar(100)
  scholarshipAmount Decimal? @db.Decimal(10, 2)

  isDraft Boolean @default(false)

  attendance              Attendance[]
  invoices                Invoice[]
  promotionHistory        PromotionHistory[]
  admissionDocuments      AdmissionDocument[]
  parentDetail            ParentDetail?
  behaviourRecords        BehaviourRecord[]
  archives                StudentArchive[]
  marksEntries            MarksEntry[]
  coCurricularAssessments CoCurricularAssessment[]
  detailedAssessments     StudentDetailedAssessment[]
  resultReviews           StudentResultReview[]
  generatedReportCards    GeneratedReportCard[]
  studentResults          StudentResult[]
  examAttendanceRecords   ExamAttendanceRecord[]
  examAttempts            OnlineExamAttempt[]
  attemptRecords          TestAttemptRecord[]
  evaluationRecords       EvaluationRecord[]
  recheckRequests         RecheckRequest[]
  activityEvents          ExamActivityEvent[]
  candidateStates         ExamCandidateState[]
  examIncidents           ExamIncident[]
  complaints              Complaint[]
  feePlans                StudentFeePlan[]
  feeInstallments         StudentFeeInstallment[]
  feeDiscounts            FeeDiscount[]
  feeFines                FeeFine[]
  feeRefunds              FeeRefund[]
  feeReceipts             FeeReceipt[]
  dueNotices              DueNotice[]
  dueFollowUps            DueFollowUp[]
  dueWaivers              DueWaiver[]
  scholarships            StudentScholarship[]
  txnAdjustments          TxnAdjustment[]
  carryForwards           CarryForward[]
  onlinePayments          OnlinePayment[]
  paymentLinks            PaymentLink[]
  certRequests            CertRequest[]
  assignmentSubmissions   StudyAssignmentSubmission[]
  libBookmarks            LibResourceBookmark[]
  libResourceViews        LibResourceView[]
  hostelAllocations       HostelAllocation[]

  certIssued      CertIssued[]     @relation("StudentCerts")
  libIssues       LibIssue[]       @relation("StudentIssues")
  libFines        LibFine[]        @relation("StudentFines")
  libMembership   LibMembership?   @relation("StudentMembership")
  libReservations LibReservation[] @relation("StudentReservations")
  studyBuddySessions StudyBuddySession[]
  studyQuizSessions   StudyQuizSession[]

  @@unique([schoolId, classId, rollNumber])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([schoolId, isActive])
  @@map("students")
}

