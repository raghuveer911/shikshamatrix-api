// ─────────────────────────────────────────
// CLASSES
// ─────────────────────────────────────────

model Class {
  id             Int    @id @default(autoincrement())
  schoolId       Int
  school         School @relation(fields: [schoolId], references: [id])
  classTeacherId Int?
  classTeacher   Staff? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  name         String  @db.VarChar(20)
  classNumber  String  @db.VarChar(5)
  section      String  @db.VarChar(5)
  stream       String? @db.VarChar(20) // "ARTS" | "SCIENCE" | "COMMERCE" — only used for classNumber 11/12
  medium       String? @db.VarChar(20) // e.g. "English", "Hindi"
  sortOrder    Int     @default(0) // display order in class lists (e.g. Nursery before LKG before Class 1)
  room         String? @db.VarChar(20)
  shift        Shift   @default(MORNING)
  academicYear String  @db.VarChar(10)
  capacity     Int     @default(40)
  isActive     Boolean @default(true)

  students               Student[]
  attendance             Attendance[]
  subjectAssignments     SubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  feeStructures          FeeStructure[]
  periodSlots            PeriodSlot[]
  announcements          Announcement[]
  promotionsFrom         PromotionHistory[]      @relation("PromotionFromClass")
  promotionsTo           PromotionHistory[]      @relation("PromotionToClass")
  behaviourRecords       BehaviourRecord[]
  examClasses            ExamClass[]
  examSlots              ExamSlot[]
  marksEntries           MarksEntry[]
  coCurricularSessions   CoCurricularSession[]
  resultReviews          StudentResultReview[]
  studentResults         StudentResult[]
  examDocuments          ExamDocument[]
  examAttendanceSessions ExamAttendanceSession[]
  StudyMaterial          StudyMaterial[]
  StudyAssignment        StudyAssignment[]
  StudyLessonPlan        StudyLessonPlan[]
  LibBook                LibBook[]
  LibDigitalResource     LibDigitalResource[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
  @@index([schoolId, academicYear])
  @@index([schoolId, classNumber])
  @@map("classes")
}

