  itemId            Int
  item              InvItem             @relation(fields: [itemId], references: [id])
  locationId        Int?
  location          InvLocation?        @relation(fields: [locationId], references: [id])
  systemQty         Int                 @default(0)
  physicalQty       Int                 @default(0)
  discrepancyQty    Int                 @default(0)
  discrepancyType   InvDiscrepancyType?
