// ─────────────────────────────────────────

model Subject {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      School      @relation(fields: [schoolId], references: [id])
  classNumber String      @db.VarChar(5) // grade level, e.g. "5", "11" — NOT tied to one section
  name        String      @db.VarChar(100)
  code        String?     @db.VarChar(20)
  isElective  Boolean     @default(false)
  subjectMode SubjectType @default(THEORY)
  credits     Int?
  streamId    Int?
  stream      Stream?     @relation(fields: [streamId], references: [id])
  isActive    Boolean     @default(true)

  assignments    SubjectAssignment[]
  streamSubjects StreamSubject[]

  periodSlots        PeriodSlot[]
  examSubjects       ExamSubject[]
  examSlots          ExamSlot[]
  subjectRemarks     SubjectRemark[]
  examDocuments      ExamDocument[]
  onlineExams        OnlineExam[]

  @@unique([schoolId, classNumber, name])
  @@index([schoolId])
  @@index([schoolId, classNumber])
  @@index([streamId])
  @@map("subjects")
}

// The real "teacher teaches this subject to this section" link —
// previously conflated into Subject itself, which made a subject
// unable to have more than one teacher across sections.
model SubjectAssignment {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  subjectId      Int
  subject        Subject      @relation(fields: [subjectId], references: [id])
  classId        Int // the actual section
  class          Class        @relation(fields: [classId], references: [id])
  teacherId      Int
  teacher        Staff        @relation("SubjectAssignmentTeacher", fields: [teacherId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  weeklyPeriods  Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([subjectId, classId, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@index([academicYearId])
  @@map("subject_assignments")
}

model Stream {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   @db.VarChar(50) // "Science", "Commerce", "Arts"
  code         String?  @db.VarChar(20)
  classNumbers String[] // which grades this stream applies to, e.g. ["11","12"]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subjects       Subject[]
  streamSubjects StreamSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("streams")
}

// Which subjects belong to a stream, and whether they're compulsory
// or part of an elective-choice group (e.g. "pick 1 of Biology/
// Computer Science/Economics" — grouped via groupLabel).
model StreamSubject {
  id           Int     @id @default(autoincrement())
  streamId     Int
  stream       Stream  @relation(fields: [streamId], references: [id])
  subjectId    Int
  subject      Subject @relation(fields: [subjectId], references: [id])
  isCompulsory Boolean @default(true)
  groupLabel   String? @db.VarChar(50)

  @@unique([streamId, subjectId])
  @@index([streamId])
  @@map("stream_subjects")
}

// Replaces the single Class.classTeacherId with proper multi-role
// support (Primary / Assistant / Coordinator) per section per session.
// Class.classTeacherId is kept for backward compatibility with any
// existing code reading it directly — this model is the richer,
// forward-looking source of truth.
model ClassTeacherAssignment {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  school         School           @relation(fields: [schoolId], references: [id])
  classId        Int
  class          Class            @relation(fields: [classId], references: [id])
  staffId        Int
  staff          Staff            @relation("ClassTeacherAssignmentStaff", fields: [staffId], references: [id])
  role           ClassTeacherRole @default(PRIMARY)
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime         @default(now())

  @@unique([classId, role, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([staffId])
  @@map("class_teacher_assignments")
}

// ─────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────

model Holiday {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String       @db.VarChar(150)
  date           DateTime     @db.Date
  endDate        DateTime?    @db.Date // multi-day holidays
  type           HolidayType  @default(NATIONAL)
  description    String?      @db.VarChar(400)
  createdAt      DateTime     @default(now())

  @@index([schoolId, academicYearId])
  @@index([schoolId, date])
  @@map("holidays")
}

model CalendarEvent {
  id             Int               @id @default(autoincrement())
  schoolId       Int
  school         School            @relation(fields: [schoolId], references: [id])
  academicYearId Int
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  title          String            @db.VarChar(150)
  type           CalendarEventType @default(CUSTOM)
  startDate      DateTime          @db.Date
  endDate        DateTime?         @db.Date
  startTime      String?           @db.VarChar(5)
  endTime        String?           @db.VarChar(5)
  location       String?           @db.VarChar(150)
  colorHex       String?           @db.VarChar(10) // color-coded calendar
  description    String?           @db.VarChar(600)
  isAllDay       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  @@index([schoolId, academicYearId])
  @@index([schoolId, startDate])
  @@map("calendar_events")
}

// ─────────────────────────────────────────
// WORKING DAYS
// ─────────────────────────────────────────

model WorkingDayConfig {
  id              Int             @id @default(autoincrement())
  schoolId        Int
  school          School          @relation(fields: [schoolId], references: [id])
  academicYearId  Int             @unique
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  workingDays     WeekDay[]
  saturdayPattern SaturdayPattern @default(ALL_WORKING)
  sundayOff       Boolean         @default(true)
  updatedAt       DateTime        @updatedAt

  @@index([schoolId])
  @@map("working_day_configs")
}

// ─────────────────────────────────────────
// ACADEMIC POLICIES
// ─────────────────────────────────────────

model AcademicPolicy {
  id                  Int               @id @default(autoincrement())
  schoolId            Int
  school              School            @relation(fields: [schoolId], references: [id])
  academicYearId      Int               @unique
  academicYear        AcademicYear      @relation(fields: [academicYearId], references: [id])
  minAttendancePct    Int               @default(75)
  promotionMinPct     Int               @default(33)
  subjectPassingMarks Int               @default(33)
  graceMarks          Int               @default(0)
  allowGraceMarks     Boolean           @default(true)
  gradingSystem       GradingSystemType @default(PERCENTAGE)
  maxClassStrength    Int?
  updatedAt           DateTime          @updatedAt

  @@index([schoolId])
  @@map("academic_policies")
}

// ─────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────

model Attendance {
  id         Int              @id @default(autoincrement())
  schoolId   Int
  school     School           @relation(fields: [schoolId], references: [id])
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id])
  classId    Int
  class      Class            @relation(fields: [classId], references: [id])
  markedById Int
  markedBy   User             @relation("MarkedBy", fields: [markedById], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  remarks    String?          @db.VarChar(200)
  createdAt  DateTime         @default(now())

  @@unique([schoolId, studentId, classId, date])
  @@index([schoolId, date])
  @@index([schoolId, classId, date])
  @@index([studentId, date])
  @@index([schoolId, date, status])
  @@map("attendance")
}

// ─────────────────────────────────────────
// FEE STRUCTURE
// ─────────────────────────────────────────

model FeeStructure {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  classId        Int?
  class          Class?       @relation(fields: [classId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String       @db.VarChar(100)
  category       FeeCategory  @default(TUITION)
  amount         Decimal      @db.Decimal(10, 2)
  dueDate        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, classId])
  @@map("fee_structures")
}

// ─────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────

model Invoice {
  id             Int           @id @default(autoincrement())
  schoolId       Int
  school         School        @relation(fields: [schoolId], references: [id])
  studentId      Int
  student        Student       @relation(fields: [studentId], references: [id])
  academicYearId Int
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  createdById    Int
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  invoiceNumber  String        @db.VarChar(30)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount      Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(PENDING)
  issuedDate     DateTime      @default(now())
  dueDate        DateTime
  notes          String?       @db.VarChar(500)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       Payment[]
  items          InvoiceItem[]
  refunds        FeeRefund[]
  receipt        FeeReceipt?
  adjustments    TxnAdjustment[]
  reconciliation PaymentReconciliation?

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([schoolId, academicYearId])
  @@index([dueDate, status])
  @@map("invoices")
}

model InvoiceItem {
  id          Int         @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  category    FeeCategory
  description String      @db.VarChar(200)
  amount      Decimal     @db.Decimal(10, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  receivedById  Int
  receivedBy    User          @relation("ReceivedBy", fields: [receivedById], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  receiptNumber String        @db.VarChar(30)
  transactionId String?       @db.VarChar(100)
  paidAt        DateTime      @default(now())
  notes         String?       @db.VarChar(300)

  receipt FeeReceipt?

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

// ─────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────

model Announcement {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  school      School @relation(fields: [schoolId], references: [id])
  createdById Int
  createdBy   User   @relation("AnnouncementCreator", fields: [createdById], references: [id])

  title          String  @db.VarChar(200)
  content        String  @db.Text
  imageUrl       String? @db.VarChar(500)
  attachmentUrl  String? @db.VarChar(500)
  attachmentName String? @db.VarChar(255)

  status        AnnouncementStatus @default(DRAFT)
  targetType    AnnouncementTarget @default(ALL)
  targetClassId Int?
  targetClass   Class?             @relation(fields: [targetClassId], references: [id])
  targetGrade   String?            @db.VarChar(5)

  channels String[]
  isUrgent Boolean  @default(false)
  isPinned Boolean  @default(false)

  scheduledAt DateTime?
  publishedAt DateTime?

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, targetType])
  @@index([scheduledAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation("AnnouncementReads", fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model AnnouncementTemplate {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  name     String @db.VarChar(100)
  title    String @db.VarChar(200)
  content  String @db.Text
  category String @db.VarChar(50)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("announcement_templates")
}

// ─────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────

model PeriodSlot {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id])
  classId      Int
  class        Class    @relation(fields: [classId], references: [id])
  academicYear String   @db.VarChar(10)
  dayOfWeek    Int
  periodNumber Int
  startTime    String   @db.VarChar(5)
  duration     Int
  isBreak      Boolean  @default(false)
  breakLabel   String?  @db.VarChar(30)
  subjectId    Int?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  teacherId    Int?
  teacher      Staff?   @relation("PeriodTeacher", fields: [teacherId], references: [id])
  room         String?  @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  substitutions SubstituteAssignment[]

  @@unique([classId, dayOfWeek, periodNumber, academicYear])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@map("period_slots")
}

// A one-off cover for a single date — the original PeriodSlot stays
// unchanged (it's the recurring weekly schedule), this just says "on
// this specific date, this teacher covers instead."
model SubstituteAssignment {
  id                Int        @id @default(autoincrement())
  schoolId          Int
  school            School     @relation(fields: [schoolId], references: [id])
  periodSlotId      Int
  periodSlot        PeriodSlot @relation(fields: [periodSlotId], references: [id], onDelete: Cascade)
  date              DateTime   @db.Date
  originalTeacherId Int
  originalTeacher   Staff      @relation("OriginalTeacherSub", fields: [originalTeacherId], references: [id])
  substituteId      Int
  substitute        Staff      @relation("SubstituteTeacherSub", fields: [substituteId], references: [id])
  reason            String?    @db.VarChar(200)
  createdById       Int
  createdBy         User       @relation("SubstituteCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime   @default(now())

  @@unique([periodSlotId, date])
  @@index([schoolId])
  @@index([date])
  @@index([substituteId])
  @@map("substitute_assignments")
}

model MasterPeriod {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  sessionName  String     @db.VarChar(20)
  name         String     @db.VarChar(50)
  serialNumber Int        @default(1)
  startTime    String     @db.VarChar(5)
  endTime      String     @db.VarChar(5)
  duration     Int
  periodType   PeriodType @default(REGULAR)
  dayOfWeek    Int        @default(0)
  isActive     Boolean    @default(true)
  color        String     @default("#6366f1") @db.VarChar(20)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([schoolId, sessionName, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([schoolId, sessionName])
  @@map("master_periods")
}

// ── Model ───────────────────────────────────────────────────
model PromotionHistory {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  fromClassId Int
  fromClass   Class  @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClassId   Int?
  toClass     Class? @relation("PromotionToClass", fields: [toClassId], references: [id])

  fromSession String @db.VarChar(20)
  toSession   String @db.VarChar(20)

  status PromotionStatus @default(PROMOTED)

  oldRollNumber String? @db.VarChar(20)
  newRollNumber String? @db.VarChar(20)

  promotedById Int
  promotedBy   User @relation("PromotedBy", fields: [promotedById], references: [id])

  remarks        String?   @db.VarChar(300)
  isRolledBack   Boolean   @default(false)
  rolledBackAt   DateTime?
  rolledBackById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([fromSession, toSession])
  @@index([schoolId, toSession])
  @@map("promotion_history")
}

model AdmissionDocument {
  id           Int            @id @default(autoincrement())
  schoolId     Int
  school       School         @relation(fields: [schoolId], references: [id])
  studentId    Int
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentName String         @db.VarChar(100)
  fileUrl      String?        @db.VarChar(500)
  fileName     String?        @db.VarChar(200)
  fileType     String?        @db.VarChar(20)
  status       DocumentStatus @default(PENDING)
  verifiedById Int?
  remarks      String?        @db.VarChar(200)
  uploadedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([schoolId, studentId])
  @@map("admission_documents")
}

model ParentDetail {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  studentId Int     @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Father
  fatherName          String?  @db.VarChar(100)
  fatherPhone         String?  @db.VarChar(15)
  fatherOccupation    String?  @db.VarChar(100)
  fatherQualification String?  @db.VarChar(100)
  fatherAadhaar       String?  @db.VarChar(12)
  fatherIncome        Decimal? @db.Decimal(10, 2)
  fatherPhotoUrl      String?  @db.VarChar(500)

  // Mother
  motherName          String? @db.VarChar(100)
  motherPhone         String? @db.VarChar(15)
  motherOccupation    String? @db.VarChar(100)
  motherQualification String? @db.VarChar(100)
  motherAadhaar       String? @db.VarChar(12)
  motherPhotoUrl      String? @db.VarChar(500)

  // Guardian
  guardianName       String? @db.VarChar(100)
  guardianRelation   String? @db.VarChar(50)
  guardianPhone      String? @db.VarChar(15)
  guardianOccupation String? @db.VarChar(100)
  primaryGuardian    String  @default("Father") @db.VarChar(20)

  // Emergency
  emergencyContact  String? @db.VarChar(100)
  emergencyPhone    String? @db.VarChar(15)
  emergencyRelation String? @db.VarChar(50)

  // Address
  currentAddress   String? @db.VarChar(500)
  permanentAddress String? @db.VarChar(500)
  sameAddress      Boolean @default(false)

  // Communication
  whatsappNumber String? @db.VarChar(15)
  commPreference String  @default("SMS") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("parent_details")
}

model BehaviourRecord {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  reportedById Int
  reportedBy   User @relation("BehaviourReporter", fields: [reportedById], references: [id])

  title         String            @db.VarChar(200)
  behaviourType BehaviourType     @default(NEGATIVE)
  category      String            @db.VarChar(100) // e.g. "Fighting", "Leadership"
  severity      BehaviourSeverity @default(LOW)
  description   String            @db.Text
  actionTaken   ActionTaken       @default(NONE)
  actionNotes   String?           @db.VarChar(500)
  status        BehaviourStatus   @default(OPEN)

  // Points system
  points Int @default(0) // positive = +, negative = -

  // Date
  behaviourDate DateTime @default(now())

  // Follow-up
  followUpDate  DateTime?
  followUpNotes String?   @db.VarChar(500)

  // Visibility
  visibleToParent  Boolean @default(true)
  visibleToStudent Boolean @default(false)
  isAnonymous      Boolean @default(false)

  // Tags
  tags String[]

  // Attachments
  attachments BehaviourAttachment[]

  // Notifications
  parentNotified Boolean   @default(false)
  notifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, behaviourType])
  @@index([schoolId, status])
  @@index([behaviourDate])
  @@map("behaviour_records")
}

model BehaviourAttachment {
  id         Int             @id @default(autoincrement())
  recordId   Int
  record     BehaviourRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String          @db.VarChar(200)
  fileUrl    String          @db.VarChar(500)
  fileType   String          @db.VarChar(20)
  uploadedAt DateTime        @default(now())

  @@index([recordId])
  @@map("behaviour_attachments")
}

model StudentArchive {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  status         StudentArchiveStatus
  reason         String               @db.VarChar(500)
  reasonCategory String?              @db.VarChar(100) // e.g. "Financial Issue", "Transfer"

  // Suspension specific
  suspensionFrom DateTime?
  suspensionTo   DateTime?
  autoReactivate Boolean   @default(false)

  // Fee dues at time of archiving
  pendingFees Decimal @default(0) @db.Decimal(10, 2)
  feesCleared Boolean @default(false)

  // TC info
  tcNumber     String?   @db.VarChar(50)
  tcIssuedDate DateTime?
  tcFileUrl    String?   @db.VarChar(500)

  // Audit
  disabledById Int
  disabledBy   User     @relation("ArchivedBy", fields: [disabledById], references: [id])
  disabledAt   DateTime @default(now())

  // Restore
  isRestored    Boolean   @default(false)
  restoredById  Int?
  restoredBy    User?     @relation("RestoredBy", fields: [restoredById], references: [id])
  restoredAt    DateTime?
  restoreReason String?   @db.VarChar(300)

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@index([disabledAt])
  @@map("student_archives")
}

model ExamConfig {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // Step 1 - Basic Info
  name              String       @db.VarChar(200)
  examCode          String       @db.VarChar(30)
  sessionName       String       @db.VarChar(20)
  category          ExamCategory @default(UNIT_TEST)
  description       String?      @db.Text
  startDate         DateTime?
  endDate           DateTime?
  resultPublishDate DateTime?
  status            ExamStatus   @default(DRAFT)

  // Step 4 - Grading
  gradingType     GradingType @default(MARKS)
  passingMarks    Decimal     @default(33) @db.Decimal(5, 2)
  passingType     String      @default("OVERALL") @db.VarChar(20) // OVERALL | SUBJECT_WISE
  maxCompartments Int         @default(2)
  rankBy          String      @default("CLASS") @db.VarChar(20) // CLASS | SECTION
  minAttendance   Int         @default(0)

  // Step 5 - Result Settings
  includePractical    Boolean   @default(true)
  includeCoCurricular Boolean   @default(false)
  includeAttendance   Boolean   @default(false)
  includeBehaviour    Boolean   @default(false)
  reportTemplate      String    @default("DEFAULT") @db.VarChar(50)
  autoPublish         Boolean   @default(false)
  parentVisible       Boolean   @default(false)
  scheduledPublishAt  DateTime?

  // Meta
  createdById  Int
  createdBy    User    @relation("ExamConfigCreator", fields: [createdById], references: [id])
  isLocked     Boolean @default(false)
  clonedFromId Int?

  // Relations
  classes                ExamClass[]
  gradeScale             GradeScale[]
  schedules              ExamSchedule[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  marksEntries           MarksEntry[]
  coCurricularSessions   CoCurricularSession[]
  resultReviews          StudentResultReview[]
  generatedReportCards   GeneratedReportCard[]
  studentResults         StudentResult[]
  documents              ExamDocument[]
  examAttendanceSessions ExamAttendanceSession[]

  @@unique([schoolId, examCode])
  @@index([schoolId])
  @@index([schoolId, sessionName])
  @@index([schoolId, status])
  @@map("exam_configs")
}

model ExamClass {
  id           Int        @id @default(autoincrement())
  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id], onDelete: Cascade)
  schoolId     Int
  classId      Int
  class        Class      @relation(fields: [classId], references: [id])

  // Subject configs for this class
  subjects ExamSubject[]

  @@unique([examConfigId, classId])
  @@index([examConfigId])
  @@index([classId])
  @@map("exam_classes")
}

model ExamSubject {
  id          Int       @id @default(autoincrement())
  examClassId Int
  examClass   ExamClass @relation(fields: [examClassId], references: [id], onDelete: Cascade)
  schoolId    Int
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])

  subjectType     SubjectType @default(THEORY)
  maxMarks        Decimal     @default(100) @db.Decimal(6, 2)
  minMarks        Decimal     @default(33) @db.Decimal(6, 2)
  includeInResult Boolean     @default(true)
  isOptional      Boolean     @default(false)

  // Components (theory/practical/internal)
  components             ExamComponent[]
  marksEntries           MarksEntry[]
  examAttendanceSessions ExamAttendanceSession[]

  @@unique([examClassId, subjectId])
  @@index([examClassId])
  @@map("exam_subjects")
}

model ExamComponent {
  id            Int         @id @default(autoincrement())
  examSubjectId Int
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  name          String      @db.VarChar(50) // "Theory", "Practical", "Internal"
  maxMarks      Decimal     @db.Decimal(6, 2)
  minMarks      Decimal     @default(0) @db.Decimal(6, 2)
  weightage     Decimal     @default(100) @db.Decimal(5, 2) // percentage
  isOptional    Boolean     @default(false)
  serialNumber  Int         @default(1)

  componentMarks ComponentMark[]

  @@index([examSubjectId])
  @@map("exam_components")
}

model GradeScale {
  id           Int        @id @default(autoincrement())
  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id], onDelete: Cascade)
  schoolId     Int

  minPercent  Decimal  @db.Decimal(5, 2)
  maxPercent  Decimal  @db.Decimal(5, 2)
  grade       String   @db.VarChar(5)
  gradePoint  Decimal? @db.Decimal(4, 2)
  description String?  @db.VarChar(50)
  color       String   @default("#6366f1") @db.VarChar(20)

  @@index([examConfigId])
  @@map("grade_scales")
}

model ExamSchedule {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id])

  title       String         @db.VarChar(200)
  sessionName String         @db.VarChar(20)
  status      ScheduleStatus @default(DRAFT)

  startDate DateTime?
  endDate   DateTime?

  defaultStartTime String? @db.VarChar(5) // "10:00"
  defaultEndTime   String? @db.VarChar(5) // "13:00"
  minGapDays       Int     @default(1)

  parentVisible  Boolean @default(false)
  teacherVisible Boolean @default(false)
  studentVisible Boolean @default(false)

  publishedAt        DateTime?
  scheduledPublishAt DateTime?

  createdById Int
  createdBy   User @relation("ScheduleCreator", fields: [createdById], references: [id])

  slots ExamSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, sessionName])
  @@index([examConfigId])
  @@map("exam_schedules")
}

model ExamSlot {
  id         Int          @id @default(autoincrement())
  scheduleId Int
  schedule   ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  schoolId   Int

  examDate  DateTime @db.Date
  dayOfWeek Int // 1=Mon...7=Sun
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])

  slotType  ExamSlotType @default(THEORY)
  startTime String       @db.VarChar(5) // "10:00"
  endTime   String       @db.VarChar(5) // "13:00"
  duration  Int // minutes

  roomNumber   String? @db.VarChar(50)
  roomCapacity Int?

  invigilatorId Int?
  invigilator   Staff? @relation("SlotInvigilator", fields: [invigilatorId], references: [id])

  backupInvigilatorId Int?
  backupInvigilator   Staff? @relation("SlotBackupInvigilator", fields: [backupInvigilatorId], references: [id])

  instructions String? @db.VarChar(500)
  isPublished  Boolean @default(false)
  hasConflict  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([schoolId, examDate])
  @@index([subjectId])
  @@index([classId])
  @@map("exam_slots")
}

model MarksEntry {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id])

  examSubjectId Int
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id])

  // Marks
  obtainedMarks   Decimal? @db.Decimal(6, 2)
  maxMarks        Decimal  @db.Decimal(6, 2)
  graceMarks      Decimal  @default(0) @db.Decimal(4, 2)
  moderationMarks Decimal  @default(0) @db.Decimal(4, 2)
  finalMarks      Decimal? @db.Decimal(6, 2) // obtained + grace + moderation

  // Per component marks
  componentMarks ComponentMark[]

  // Result
  grade      String?  @db.VarChar(5)
  gradePoint Decimal? @db.Decimal(4, 2)
  isPassed   Boolean?
  rank       Int?

  // Status
  marksStatus MarksStatus      @default(PRESENT)
  entryStatus MarksEntryStatus @default(DRAFT)

  remarks  String? @db.VarChar(300)
  isLocked Boolean @default(false)

  // Entered by
  enteredById Int
  enteredBy   User     @relation("MarksEnteredBy", fields: [enteredById], references: [id])
  enteredAt   DateTime @default(now())

  // Last edited
  lastEditedById Int?
  lastEditedBy   User?     @relation("MarksLastEditedBy", fields: [lastEditedById], references: [id])
  lastEditedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([schoolId])
  @@index([examConfigId])
  @@index([examSubjectId])
  @@index([studentId])
  @@index([classId])
  @@map("marks_entries")
}

model ComponentMark {
  id            Int           @id @default(autoincrement())
  marksEntryId  Int
  marksEntry    MarksEntry    @relation(fields: [marksEntryId], references: [id], onDelete: Cascade)
  componentId   Int
  component     ExamComponent @relation(fields: [componentId], references: [id])
  obtainedMarks Decimal?      @db.Decimal(6, 2)
  maxMarks      Decimal       @db.Decimal(6, 2)
  School        School?       @relation(fields: [schoolId], references: [id])
  schoolId      Int?

  @@unique([marksEntryId, componentId])
  @@index([marksEntryId])
  @@map("component_marks")
}

// ── Assessment Category (school-level config) ──────────────
model CoCurricularCategory {
  id              Int                   @id @default(autoincrement())
  schoolId        Int
  school          School                @relation(fields: [schoolId], references: [id])
  name            String                @db.VarChar(100) // "Discipline", "Leadership"
  groupName       String                @db.VarChar(50) // "Behaviour", "Co-Curricular", "Life Skills"
  gradeType       CoCurricularGradeType @default(DESCRIPTIVE)
  includeInReport Boolean               @default(true)
  weightage       Decimal               @default(0) @db.Decimal(4, 2)
  maxPoints       Int?
  isActive        Boolean               @default(true)
  serialNumber    Int                   @default(1)
  color           String                @default("#6366f1") @db.VarChar(20)
  icon            String?               @db.VarChar(50)

  assessments CoCurricularAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, groupName])
  @@map("co_curricular_categories")
}

// ── One per exam+class combination ──────────────────────────
model CoCurricularSession {
  id           Int              @id @default(autoincrement())
  schoolId     Int
  school       School           @relation(fields: [schoolId], references: [id])
  examConfigId Int?
  examConfig   ExamConfig?      @relation(fields: [examConfigId], references: [id])
  classId      Int
  class        Class            @relation(fields: [classId], references: [id])
  sessionName  String           @db.VarChar(20)
  status       AssessmentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdById  Int
  createdBy    User             @relation("CoCurricularCreator", fields: [createdById], references: [id])

  assessments CoCurricularAssessment[]

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  StudentDetailedAssessment StudentDetailedAssessment[]

  @@unique([schoolId, examConfigId, classId])
  @@index([schoolId])
  @@map("co_curricular_sessions")
}

// ── Per-student per-category grade ──────────────────────────
model CoCurricularAssessment {
  id         Int                  @id @default(autoincrement())
  schoolId   Int
  sessionId  Int
  session    CoCurricularSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  categoryId Int
  category   CoCurricularCategory @relation(fields: [categoryId], references: [id])
  studentId  Int
  student    Student              @relation(fields: [studentId], references: [id])

  grade    String? @db.VarChar(20) // "A", "Excellent", "4" (stars), "85" (points)
  points   Int?
  remarks  String? @db.VarChar(300)
  isLocked Boolean @default(false)

  enteredById Int
  enteredBy   User @relation("CoCurricularEnterer", fields: [enteredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, categoryId, studentId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([studentId])
  @@map("co_curricular_assessments")
}

// ── Detailed student assessment (drawer fields) ──────────────
model StudentDetailedAssessment {
  id        Int                 @id @default(autoincrement())
  schoolId  Int
  sessionId Int
  session   CoCurricularSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId Int                 @unique
  student   Student             @relation(fields: [studentId], references: [id])

  strengths            String?  @db.VarChar(500)
  areasOfImprovement   String?  @db.VarChar(500)
  teacherRemarks       String?  @db.VarChar(500)
  parentRecommendation String?  @db.VarChar(300)
  counsellingNotes     String?  @db.VarChar(500)
  achievementTags      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, sessionId])
  @@map("student_detailed_assessments")
}

// ── One per student per exam ─────────────────────────────────
model StudentResultReview {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id])
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  classId      Int
  class        Class      @relation(fields: [classId], references: [id])

  // Remarks
  classTeacherRemarks String? @db.VarChar(1000)
  principalRemarks    String? @db.VarChar(500)
  behaviourRemarks    String? @db.VarChar(500)
  internalNotes       String? @db.VarChar(500)

  // Promotion
  promotionRecommendation PromotionRecommendation @default(PROMOTE)

  // Result hold
  isResultHeld Boolean @default(false)
  holdReason   String? @db.VarChar(200)

  // Approval workflow
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?
  rejectionReason String?        @db.VarChar(300)

  // Who did what
  classTeacherId Int?
  classTeacher   User? @relation("ClassTeacherReviewer", fields: [classTeacherId], references: [id])
  approvedById   Int?
  approvedBy     User? @relation("ResultApprover", fields: [approvedById], references: [id])
  publishedById  Int?
  publishedBy    User? @relation("ResultPublisher", fields: [publishedById], references: [id])

  // Flags
  parentMeetingRecommended Boolean @default(false)
  isLocked                 Boolean @default(false)

  // Subject-wise teacher remarks
  subjectRemarks SubjectRemark[]
  // Audit
  auditLogs      ResultAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examConfigId, studentId])
  @@index([schoolId])
  @@index([examConfigId, classId])
  @@index([approvalStatus])
  @@map("student_result_reviews")
}

model SubjectRemark {
  id        Int                 @id @default(autoincrement())
  reviewId  Int
  review    StudentResultReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject             @relation(fields: [subjectId], references: [id])
  teacherId Int?
  teacher   User?               @relation("SubjectRemarkTeacher", fields: [teacherId], references: [id])
  remark    String              @db.VarChar(500)
  createdAt DateTime            @default(now())

  @@unique([reviewId, subjectId])
  @@index([reviewId])
  @@map("subject_remarks")
}

model ResultAuditLog {
  id            Int                 @id @default(autoincrement())
  reviewId      Int
  review        StudentResultReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  schoolId      Int
  action        String              @db.VarChar(50) // "APPROVED", "REJECTED", "REMARK_ADDED"
  description   String              @db.VarChar(300)
  performedById Int
  performedBy   User                @relation("AuditLogPerformer", fields: [performedById], references: [id])
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([reviewId])
  @@index([schoolId])
  @@map("result_audit_logs")
}

model ReportCardTemplate {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  name        String              @db.VarChar(200)
  description String?             @db.VarChar(500)
  boardType   TemplateBoardType   @default(CUSTOM)
  orientation TemplateOrientation @default(PORTRAIT)
  language    String              @default("English") @db.VarChar(30) // English | Hindi | Bilingual
  status      TemplateStatus      @default(DRAFT)

  // Version tracking
  version      Int     @default(1)
  clonedFromId Int?
  isDefault    Boolean @default(false)

  // The actual layout — stored as JSON (components array)
  layoutJson Json // Full layout definition

  // Settings
  primaryColor   String  @default("#1e3a8a") @db.VarChar(20)
  secondaryColor String  @default("#f59e0b") @db.VarChar(20)
  fontFamily     String  @default("Inter") @db.VarChar(50)
  paperSize      String  @default("A4") @db.VarChar(10)
  showWatermark  Boolean @default(false)
  watermarkText  String? @db.VarChar(50)
  enableQr       Boolean @default(true)
  headerHtml     String? @db.Text // Custom header HTML
  footerHtml     String? @db.Text

  // Applicable classes
  applicableClasses Int[] // Array of class IDs

  createdById Int
  createdBy   User @relation("TemplateCreator", fields: [createdById], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  generatedCards GeneratedReportCard[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("report_card_templates")
}

model GeneratedReportCard {
  id           Int                @id @default(autoincrement())
  schoolId     Int
  templateId   Int
  template     ReportCardTemplate @relation(fields: [templateId], references: [id])
  studentId    Int
  student      Student            @relation(fields: [studentId], references: [id])
  examConfigId Int
  examConfig   ExamConfig         @relation(fields: [examConfigId], references: [id])

  pdfUrl      String?   @db.VarChar(500)
  htmlContent String?   @db.Text
  qrCode      String?   @db.VarChar(500)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  generatedAt DateTime  @default(now())
  School      School    @relation(fields: [schoolId], references: [id])

  @@unique([templateId, studentId, examConfigId])
  @@index([schoolId])
  @@index([studentId])
  @@map("generated_report_cards")
}

model StudentResult {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  examConfigId Int
  examConfig   ExamConfig @relation(fields: [examConfigId], references: [id])
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  classId      Int
  class        Class      @relation(fields: [classId], references: [id])

  // Marks summary
  totalObtained  Decimal  @default(0) @db.Decimal(8, 2)
  totalMax       Decimal  @default(0) @db.Decimal(8, 2)
  percentage     Decimal  @default(0) @db.Decimal(5, 2)
  grade          String?  @db.VarChar(5)
  gradePoint     Decimal? @db.Decimal(4, 2)
  isPassed       Boolean  @default(false)
  failedSubjects Int      @default(0)
  isCompartment  Boolean  @default(false)

  // Rank
  classRank   Int?
  sectionRank Int?
  overallRank Int?

  // Attendance
  attendancePct Decimal? @db.Decimal(5, 2)
  presentDays   Int?
  workingDays   Int?

  // Status
  status     ResultStatus @default(DRAFT)
  isHeld     Boolean      @default(false)
  holdReason String?      @db.VarChar(200)
  isLocked   Boolean      @default(false)

  // Grace/Moderation
  graceMarksApplied Boolean @default(false)

  // Audit
  generatedById Int?
  generatedBy   User?     @relation("ResultGenerator", fields: [generatedById], references: [id])
  generatedAt   DateTime?
  publishedById Int?
  publishedBy   User?     @relation("ResultPublisher2", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  // Subject breakdown stored as JSON
  subjectResults Json // [{subjectId, subjectName, obtained, max, grade, isPassed, status}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examConfigId, studentId])
  @@index([schoolId])
  @@index([examConfigId, classId])
  @@index([status])
  @@index([classRank])
  @@map("student_results")
}

model ExamDocument {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // Metadata
  title       String      @db.VarChar(300)
  description String?     @db.VarChar(500)
  category    DocCategory @default(OTHER)
  tags        String[]

  // File
  fileName String @db.VarChar(300)
  fileUrl  String @db.VarChar(1000)
  fileType String @db.VarChar(20) // pdf, docx, jpg, xlsx
  fileSize Int    @default(0) // bytes

  // Linkage
  examConfigId Int?
  examConfig   ExamConfig? @relation(fields: [examConfigId], references: [id])
  classId      Int?
  class        Class?      @relation(fields: [classId], references: [id])
  subjectId    Int?
  subject      Subject?    @relation(fields: [subjectId], references: [id])

  // Status & Access
  status         DocStatus @default(DRAFT)
  accessLevel    DocAccess @default(TEACHERS_ONLY)
  isConfidential Boolean   @default(false)

  // Scheduled visibility
  visibleFrom  DateTime?
  visibleUntil DateTime?

  // Features
  hasWatermark  Boolean   @default(false)
  watermarkText String?   @db.VarChar(100)
  allowDownload Boolean   @default(true)
  expiresAt     DateTime?

  // Version
  version     Int  @default(1)
  parentDocId Int? // for versioned docs

  // Stats
  downloadCount Int @default(0)
  viewCount     Int @default(0)

  // Who
  uploadedById Int
  uploadedBy   User      @relation("DocUploader", fields: [uploadedById], references: [id])
  approvedById Int?
  approvedBy   User?     @relation("DocApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Logs
  auditLogs DocAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, category])
  @@index([schoolId, examConfigId])
  @@index([status])
  @@map("exam_documents")
}

model DocAuditLog {
  id         Int          @id @default(autoincrement())
  documentId Int
  document   ExamDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  schoolId   Int
  action     String       @db.VarChar(30) // UPLOADED, VIEWED, DOWNLOADED, APPROVED, REJECTED
  userId     Int
  user       User         @relation("DocAuditUser", fields: [userId], references: [id])
  ipAddress  String?      @db.VarChar(45)
  createdAt  DateTime     @default(now())

  @@index([documentId])
  @@index([schoolId])
  @@map("doc_audit_logs")
}

// ── One session per exam+class+subject+date ─────────────────
model ExamAttendanceSession {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  school        School       @relation(fields: [schoolId], references: [id])
  examConfigId  Int
  examConfig    ExamConfig   @relation(fields: [examConfigId], references: [id])
  classId       Int
  class         Class        @relation(fields: [classId], references: [id])
  examSubjectId Int?
  examSubject   ExamSubject? @relation(fields: [examSubjectId], references: [id])
  examDate      DateTime     @db.Date
  hallName      String?      @db.VarChar(50)
  invigilatorId Int?
  invigilator   User?        @relation("ExamInvigilator", fields: [invigilatorId], references: [id])

  lockStatus    ExamAttendanceLockStatus @default(DRAFT)
  submittedAt   DateTime?
  lockedAt      DateTime?
  submittedById Int?
  submittedBy   User?                    @relation("ExamAttSubmitter", fields: [submittedById], references: [id])

  records ExamAttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examConfigId, classId, examSubjectId, examDate])
  @@index([schoolId])
  @@index([examConfigId])
  @@map("exam_attendance_sessions")
}

// ── Per-student record ───────────────────────────────────────
model ExamAttendanceRecord {
  id        Int                   @id @default(autoincrement())
  sessionId Int
  session   ExamAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schoolId  Int
  studentId Int
  student   Student               @relation(fields: [studentId], references: [id])

  status         ExamAttendanceStatus @default(ABSENT)
  isHallVerified Boolean              @default(false)
  lateByMinutes  Int?
  remarks        String?              @db.VarChar(300)

  // UFM
  isUFM           Boolean  @default(false)
  ufmType         UFMType?
  ufmDescription  String?  @db.VarChar(500)
  ufmEvidenceUrl  String?  @db.VarChar(500)
  ufmActionTaken  String?  @db.VarChar(200)
  ufmReportedById Int?
  ufmReportedBy   User?    @relation("UFMReporter", fields: [ufmReportedById], references: [id])

  markedById Int?
  markedBy   User?     @relation("ExamAttMarker", fields: [markedById], references: [id])
  markedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([studentId])
  @@map("exam_attendance_records")
}

model OnlineExam {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // Step 1 — Basic Info
  name               String             @db.VarChar(300)
  examCode           String             @db.VarChar(30)
  description        String?            @db.VarChar(1000)
  instructions       String?            @db.Text
  academicSession    String?            @db.VarChar(30)
  subjectId          Int?
  subject            Subject?           @relation(fields: [subjectId], references: [id])
  chapterTopic       String?            @db.VarChar(200)
  applicableClasses  Int[]
  applicableSections String[]
  category           OnlineExamCategory @default(UNIT_TEST)
  tags               String[]

  // Step 2 — Exam Pattern
  examType         OnlineExamType @default(MCQ)
  totalQuestions   Int            @default(0)
  totalMarks       Decimal        @default(0) @db.Decimal(8, 2)
  duration         Int            @default(60) // minutes
  passingMarks     Decimal?       @db.Decimal(8, 2)
  passingPercent   Decimal?       @db.Decimal(5, 2)
  hasNegMarking    Boolean        @default(false)
  negMarkValue     Decimal?       @db.Decimal(4, 2) // e.g. -1
  posMarkValue     Decimal?       @db.Decimal(4, 2) // e.g. 4
  hasPartialMarks  Boolean        @default(false)
  randomizeQns     Boolean        @default(false)
  randomizeOpts    Boolean        @default(false)
  showCalculator   Boolean        @default(false)
  showFormulaSheet Boolean        @default(false)

  // Step 3 — Questions (stored as JSON array of questionIds with marks)
  questionConfig Json? // [{questionId, marks, order, sectionName}]

  // Step 4 — Rules
  attemptsAllowed  Int              @default(1) // 0 = unlimited
  strictTimer      Boolean          @default(true)
  allowResume      Boolean          @default(false)
  allowPause       Boolean          @default(false)
  navigationMode   NavigationMode   @default(FREE)
  markForReview    Boolean          @default(true)
  questionView     QuestionViewMode @default(ONE_BY_ONE)
  resultVisibility ResultVisibility @default(AFTER_SUBMISSION)

  // Step 5 — Security
  fullScreenMode    Boolean @default(false)
  tabSwitchDetect   Boolean @default(false)
  refreshDetect     Boolean @default(false)
  preventMultiLogin Boolean @default(false)
  singleDeviceOnly  Boolean @default(false)
  rightClickDisable Boolean @default(false)
  copyPasteRestrict Boolean @default(false)
  maxTabSwitches    Int     @default(3)

  // Scheduling
  status         OnlineExamStatus @default(DRAFT)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  publishedAt    DateTime?
  completedAt    DateTime?

  // Version
  version  Int  @default(1)
  parentId Int? // cloned from

  // Ownership
  createdById Int
  createdBy   User @relation("OnlineExamCreator", fields: [createdById], references: [id])

  // Stats (cached)
  totalAttempts Int      @default(0)
  avgScore      Decimal? @db.Decimal(5, 2)

  // Relations
  attempts          OnlineExamAttempt[]
  schedules         TestSchedule[]
  evaluationRecords EvaluationRecord[]
  securityPolicy    ExamSecurityPolicy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, subjectId])
  @@index([createdById])
  @@map("online_exams")
}

// ── Attempt tracking ─────────────────────────────────────────
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

model OnlineExamAttempt {
  id        Int        @id @default(autoincrement())
  schoolId  Int
  examId    Int
  exam      OnlineExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student    @relation(fields: [studentId], references: [id])

  attemptNumber Int           @default(1)
  status        AttemptStatus @default(IN_PROGRESS)

  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  timeTakenSecs Int?

  // Score
  totalMarks    Decimal? @db.Decimal(8, 2)
  obtainedMarks Decimal? @db.Decimal(8, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  isPassed      Boolean?

  // Tab switch / security violations
  tabSwitchCount Int   @default(0)
  securityFlags  Json?

  // Responses (JSON)
  responses Json? // [{questionId, selectedOption, marksAwarded, isCorrect}]

  resultVisible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId, attemptNumber])
  @@index([schoolId])
  @@index([examId])
  @@index([studentId])
  @@map("online_exam_attempts")
}

// ── Question Category Hierarchy ─────────────────────────────
model QBChapter {
  id           Int            @id @default(autoincrement())
  schoolId     Int
  school       School         @relation(fields: [schoolId], references: [id])
  classNumber  String         @db.VarChar(10)
  subjectName  String         @db.VarChar(100)
  name         String         @db.VarChar(200)
  serialNumber Int            @default(1)
  isActive     Boolean        @default(true)
  topics       QBTopic[]
  questions    QuestionBank[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([schoolId, classNumber, subjectName])
  @@map("qb_chapters")
}

model QBTopic {
  id           Int            @id @default(autoincrement())
  schoolId     Int
  school       School         @relation(fields: [schoolId], references: [id])
  chapterId    Int
  chapter      QBChapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name         String         @db.VarChar(200)
  serialNumber Int            @default(1)
  isActive     Boolean        @default(true)
  questions    QuestionBank[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([chapterId])
  @@map("qb_topics")
}

// ── Main Question Model ──────────────────────────────────────
model QuestionBank {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // Step 1 — Classification (grade-level, NOT tied to one class-section's
  // Subject row — this is what lets "Class 5-A" and "Class 5-B" share the
  // same question bank for "Mathematics" instead of duplicating it).
  classNumber     String     @db.VarChar(10) // "5", "10", "11", "12"
  subjectName     String     @db.VarChar(100)
  chapterId       Int?
  chapter         QBChapter? @relation(fields: [chapterId], references: [id])
  topicId         Int?
  topic           QBTopic?   @relation(fields: [topicId], references: [id])
  learningOutcome String?    @db.VarChar(300)
  tags            String[]
  boardType       String?    @db.VarChar(20) // CBSE, RBSE, ICSE

  // Step 2 — Type
  questionType QuestionType @default(SINGLE_MCQ)

  // Step 3 — Content (stored as rich text / markdown)
  questionText     String  @db.Text
  questionImageUrl String? @db.VarChar(500)
  questionHtml     String? @db.Text

  // MCQ Options (JSON array)
  options         Json? // [{key:"A",text:"...",imageUrl:"...",isCorrect:bool}]
  correctAnswer   String? @db.VarChar(500) // for non-MCQ: text answer
  explanation     String? @db.Text
  explanationHtml String? @db.Text

  // Match Following (JSON)
  matchPairs Json? // [{left:"...",right:"..."}]

  // True/False
  trueFalseAnswer Boolean?

  // Numerical
  numericalAnswer Decimal? @db.Decimal(12, 4)
  numericalRange  Decimal? @db.Decimal(8, 4) // ± tolerance

  // Step 4 — Marks & Difficulty
  marks            Decimal         @default(1) @db.Decimal(6, 2)
  negativeMarks    Decimal?        @db.Decimal(6, 2)
  difficulty       DifficultyLevel @default(MEDIUM)
  estimatedTimeSec Int? // seconds to solve
  cognitiveLevel   CognitiveLevel? @default(REMEMBER)

  // Step 5 — Review
  status        QuestionStatus @default(DRAFT)
  reviewerId    Int?
  reviewer      User?          @relation("QBReviewer", fields: [reviewerId], references: [id])
  reviewComment String?        @db.VarChar(500)
  reviewedAt    DateTime?

  // Ownership
  createdById Int
  createdBy   User   @relation("QBCreator", fields: [createdById], references: [id])
  source      String @default("TEACHER") @db.VarChar(20) // TEACHER, IMPORTED, AI_GENERATED
  version     Int    @default(1)
  parentId    Int? // for versioned/duplicated questions

  // Analytics (cached)
  usageCount   Int  @default(0)
  correctCount Int  @default(0)
  attemptCount Int  @default(0)
  skipCount    Int  @default(0)
  avgTimeSec   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, classNumber, subjectName])
  @@index([schoolId, status])
  @@index([schoolId, difficulty])
  @@index([schoolId, questionType])
  @@map("question_bank")
}

model TestSchedule {
  id       Int        @id @default(autoincrement())
  schoolId Int
  school   School     @relation(fields: [schoolId], references: [id])
  examId   Int
  exam     OnlineExam @relation(fields: [examId], references: [id])

  // Step 1 — Target
  applicableClasses  Int[]
  applicableSections String[]
  specificStudents   Int[] // student IDs if accessType = SELECTED_STUDENTS
  accessType         ScheduleAccessType @default(ALL_ELIGIBLE)

  // Step 2 — Timing
  startTime        DateTime
  endTime          DateTime
  durationMins     Int // exam duration in minutes
  isFlexibleWindow Boolean  @default(false) // student can start anytime in window
  isFixedStart     Boolean  @default(false) // all start exactly at startTime
  bufferMins       Int      @default(0) // extra time buffer

  // Recurring
  recurringType    RecurringType @default(NONE)
  recurringEndDate DateTime?

  // Step 3 — Access Rules
  maxAttempts       Int               @default(1) // 0 = unlimited
  allowReattempt    Boolean           @default(false)
  allowResume       Boolean           @default(false)
  allowPause        Boolean           @default(false)
  deviceRestriction DeviceRestriction @default(ANY)

  // Step 4 — Result & Notifications
  resultVisibility ResultRelease @default(AFTER_SUBMISSION)
  showAnswers      AnswerRelease @default(AFTER_EXAM_ENDS)
  showExplanations Boolean       @default(true)
  showRank         Boolean       @default(true)
  showLeaderboard  Boolean       @default(false)
  notifyStudents   Boolean       @default(true)
  notifyParents    Boolean       @default(false)
  notifyTeachers   Boolean       @default(true)
  reminder1Day     Boolean       @default(true)
  reminder1Hour    Boolean       @default(true)
  reminder15Min    Boolean       @default(false)

  // Step 5 — Security (override exam defaults)
  fullScreenMode    Boolean @default(false)
  tabSwitchDetect   Boolean @default(false)
  maxTabSwitches    Int     @default(3)
  refreshDetect     Boolean @default(false)
  preventMultiLogin Boolean @default(false)
  singleDeviceOnly  Boolean @default(false)
  rightClickDisable Boolean @default(false)
  copyPasteRestrict Boolean @default(false)

  // Status
  status         ScheduleStatus @default(DRAFT)
  publishedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?        @db.VarChar(200)
  isExtended     Boolean        @default(false)
  extendedByMins Int            @default(0)

  // Stats cache
  totalEligible  Int @default(0)
  totalStarted   Int @default(0)
  totalSubmitted Int @default(0)
  totalMissed    Int @default(0)

  createdById Int
  createdBy   User @relation("ScheduleCreator", fields: [createdById], references: [id])

  // Attempt tracking
  attempts          TestAttemptRecord[]
  evaluationRecords EvaluationRecord[]
  activityEvents    ExamActivityEvent[]
  candidateStates   ExamCandidateState[]
  incidents         ExamIncident[]
  broadcasts        ExamBroadcast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([examId])
  @@index([startTime])
  @@map("test_schedules")
}

// ── Attempt tracking per student per schedule ────────────────
model TestAttemptRecord {
  id            Int          @id @default(autoincrement())
  scheduleId    Int
  schedule      TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  schoolId      Int
  studentId     Int
  student       Student      @relation(fields: [studentId], references: [id])
  attemptNumber Int          @default(1)

  status        String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | TIMED_OUT | ABANDONED
  startedAt     DateTime?
  submittedAt   DateTime?
  timeTakenSecs Int?

  obtainedMarks Decimal? @db.Decimal(8, 2)
  totalMarks    Decimal? @db.Decimal(8, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  rank          Int?
  isPassed      Boolean?

  // Violations
  tabSwitchCount   Int     @default(0)
  isForceSubmitted Boolean @default(false)
  resultVisible    Boolean @default(false)

  responses Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, studentId, attemptNumber])
  @@index([scheduleId])
  @@index([studentId])
  @@map("test_attempt_records")
}

// ── Per-attempt activity event log ──────────────────────────
model ExamActivityEvent {
  id         Int          @id @default(autoincrement())
  schoolId   Int
  scheduleId Int
  schedule   TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id])
  attemptId  Int?

  eventType       ActivityEventType
  metadata        Json? // { questionNo, tabSwitchCount, ipAddress, deviceInfo }
  isAutoGenerated Boolean           @default(true)
  severity        AlertLevel?

  occurredAt DateTime @default(now())

  @@index([scheduleId])
  @@index([studentId])
  @@index([scheduleId, studentId])
  @@index([schoolId, scheduleId, eventType])
  @@map("exam_activity_events")
}

// ── Candidate live state (upserted on each ping) ─────────────
model ExamCandidateState {
  id         Int          @id @default(autoincrement())
  schoolId   Int
  scheduleId Int
  schedule   TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id])

  // Real-time state
  status             String  @default("NOT_STARTED")
  // NOT_STARTED | ACTIVE | IDLE | SUBMITTED | DISCONNECTED | PAUSED | SUSPICIOUS
  currentQuestion    Int?
  questionsAttempted Int     @default(0)
  questionsSkipped   Int     @default(0)
  markedForReview    Int     @default(0)
  progressPercent    Decimal @default(0) @db.Decimal(5, 2)

  // Timing
  startedAt         DateTime?
  lastActivityAt    DateTime?
  submittedAt       DateTime?
  timeRemainingMins Int?

  // Device & network
  ipAddress  String? @db.VarChar(45)
  deviceInfo String? @db.VarChar(200)
  browser    String? @db.VarChar(100)

  // Violations
  tabSwitchCount  Int         @default(0)
  disconnectCount Int         @default(0)
  suspicionScore  Int         @default(0) // 0-100
  alertLevel      AlertLevel?

  // Admin controls
  isPaused      Boolean @default(false)
  isExtended    Boolean @default(false)
  extensionMins Int     @default(0)
  isBlocked     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, studentId])
  @@index([schoolId, scheduleId])
  @@index([status])
  @@map("exam_candidate_states")
}

// ── Incident reports ─────────────────────────────────────────
model ExamIncident {
  id         Int          @id @default(autoincrement())
  schoolId   Int
  scheduleId Int
  schedule   TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  Int?
  student    Student?     @relation(fields: [studentId], references: [id])

  incidentType    IncidentType @default(OTHER)
  severity        AlertLevel   @default(MEDIUM)
  description     String       @db.VarChar(500)
  actionTaken     String?      @db.VarChar(300)
  isAutoGenerated Boolean      @default(false)
  isResolved      Boolean      @default(false)
  resolvedAt      DateTime?
  reportedById    Int?
  reportedBy      User?        @relation("IncidentReporter", fields: [reportedById], references: [id])

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([scheduleId])
  @@index([schoolId, scheduleId])
  @@map("exam_incidents")
}

// ── Broadcast messages ───────────────────────────────────────
model ExamBroadcast {
  id          Int          @id @default(autoincrement())
  schoolId    Int
  scheduleId  Int
  schedule    TestSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  message     String       @db.VarChar(500)
  isEmergency Boolean      @default(false)
  sentById    Int
  sentBy      User         @relation("BroadcastSender", fields: [sentById], references: [id])
  sentAt      DateTime     @default(now())

  @@index([scheduleId])
  @@map("exam_broadcasts")
}

// ── Per-submission evaluation record ─────────────────────────
model EvaluationRecord {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  scheduleId Int
  schedule   TestSchedule @relation(fields: [scheduleId], references: [id])
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id])
  examId     Int
  exam       OnlineExam   @relation(fields: [examId], references: [id])

  // Scores
  totalMarks    Decimal  @default(0) @db.Decimal(8, 2)
  obtainedMarks Decimal  @default(0) @db.Decimal(8, 2)
  autoMarks     Decimal  @default(0) @db.Decimal(8, 2) // MCQ auto
  manualMarks   Decimal  @default(0) @db.Decimal(8, 2) // Subjective
  percentage    Decimal  @default(0) @db.Decimal(5, 2)
  grade         String?  @db.VarChar(10)
  gradePoint    Decimal? @db.Decimal(4, 2)
  isPassed      Boolean  @default(false)
  rank          Int?

  // Per-question marks (JSON array)
  // [{questionId, questionType, maxMarks, obtainedMarks, isCorrect, feedback, evaluatedBy}]
  questionMarks Json?

  // Overall feedback
  teacherFeedback String? @db.VarChar(1000)
  overallRemark   String? @db.VarChar(300)

  // Status
  status          EvalStatus @default(PENDING)
  isResultVisible Boolean    @default(false)
  isLocked        Boolean    @default(false)

  // Who evaluated
  evaluatedById Int?
  evaluatedBy   User?     @relation("EvaluatedBy", fields: [evaluatedById], references: [id])
  evaluatedAt   DateTime?
  verifiedById  Int?
  verifiedBy    User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  publishedById Int?
  publishedBy   User?     @relation("PublishedBy2", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  // Stats
  timeTakenSecs  Int?
  correctAnswers Int  @default(0)
  wrongAnswers   Int  @default(0)
  skippedAnswers Int  @default(0)

  recheckRequests RecheckRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, studentId])
  @@index([schoolId])
  @@index([examId])
  @@index([status])
  @@map("evaluation_records")
}

// ── Re-evaluation request ─────────────────────────────────────
model RecheckRequest {
  id           Int              @id @default(autoincrement())
  schoolId     Int
  evaluationId Int
  evaluation   EvaluationRecord @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student          @relation(fields: [studentId], references: [id])

  reason           String        @db.VarChar(500)
  specificQuestion Int? // questionId if specific question
  status           RecheckStatus @default(PENDING)
  reviewNote       String?       @db.VarChar(300)
  oldMarks         Decimal?      @db.Decimal(8, 2)
  newMarks         Decimal?      @db.Decimal(8, 2)
  resolvedById     Int?
  resolvedBy       User?         @relation("RecheckResolver", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([evaluationId])
  @@map("recheck_requests")
}

// ── Per-exam security policy (overrides exam defaults) ───────
model ExamSecurityPolicy {
  id       Int        @id @default(autoincrement())
  schoolId Int
  school   School     @relation(fields: [schoolId], references: [id])
  examId   Int        @unique
  exam     OnlineExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Full screen
  fullScreenRequired Boolean @default(false)
  fullScreenPolicy   String  @default("OPTIONAL") @db.VarChar(20) // REQUIRED | OPTIONAL

  // Tab switching
  tabSwitchPolicy TabSwitchPolicy @default(WARN)
  maxTabSwitches  Int             @default(3)

  // Browser refresh
  refreshPolicy String @default("WARN") @db.VarChar(20) // ALLOW | WARN | AUTO_SUBMIT

  // Login & device
  preventMultiLogin Boolean @default(true)
  singleDeviceOnly  Boolean @default(false)
  allowedIpRange    String? @db.VarChar(200) // comma-separated CIDRs
  deviceRestriction String  @default("ANY") @db.VarChar(20)

  // Content restrictions
  copyPasteRestrict Boolean @default(false)
  rightClickDisable Boolean @default(false)
  printDisable      Boolean @default(true)

  // Window
  examWindowRestrict Boolean @default(true)
  idleTimeoutMins    Int     @default(15)

  createdById Int
  createdBy   User     @relation("PolicyCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@map("exam_security_policies")
}

// ── Global security settings per school ──────────────────────
model SchoolSecuritySettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // Defaults applied to all new exams
  defaultTabSwitchPolicy   String  @default("WARN") @db.VarChar(20)
  defaultMaxTabSwitches    Int     @default(3)
  defaultRefreshPolicy     String  @default("WARN") @db.VarChar(20)
  defaultPreventMultiLogin Boolean @default(true)
  defaultSingleDevice      Boolean @default(false)
  defaultCopyPaste         Boolean @default(false)
  defaultRightClick        Boolean @default(false)

  // Notifications
  alertAdminOnTabSwitch    Boolean @default(true)
  alertAdminOnMultiLogin   Boolean @default(true)
  alertTeacherOnSuspicious Boolean @default(true)
  alertParentOnIncident    Boolean @default(false)

  // Thresholds
  suspicionHighThreshold     Int     @default(60)
  suspicionCriticalThreshold Int     @default(80)
  autoBlockOnCritical        Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("school_security_settings")
}

// ── Saved/generated report metadata ─────────────────────────
model SavedReport {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  school      School @relation(fields: [schoolId], references: [id])
  createdById Int
  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])

  title      String       @db.VarChar(300)
  reportType ReportType
  format     ReportFormat @default(PDF)
  status     ReportStatus @default(READY)

  // Filter params stored as JSON so we can regenerate
  filters   Json? // {examId, scheduleId, classId, subjectId, studentId, dateFrom, dateTo}
  fileUrl   String? @db.VarChar(500)
  fileSize  Int? // bytes
  pageCount Int?

  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?

  isShared   Boolean   @default(false)
  sharedWith String[] // email addresses or role names
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, reportType])
  @@index([createdById])
  @@map("saved_reports")
}

// ── Scheduled / recurring reports ────────────────────────────
model ScheduledReport {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  school      School @relation(fields: [schoolId], references: [id])
  createdById Int
  createdBy   User   @relation("ScheduledReportCreator", fields: [createdById], references: [id])

  title      String            @db.VarChar(200)
  reportType ReportType
  format     ReportFormat      @default(PDF)
  frequency  ScheduleFrequency
  filters    Json?

  recipients String[] // emails
  isActive   Boolean   @default(true)
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  runCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("scheduled_reports")
}

// ── Report templates ─────────────────────────────────────────
model ReportTemplate {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  school      School @relation(fields: [schoolId], references: [id])
  createdById Int
  createdBy   User   @relation("TemplateCreator", fields: [createdById], references: [id])

  name        String     @db.VarChar(200)
  description String?    @db.VarChar(400)
  reportType  ReportType
  isDefault   Boolean    @default(false)
  config      Json // {fields, filters, charts, layout}
  useCount    Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("report_templates")
}

// ── Single settings record per school (upsert) ───────────────
model OnlineExamSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // ─ 1. General ────────────────────────────────────────────
  defaultTimeZone    String  @default("Asia/Kolkata") @db.VarChar(50)
  defaultLanguage    String  @default("ENGLISH") @db.VarChar(20) // ENGLISH | HINDI | BILINGUAL
  schoolLogoUrl      String? @db.VarChar(500)
  schoolWatermarkUrl String? @db.VarChar(500)
  examHeaderText     String? @db.VarChar(200)
  examNamingPattern  String  @default("{CODE}-{YEAR}-{SEQ}") @db.VarChar(100)

  // ─ 2. Exam Defaults ──────────────────────────────────────
  defaultDurationMins     Int     @default(60)
  defaultPassingPercent   Decimal @default(33) @db.Decimal(5, 2)
  defaultNegativeMarking  Boolean @default(false)
  defaultAttemptsAllowed  Int     @default(1)
  defaultResultVisibility String  @default("AFTER_SUBMISSION") @db.VarChar(30)
  defaultRandomizeQns     Boolean @default(false)
  defaultShuffleOptions   Boolean @default(false)
  defaultMarkForReview    Boolean @default(true)

  // ─ 3. Question Settings ───────────────────────────────────
  defaultDifficulty        String  @default("MEDIUM") @db.VarChar(10)
  questionApprovalRequired Boolean @default(false)
  duplicateDetection       Boolean @default(true)
  questionVersioning       Boolean @default(false)

  // ─ 4. Evaluation Settings ────────────────────────────────
  autoEvalEnabled      Boolean @default(true)
  manualReviewRequired Boolean @default(true)
  allowReEvalRequests  Boolean @default(true)
  gradeCalcMethod      String  @default("PERCENTAGE") @db.VarChar(20) // MARKS | PERCENTAGE | GPA
  autoPublishAfterEval Boolean @default(false)
  lockAfterPublish     Boolean @default(true)

  // ─ 5. Result Settings ─────────────────────────────────────
  showRank           Boolean @default(true)
  showGrade          Boolean @default(true)
  showPercentage     Boolean @default(true)
  showCorrectAnswers String  @default("AFTER_EXAM") @db.VarChar(20) // NEVER | AFTER_SUBMISSION | AFTER_EXAM
  showExplanations   Boolean @default(true)
  resultPdfLogo      Boolean @default(true)
  resultPdfSignature Boolean @default(false)
  resultPdfQrCode    Boolean @default(false)

  // ─ 6. Security ────────────────────────────────────────────
  secFullScreenDefault  Boolean @default(false)
  secTabSwitchPolicy    String  @default("WARN") @db.VarChar(20) // ALLOW | WARN | BLOCK
  secRefreshPolicy      String  @default("WARN") @db.VarChar(20)
  secMultiLoginPolicy   String  @default("PREVENT") @db.VarChar(20)
  secDeviceRestriction  String  @default("ANY") @db.VarChar(20)
  secIpRestriction      Boolean @default(false)
  secSessionTimeoutMins Int     @default(15)
  secAuditLogging       Boolean @default(true)

  // ─ 7. Student Experience ─────────────────────────────────
  uiTheme                String  @default("SYSTEM") @db.VarChar(10) // LIGHT | DARK | SYSTEM
  uiNavigationMode       String  @default("FREE") @db.VarChar(15)
  uiQuestionPalette      Boolean @default(true)
  uiProgressBar          Boolean @default(true)
  uiTimerPosition        String  @default("TOP") @db.VarChar(10) // TOP | FLOATING
  uiAutoSaveIntervalSecs Int     @default(30)
  uiAllowResume          Boolean @default(false)

  // ─ 8. Notifications ──────────────────────────────────────
  notifyOnExamCreated     Boolean @default(true)
  notifyOnExamScheduled   Boolean @default(true)
  notifyReminder1Day      Boolean @default(true)
  notifyReminder1Hour     Boolean @default(true)
  notifyReminder15Min     Boolean @default(false)
  notifyOnResultPublished Boolean @default(true)
  notifyParentsOnResult   Boolean @default(false)
  notifyViaEmail          Boolean @default(true)
  notifyViaPush           Boolean @default(false)

  // ─ 9. Certificates ───────────────────────────────────────
  certAutoGenerate     Boolean @default(false)
  certMinScorePercent  Decimal @default(70) @db.Decimal(5, 2)
  certTemplateId       Int?
  certQrVerification   Boolean @default(true)
  certDigitalSignature Boolean @default(false)

  // ─ 10. Data & Storage ────────────────────────────────────
  dataRetentionYears  Int     @default(5)
  autoArchiveOldExams Boolean @default(true)
  backupFrequency     String  @default("DAILY") @db.VarChar(10)

  // ─ 11. Advanced / Feature Flags ──────────────────────────
  featureQuestionBank   Boolean @default(true)
  featureReports        Boolean @default(true)
  featureLiveMonitoring Boolean @default(true)
  featureSecurity       Boolean @default(true)
  featureCertificates   Boolean @default(false)
  featureAIInsights     Boolean @default(false)

  updatedById Int?
  updatedBy   User?    @relation("SettingsUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("online_exam_settings")
}

model Enquiry {
  id        Int    @id @default(autoincrement())
  schoolId  Int
  school    School @relation(fields: [schoolId], references: [id])
  enquiryNo String @unique @db.VarChar(30)

  // Student info
  studentName  String    @db.VarChar(150)
  gender       String?   @db.VarChar(10)
  dateOfBirth  DateTime? @db.Date
  currentClass String?   @db.VarChar(20)

  // Admission interest
  interestedClass   String? @db.VarChar(20)
  interestedSession String? @db.VarChar(30)
  interestedSection String? @db.VarChar(10)

  // Parent info
  fatherName     String? @db.VarChar(150)
  motherName     String? @db.VarChar(150)
  mobileNumber   String  @db.VarChar(15)
  whatsappNumber String? @db.VarChar(15)
  email          String? @db.VarChar(150)
  address        String? @db.VarChar(300)
  city           String? @db.VarChar(80)
  state          String? @db.VarChar(80)

  // Lead info
  source       EnquirySource @default(WALK_IN)
  referredBy   String?       @db.VarChar(150)
  assignedToId Int?
  assignedTo   User?         @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  remarks      String?       @db.VarChar(500)

  // Status
  status             EnquiryStatus @default(NEW)
  isConverted        Boolean       @default(false)
  convertedAt        DateTime?
  convertedStudentId Int?

  followUps  FollowUp[]
  activities EnquiryActivity[]

  createdById Int
  createdBy   User     @relation("EnquiryCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, source])
  @@index([mobileNumber])
  @@map("enquiries")
}

model FollowUp {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  enquiryId Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  scheduledTime String?         @db.VarChar(10) // "10:30 AM"
  notes         String?         @db.VarChar(400)
  status        FollowUpStatus?
  resultNotes   String?         @db.VarChar(300)
  isDone        Boolean         @default(false)
  doneAt        DateTime?

  createdById Int
  createdBy   User     @relation("FollowUpCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  School      School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([enquiryId])
  @@index([scheduledDate])
  @@map("follow_ups")
}

model EnquiryActivity {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  enquiryId   Int
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(50) // CREATED | STATUS_CHANGE | FOLLOW_UP | CALL | VISIT | NOTE
  description String   @db.VarChar(400)
  createdById Int
  createdBy   User     @relation("ActivityCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([enquiryId])
  @@map("enquiry_activities")
}

// ════════════════════════════════════════════════════════════
//  VISITOR MANAGEMENT
// ════════════════════════════════════════════════════════════

model Visitor {
  id        Int    @id @default(autoincrement())
  schoolId  Int
  school    School @relation(fields: [schoolId], references: [id])
  visitorNo String @unique @db.VarChar(30)

  // Visitor details
  visitorName  String      @db.VarChar(150)
  mobileNumber String      @db.VarChar(15)
  email        String?     @db.VarChar(150)
  visitorType  VisitorType @default(PARENT)
  idProofUrl   String?     @db.VarChar(500)
  photoUrl     String?     @db.VarChar(500)

  // Visit info
  purpose          VisitPurpose @default(OTHER)
  purposeNote      String?      @db.VarChar(200)
  personToMeetId   Int?
  personToMeet     User?        @relation("VisitorMeeting", fields: [personToMeetId], references: [id])
  personToMeetName String?      @db.VarChar(150)

  // Timing
  expectedDate      DateTime? @db.Date
  expectedTime      String?   @db.VarChar(10)
  checkInAt         DateTime?
  checkOutAt        DateTime?
  visitDurationMins Int?

  // Status
  status        VisitorStatus @default(EXPECTED)
  remarks       String?       @db.VarChar(300)
  isBlacklisted Boolean       @default(false)

  gatePassNo String? @db.VarChar(20)

  createdById Int
  createdBy   User     @relation("VisitorCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([mobileNumber])
  @@index([checkInAt])
  @@map("visitors")
}

model Complaint {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  ticketNo String @unique @db.VarChar(30)

  // Complainant
  complaintBy       ComplaintBy @default(PARENT)
  complainantName   String      @db.VarChar(150)
  complainantMobile String?     @db.VarChar(15)
  complainantEmail  String?     @db.VarChar(150)
  isAnonymous       Boolean     @default(false)

  // Related entities
  relatedStudentId Int?
  relatedStudent   Student? @relation(fields: [relatedStudentId], references: [id])
  relatedModule    String?  @db.VarChar(30) // STUDENT | TEACHER | TRANSPORT | HOSTEL | FEE
  relatedModuleId  Int?

  // Complaint details
  category       ComplaintCategory @default(OTHER)
  title          String            @db.VarChar(300)
  description    String            @db.Text
  priority       ComplaintPriority @default(MEDIUM)
  attachmentUrls String[]
  tags           String[]

  // Assignment & department
  assignedToId Int?
  assignedTo   User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  department   String?   @db.VarChar(80)
  assignedAt   DateTime?

  // Status & resolution
  status            ComplaintStatus @default(OPEN)
  resolutionSummary String?         @db.Text
  resolvedAt        DateTime?
  closedAt          DateTime?

  // SLA
  slaDeadline DateTime?
  slaBreached Boolean   @default(false)
  slaHours    Int? // set on creation per priority

  // Escalation
  escalationLevel EscalationLevel?
  escalatedAt     DateTime?
  escalatedToId   Int?
  escalatedTo     User?            @relation("EscalationTarget", fields: [escalatedToId], references: [id])
  autoEscalated   Boolean          @default(false)

  // Feedback (after close)
  feedbackRating  Int? // 1-5
  feedbackComment String?   @db.VarChar(400)
  feedbackAt      DateTime?

  timeline ComplaintTimeline[]

  createdById Int
  createdBy   User     @relation("ComplaintCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, category])
  @@index([schoolId, priority])
  @@index([assignedToId])
  @@index([slaDeadline])
  @@map("complaints")
}

model ComplaintTimeline {
  id             Int       @id @default(autoincrement())
  schoolId       Int
  complaintId    Int
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type           String    @db.VarChar(40) // CREATED | STATUS_CHANGE | ASSIGNMENT | NOTE | ESCALATION | RESOLUTION | FEEDBACK
  content        String    @db.VarChar(800)
  isPublic       Boolean   @default(false) // visible to complainant
  attachmentUrls String[]
  createdById    Int
  createdBy      User      @relation("TimelineCreator", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  School         School    @relation(fields: [schoolId], references: [id])

  @@index([complaintId])
  @@map("complaint_timelines")
}

model CommunicationMessage {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  title    String         @db.VarChar(300)
  body     String         @db.Text
  channel  MessageChannel @default(APP_NOTIFICATION)
  category NoticeCategory @default(GENERAL)

  // Audience
  audienceType    AudienceType @default(ALL_PARENTS)
  classIds        Int[]
  sectionIds      Int[]
  specificUserIds Int[]
  recipientCount  Int          @default(0)

  // Extras
  attachmentUrls String[]
  isEmergency    Boolean   @default(false)
  isPinned       Boolean   @default(false)
  pinExpiry      DateTime?
  language       String    @default("ENGLISH") @db.VarChar(20)

  // Status
  status      MessageStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  // Recurring
  recurring      RecurringType @default(NONE)
  recurringEndAt DateTime?
  nextRunAt      DateTime?

  // Delivery stats
  deliveredCount Int      @default(0)
  readCount      Int      @default(0)
  failedCount    Int      @default(0)
  failedNumbers  String[] // for SMS failures

  // Template reference
  templateId Int?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])

  // Module trigger (attendance/fee/exam auto-sends)
  triggerModule String? @db.VarChar(30)
  triggerRef    String? @db.VarChar(50)

  sentById  Int
  sentBy    User     @relation("MessageSender", fields: [sentById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, channel])
  @@index([schoolId, status])
  @@index([scheduledAt])
  @@map("communication_messages")
}

model MessageTemplate {
  id          Int                    @id @default(autoincrement())
  schoolId    Int
  school      School                 @relation(fields: [schoolId], references: [id])
  name        String                 @db.VarChar(150)
  channel     MessageChannel         @default(SMS)
  category    NoticeCategory         @default(GENERAL)
  subject     String?                @db.VarChar(200)
  body        String                 @db.Text
  variables   String[] // ["studentName","class","amount"]
  useCount    Int                    @default(0)
  isDefault   Boolean                @default(false)
  language    String                 @default("ENGLISH") @db.VarChar(20)
  createdById Int
  createdBy   User                   @relation("TemplateCreator2", fields: [createdById], references: [id])
  messages    CommunicationMessage[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([schoolId])
  @@map("message_templates")
}

model FrontOfficeSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // General
  officeOpenTime  String   @default("09:00") @db.VarChar(10)
  officeCloseTime String   @default("17:00") @db.VarChar(10)
  workingDays     String[] // ["MON","TUE","WED","THU","FRI"]

  // Enquiry
  enquiryAutoNumber     Boolean @default(true)
  enquiryPrefix         String  @default("ENQ") @db.VarChar(15)
  enquiryDefaultStatus  String  @default("NEW") @db.VarChar(20)
  enquiryAutoAssign     Boolean @default(false)
  followUpReminderHours Int     @default(24)
  leadCooldownDays      Int     @default(90)

  // Visitor
  visitorAutoNumber     Boolean @default(true)
  visitorPrefix         String  @default("VIS") @db.VarChar(15)
  visitorPassRequired   Boolean @default(true)
  visitorPhotoRequired  Boolean @default(false)
  visitorIdRequired     Boolean @default(false)
  maxVisitDurationHours Int     @default(4)

  // Complaint
  complaintPrefix              String  @default("TKT") @db.VarChar(15)
  slaLowDays                   Int     @default(7)
  slaMediumDays                Int     @default(3)
  slaHighDays                  Int     @default(1)
  slaUrgentHours               Int     @default(12)
  complaintAutoEscalate        Boolean @default(true)
  escalateAfterHoursMultiplier Decimal @default(1.5) @db.Decimal(4, 1)

  // Communication
  smsGateway         String? @db.VarChar(50)
  smsSenderId        String? @db.VarChar(20)
  emailFromAddress   String? @db.VarChar(150)
  emailFromName      String? @db.VarChar(80)
  whatsappApiEnabled Boolean @default(false)
  noticeExpiryDays   Int     @default(30)
  defaultLanguage    String  @default("ENGLISH") @db.VarChar(20)

  // Automation
  autoAssignEnquiry         Boolean @default(false)
  autoFollowUpCreate        Boolean @default(true)
  autoNotifyDeptOnComplaint Boolean @default(true)
  autoSendExamReminder      Boolean @default(true)
  autoSendFeeReminder       Boolean @default(true)
  autoSendAbsentAlert       Boolean @default(true)

  updatedById Int?
  updatedBy   User?    @relation("FOSettingsUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("front_office_settings")
}

model FrontOfficeSettingsAudit {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id])
  userId     Int
  user       User     @relation("FOAuditUser", fields: [userId], references: [id])
  action     String   @db.VarChar(100)
  changes    Json? // before/after diff
  ipAddress  String?  @db.VarChar(45)
  occurredAt DateTime @default(now())

  @@index([schoolId])
  @@map("front_office_settings_audit")
}

// ════════════════════════════════════════════════════════════
//  STAFF MANAGEMENT (FRONT OFFICE SPECIFIC)
// ════════════════════════════════════════════════════════════

model FOStaffProfile {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  userId      Int       @unique
  user        User      @relation("FOStaff", fields: [userId], references: [id])
  employeeId  String?   @db.VarChar(30)
  phone       String?   @db.VarChar(15)
  joiningDate DateTime? @db.Date
  isActive    Boolean   @default(true)
  notes       String?   @db.VarChar(400)

  targetEnquiries  Int @default(50)
  targetAdmissions Int @default(10)
  targetFollowUps  Int @default(100)
  targetComplaints Int @default(20)

  assignments  FOAssignment[]
  activityLogs FOActivityLog[]
  monthlyPerfs FOMonthlyPerf[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("fo_staff_profiles")
}

model FOAssignment {
  id           Int              @id @default(autoincrement())
  schoolId     Int
  staffId      Int
  staff        FOStaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type         FOAssignmentType
  entityId     Int // enquiryId | complaintId | visitorId
  isCompleted  Boolean          @default(false)
  completedAt  DateTime?
  dueDate      DateTime?
  notes        String?          @db.VarChar(200)
  assignedById Int
  createdAt    DateTime         @default(now())
  School       School           @relation(fields: [schoolId], references: [id])

  @@index([staffId])
  @@index([schoolId, type])
  @@map("fo_assignments")
}

model FOActivityLog {
  id          Int            @id @default(autoincrement())
  schoolId    Int
  staffId     Int
  staff       FOStaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action      String         @db.VarChar(80) // ENQUIRY_ADDED | VISITOR_CHECKIN | COMPLAINT_UPDATED | MSG_SENT
  description String?        @db.VarChar(300)
  entityType  String?        @db.VarChar(30)
  entityId    Int?
  occurredAt  DateTime       @default(now())
  School      School         @relation(fields: [schoolId], references: [id])

  @@index([staffId])
  @@index([schoolId, occurredAt])
  @@map("fo_activity_logs")
}

model FOMonthlyPerf {
  id                  Int            @id @default(autoincrement())
  schoolId            Int
  staffId             Int
  staff               FOStaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month               Int // 1-12
  year                Int
  enquiriesHandled    Int            @default(0)
  admissionsConverted Int            @default(0)
  visitorsManaged     Int            @default(0)
  complaintsResolved  Int            @default(0)
  followUpsDone       Int            @default(0)
  callsLogged         Int            @default(0)
  rating              Decimal?       @db.Decimal(3, 1) // 1.0 - 5.0
  School              School         @relation(fields: [schoolId], references: [id])

  @@unique([staffId, month, year])
  @@index([schoolId])
  @@map("fo_monthly_perf")
}


model DepartmentBudget {
  id          Int               @id @default(autoincrement())
  schoolId    Int
  school      School            @relation(fields: [schoolId], references: [id])
  department  ExpenseDepartment
  fiscalYear  Int
  totalBudget Decimal           @db.Decimal(14, 2)
  usedAmount  Decimal           @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([schoolId, department, fiscalYear])
  @@index([schoolId])
  @@map("department_budgets")
}

model ExpenseRequest {
  id        Int    @id @default(autoincrement())
  schoolId  Int
  school    School @relation(fields: [schoolId], references: [id])
  expenseNo String @unique @db.VarChar(30)

  department     ExpenseDepartment
  category       ExpenseCategory   @default(OTHER)
  amount         Decimal           @db.Decimal(12, 2)
  expenseDate    DateTime          @db.Date
  vendorName     String?           @db.VarChar(150)
  description    String            @db.Text
  attachmentUrls String[]
  status         ExpenseStatus     @default(DRAFT)

  // Amount-based routing
  requiresMgmt Boolean @default(false) // > ₹50,000

  // Approval chain
  deptApprovedById      Int?
  deptApprovedBy        User?     @relation("ExpDeptApprover", fields: [deptApprovedById], references: [id])
  deptApprovedAt        DateTime?
  principalApprovedById Int?
  principalApprovedBy   User?     @relation("ExpPrincipalApprover", fields: [principalApprovedById], references: [id])
  principalApprovedAt   DateTime?
  accountsApprovedById  Int?
  accountsApprovedBy    User?     @relation("ExpAccountsApprover", fields: [accountsApprovedById], references: [id])
  accountsApprovedAt    DateTime?
  mgmtApprovedById      Int?
  mgmtApprovedBy        User?     @relation("ExpMgmtApprover", fields: [mgmtApprovedById], references: [id])
  mgmtApprovedAt        DateTime?

  rejectedById    Int?
  rejectedBy      User?     @relation("ExpRejecter", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(300)
  sendBackReason  String?   @db.VarChar(300)

  // Payment
  paymentDate   DateTime? @db.Date
  paymentMethod String?   @db.VarChar(30)
  transactionId String?   @db.VarChar(100)
  paidById      Int?
  paidBy        User?     @relation("ExpPayer", fields: [paidById], references: [id])
  paidAt        DateTime?

  createdById Int
  createdBy   User     @relation("ExpCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, department])
  @@map("expense_requests")
}

model StaffLoan {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  loanNo   String @unique @db.VarChar(30)

  staffId Int
  staff   Staff @relation("StaffLoans", fields: [staffId], references: [id])

  loanType        LoanType @default(PERSONAL)
  requestedAmount Decimal  @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  disbursedAmount Decimal? @db.Decimal(12, 2)

  // Interest
  isInterestFree Boolean @default(true)
  interestRate   Decimal @default(0) @db.Decimal(5, 2) // annual %
  interestType   String  @default("SIMPLE") @db.VarChar(10)

  tenureMonths      Int      @default(3)
  emiAmount         Decimal? @db.Decimal(12, 2)
  totalPayable      Decimal? @db.Decimal(12, 2)
  paidAmount        Decimal  @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal? @db.Decimal(12, 2)

  reason             String @db.VarChar(400)
  recoveryStartMonth Int? // 1-12
  recoveryStartYear  Int?

  status LoanStatus @default(PENDING)

  // Approvals
  principalApprovedById Int?
  principalApprovedBy   User?     @relation("LoanPrincipalApprover", fields: [principalApprovedById], references: [id])
  principalApprovedAt   DateTime?
  accountsApprovedById  Int?
  accountsApprovedBy    User?     @relation("LoanAccountsApprover", fields: [accountsApprovedById], references: [id])
  accountsApprovedAt    DateTime?
  mgmtApprovedById      Int?
  mgmtApprovedBy        User?     @relation("LoanMgmtApprover", fields: [mgmtApprovedById], references: [id])
  mgmtApprovedAt        DateTime?
  rejectedById          Int?
  rejectedBy            User?     @relation("LoanRejecter", fields: [rejectedById], references: [id])
  rejectedAt            DateTime?
  rejectionReason       String?   @db.VarChar(300)

  // Disbursement
  disbursementDate DateTime? @db.Date
  disbursementMode String?   @db.VarChar(30)
  disbursementRef  String?   @db.VarChar(100)
  disbursedById    Int?
  disbursedBy      User?     @relation("LoanDisburser", fields: [disbursedById], references: [id])

  closedAt      DateTime?
  closureReason String?   @db.VarChar(200)

  emis LoanEmi[]

  createdById Int
  createdBy   User     @relation("LoanCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([staffId])
  @@index([schoolId, status])
  @@map("staff_loans")
}

model LoanEmi {
  id                 Int       @id @default(autoincrement())
  schoolId           Int
  loanId             Int
  loan               StaffLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  emiNumber          Int // 1, 2, 3...
  dueMonth           Int
  dueYear            Int
  dueAmount          Decimal   @db.Decimal(12, 2)
  paidAmount         Decimal   @default(0) @db.Decimal(12, 2)
  status             EmiStatus @default(PENDING)
  paidAt             DateTime?
  deductedFromSalary Boolean   @default(false)
  salaryRecordId     Int?
  remarks            String?   @db.VarChar(200)
  School             School    @relation(fields: [schoolId], references: [id])

  @@unique([loanId, emiNumber])
  @@index([schoolId])
  @@index([loanId])
  @@map("loan_emis")
}

model Reimbursement {
  id        Int    @id @default(autoincrement())
  schoolId  Int
  school    School @relation(fields: [schoolId], references: [id])
  requestNo String @unique @db.VarChar(30) // REQ-YYMM-XXXX

  // Claimant
  staffId    Int
  staff      Staff   @relation("StaffReimbursements", fields: [staffId], references: [id])
  department String? @db.VarChar(80)

  category       ReimbursementCategory @default(OTHER)
  amount         Decimal               @db.Decimal(12, 2)
  expenseDate    DateTime              @db.Date
  description    String                @db.Text
  attachmentUrls String[]
  priority       ReimbursementPriority @default(MEDIUM)
  status         ReimbursementStatus   @default(DRAFT)

  // Multi-level approval
  deptApprovedById      Int?
  deptApprovedBy        User?     @relation("ReimDeptApprover", fields: [deptApprovedById], references: [id])
  deptApprovedAt        DateTime?
  principalApprovedById Int?
  principalApprovedBy   User?     @relation("ReimPrincipalApprover", fields: [principalApprovedById], references: [id])
  principalApprovedAt   DateTime?
  accountsApprovedById  Int?
  accountsApprovedBy    User?     @relation("ReimAccountsApprover", fields: [accountsApprovedById], references: [id])
  accountsApprovedAt    DateTime?

  rejectedById    Int?
  rejectedBy      User?     @relation("ReimRejecter", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(300)

  // Payment
  paymentDate   DateTime? @db.Date
  paymentMethod String?   @db.VarChar(30)
  transactionId String?   @db.VarChar(100)
  paidById      Int?
  paidBy        User?     @relation("ReimPayer", fields: [paidById], references: [id])
  paidAt        DateTime?

  remarks String? @db.VarChar(300)

  createdById Int
  createdBy   User     @relation("ReimCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([staffId])
  @@map("reimbursements")
}

model Vendor {
  id          Int            @id @default(autoincrement())
  schoolId    Int
  school      School         @relation(fields: [schoolId], references: [id])
  vendorCode  String         @db.VarChar(30)
  name        String         @db.VarChar(200)
  category    VendorCategory @default(OTHER)
  mobile      String?        @db.VarChar(15)
  email       String?        @db.VarChar(150)
  gstNumber   String?        @db.VarChar(20)
  panNumber   String?        @db.VarChar(15)
  address     String?        @db.VarChar(400)
  // Bank details
  bankName    String?        @db.VarChar(100)
  accountNo   String?        @db.VarChar(30)
  ifscCode    String?        @db.VarChar(15)
  accountName String?        @db.VarChar(150)
  isActive    Boolean        @default(true)
  notes       String?        @db.VarChar(300)
  rating      Int? // 1-5
  bills       VendorBill[]
  createdById Int
  createdBy   User           @relation("VendorCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([schoolId, vendorCode])
  @@index([schoolId])
  @@map("vendors")
}

model VendorBill {
  id             Int            @id @default(autoincrement())
  schoolId       Int
  school         School         @relation(fields: [schoolId], references: [id])
  billNo         String         @db.VarChar(60)
  vendorId       Int
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  category       VendorCategory @default(OTHER)
  billDate       DateTime       @db.Date
  dueDate        DateTime       @db.Date
  amount         Decimal        @db.Decimal(14, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(14, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(14, 2)
  balanceDue     Decimal        @db.Decimal(14, 2)
  description    String         @db.VarChar(400)
  attachmentUrls String[]
  status         BillStatus     @default(DRAFT)
  isRecurring    Boolean        @default(false)
  recurrenceType RecurrenceType @default(NONE)
  nextDueDate    DateTime?      @db.Date
  // Approval
  verifiedById   Int?
  verifiedBy     User?          @relation("BillVerifier", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  approvedById   Int?
  approvedBy     User?          @relation("BillApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  // Cancel
  cancelledById  Int?
  cancelledBy    User?          @relation("BillCanceller", fields: [cancelledById], references: [id])
  cancelledAt    DateTime?
  cancelReason   String?        @db.VarChar(200)

  payments    VendorPayment[]
  createdById Int
  createdBy   User            @relation("BillCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([schoolId])
  @@index([vendorId])
  @@index([schoolId, status])
  @@map("vendor_bills")
}

model VendorPayment {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      School      @relation(fields: [schoolId], references: [id])
  billId      Int
  bill        VendorBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendorId    Int
  amount      Decimal     @db.Decimal(14, 2)
  paymentDate DateTime    @db.Date
  paymentMode PaymentMode @default(BANK_TRANSFER)
  referenceNo String?     @db.VarChar(100)
  remarks     String?     @db.VarChar(300)
  isPartial   Boolean     @default(false)
  receiptUrl  String?     @db.VarChar(500)
  paidById    Int
  paidBy      User        @relation("VendorPaymentMaker", fields: [paidById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([billId])
  @@index([schoolId])
  @@map("vendor_payments")
}

// ════════════════════════════════════════════════════════════
//  ACCOUNT PERMISSIONS
// ════════════════════════════════════════════════════════════

model AccountPermission {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  userId   Int    @unique
  user     User   @relation("AccPermUser", fields: [userId], references: [id])

  // Module permissions (JSON: {view, create, edit, delete, approve})
  payrollPerms Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  salaryPerms  Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  vendorPerms  Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  loanPerms    Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  expensePerms Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  reimPerms    Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")
  docPerms     Json @default("{\"view\":true,\"create\":false,\"edit\":false,\"delete\":false,\"approve\":false}")

  // Salary visibility
  salaryVisibility   String  @default("OWN") // OWN | DEPARTMENT | ALL
  canViewAuditLogs   Boolean @default(false)
  canAccessDocuments Boolean @default(true)
  canApproveVendors  Boolean @default(false)
  canApproveSalary   Boolean @default(false)
  canApproveExpense  Boolean @default(false)

  isActive  Boolean   @default(true)
  expiresAt DateTime?
  notes     String?   @db.VarChar(200)

  createdById Int
  createdBy   User     @relation("AccPermCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("account_permissions")
}

model AccountActivityLog {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id])
  userId     Int
  user       User     @relation("AccActivityUser", fields: [userId], references: [id])
  action     String   @db.VarChar(80) // VIEWED_SALARY | EDITED_PAYROLL | APPROVED_PAYMENT etc
  module     String   @db.VarChar(40) // PAYROLL | SALARY | VENDOR | EXPENSE | LOAN
  entityId   Int?
  entityType String?  @db.VarChar(40)
  ipAddress  String?  @db.VarChar(45)
  details    Json?
  occurredAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([schoolId, module])
  @@map("account_activity_logs")
}

model FinancialDocument {
  id                Int         @id @default(autoincrement())
  schoolId          Int
  school            School      @relation(fields: [schoolId], references: [id])
  docNo             String      @unique @db.VarChar(40)
  name              String      @db.VarChar(300)
  category          DocCategory @default(OTHER)
  description       String?     @db.VarChar(500)
  fileUrl           String      @db.VarChar(600)
  fileType          String      @db.VarChar(20) // PDF | IMAGE | EXCEL | WORD
  fileSizeKb        Int?
  // Relations
  relatedStaffId    Int?
  relatedStaff      Staff?      @relation("DocStaff", fields: [relatedStaffId], references: [id])
  relatedVendorId   Int?
  relatedEntityId   Int?
  relatedEntityType String?     @db.VarChar(40)

  status     DocStatus @default(PENDING)
  expiryDate DateTime? @db.Date
  isArchived Boolean   @default(false)

  // Verification
  verifiedById      Int?
  verifiedBy        User?     @relation("DocVerifier", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?
  verificationNotes String?   @db.VarChar(300)
  rejectedReason    String?   @db.VarChar(300)

  tags         String[]
  uploadedById Int
  uploadedBy   User      @relation("DocUploader", fields: [uploadedById], references: [id])
  archivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, category])
  @@index([schoolId, status])
  @@index([relatedStaffId])
  @@map("financial_documents")
}

model AuditLog {
  id          Int             @id @default(autoincrement())
  schoolId    Int
  school      School          @relation(fields: [schoolId], references: [id])
  userId      Int
  user        User            @relation("AuditLogUser", fields: [userId], references: [id])
  module      AuditModule
  actionType  AuditActionType
  action      String          @db.VarChar(120)
  entityId    Int?
  entityType  String?         @db.VarChar(60)
  entityLabel String?         @db.VarChar(200)

  // Change tracking
  beforeValue  Json?
  afterValue   Json?
  changeReason String? @db.VarChar(300)

  // Request context
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(300)
  sessionId String? @db.VarChar(100)

  // Risk
  riskLevel    Int     @default(0) // 0=low, 1=medium, 2=high, 3=critical
  isSuspicious Boolean @default(false)
  flagReason   String? @db.VarChar(200)

  occurredAt  DateTime @default(now())
  description String?  @db.VarChar(500)
  metadata    Json?

  @@index([schoolId])
  @@index([schoolId, module])
  @@index([schoolId, userId])
  @@index([schoolId, actionType])
  @@index([schoolId, occurredAt])
  @@index([schoolId, isSuspicious])
  @@map("audit_logs")
}

model LoginHistory {
  id         Int       @id @default(autoincrement())
  schoolId   Int
  school     School    @relation(fields: [schoolId], references: [id])
  userId     Int
  user       User      @relation("LoginHistoryUser", fields: [userId], references: [id])
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(300)
  device     String?   @db.VarChar(80)
  browser    String?   @db.VarChar(80)
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  isSuccess  Boolean   @default(true)
  failReason String?   @db.VarChar(150)

  @@index([schoolId, userId])
  @@index([schoolId])
  @@map("login_history")
}

model ComplianceItem {
  id          Int                 @id @default(autoincrement())
  schoolId    Int
  school      School              @relation(fields: [schoolId], references: [id])
  title       String              @db.VarChar(200)
  description String?             @db.VarChar(500)
  type        ComplianceType      @default(OTHER)
  frequency   ComplianceFrequency @default(YEARLY)
  status      ComplianceStatus    @default(PENDING)

  dueDate       DateTime  @db.Date
  completedDate DateTime? @db.Date
  nextDueDate   DateTime? @db.Date

  // GST specific
  gstNumber      String?   @db.VarChar(20)
  // TDS specific
  tanNumber      String?   @db.VarChar(15)
  // Vendor specific
  vendorId       Int?
  contractExpiry DateTime? @db.Date

  attachmentUrls String[]
  notes          String?  @db.VarChar(400)
  isActive       Boolean  @default(true)

  assignedToId  Int?
  assignedTo    User? @relation("ComplianceAssignee", fields: [assignedToId], references: [id])
  completedById Int?
  completedBy   User? @relation("ComplianceCompleter", fields: [completedById], references: [id])

  alerts ComplianceAlert[]

  createdById Int
  createdBy   User     @relation("ComplianceCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, status])
  @@index([schoolId, dueDate])
  @@map("compliance_items")
}

model ComplianceAlert {
  id              Int            @id @default(autoincrement())
  schoolId        Int
  school          School         @relation(fields: [schoolId], references: [id])
  complianceId    Int
  compliance      ComplianceItem @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  alertDaysBefore Int // 7, 15, 30
  isTriggered     Boolean        @default(false)
  triggeredAt     DateTime?

  @@index([schoolId])
  @@map("compliance_alerts")
}

model AccountSetting {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // General
  currency     String @default("INR") @db.VarChar(10)
  numberFormat String @default("en-IN") @db.VarChar(20)
  dateFormat   String @default("DD-MM-YYYY") @db.VarChar(20)
  fyStartMonth Int    @default(4) // April
  fyEndMonth   Int    @default(3) // March

  // Payroll
  payrollCycle          String  @default("MONTHLY") @db.VarChar(20)
  salaryGenDay          Int     @default(25) // 25th of month
  attendanceIntegration Boolean @default(false)
  leaveDeductionEnabled Boolean @default(true)
  latePenaltyEnabled    Boolean @default(false)

  // Salary
  payslipTemplate        String  @default("STANDARD") @db.VarChar(30)
  salaryApprovalRequired Boolean @default(true)
  salaryLockAfterPay     Boolean @default(true)

  // Reimbursement
  reimCategories       String[] @default(["TRAVEL", "FUEL", "STATIONERY", "TRAINING", "EVENT", "MEDICAL", "OTHER"])
  reimReceiptMandatory Boolean  @default(true)
  reimMaxLimits        Json     @default("{\"FUEL\":3000,\"TRAVEL\":10000,\"MEDICAL\":5000}")

  // Loan
  loanTypes           String[] @default(["SALARY_ADVANCE", "EMERGENCY", "MEDICAL", "FESTIVAL", "PERSONAL", "EDUCATION"])
  maxLoanMultiple     Int      @default(3) // max = 3x monthly salary
  defaultInterestRate Decimal  @default(0) @db.Decimal(5, 2)
  loanRecoveryMode    String   @default("PAYROLL_DEDUCTION") @db.VarChar(30)

  // Expense
  expenseCategories       String[] @default(["STATIONERY", "FURNITURE", "MAINTENANCE", "UTILITIES", "EVENT", "OTHER"])
  expenseAutoApproveLimit Decimal  @default(5000) @db.Decimal(12, 2)
  expenseBudgetControl    Boolean  @default(true)

  // Vendor
  vendorCategories        String[] @default(["BOOKS", "UNIFORMS", "TRANSPORT", "IT", "ELECTRICITY", "MAINTENANCE", "OTHER"])
  vendorCodePrefix        String   @default("VND") @db.VarChar(10)
  vendorContractAlertDays Int      @default(30)

  // Document
  docAllowedTypes    String[] @default(["PDF", "IMAGE", "EXCEL", "WORD"])
  docMaxSizeMb       Int      @default(10)
  docAutoArchiveDays Int      @default(365)

  // Approval workflows (JSON config)
  salaryApprovalFlow  Json @default("[\"ACCOUNTANT\",\"PRINCIPAL\",\"MANAGEMENT\"]")
  expenseApprovalFlow Json @default("[\"DEPT_HEAD\",\"PRINCIPAL\",\"ACCOUNTS\"]")
  vendorApprovalFlow  Json @default("[\"ACCOUNTS\",\"PRINCIPAL\"]")
  loanApprovalFlow    Json @default("[\"PRINCIPAL\",\"ACCOUNTS\",\"MANAGEMENT\"]")

  // Notifications
  notifyOnSalaryGenerated Boolean @default(true)
  notifyOnExpenseApproved Boolean @default(true)
  notifyOnLoanApproved    Boolean @default(true)
  notifyOnVendorPayment   Boolean @default(true)
  notifyOnComplianceDue   Boolean @default(true)

  // Audit
  logRetentionYears         Int     @default(7)
  auditAlertEnabled         Boolean @default(true)
  sensitiveActionMonitoring Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account_settings")
}

// Fee Group — "Class 1-5", "Hostellers", "Science Stream" etc.
model FeeGroup {
  id          Int     @id @default(autoincrement())
  schoolId    Int
  school      School  @relation(fields: [schoolId], references: [id])
  name        String  @db.VarChar(100)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(1)

  plans     FeePlan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
  @@map("fee_groups")
}

// Fee Plan — the main fee structure for a session + class combination
model FeePlan {
  id                Int           @id @default(autoincrement())
  schoolId          Int
  school            School        @relation(fields: [schoolId], references: [id])
  groupId           Int?
  group             FeeGroup?     @relation(fields: [groupId], references: [id])
  academicYearId    Int
  academicYear      AcademicYear  @relation(fields: [academicYearId], references: [id])
  name              String        @db.VarChar(200)
  description       String?       @db.VarChar(400)
  applicableClasses Int[] // class IDs this plan applies to
  totalAmount       Decimal       @db.Decimal(12, 2)
  status            FeePlanStatus @default(DRAFT)
  effectiveFrom     DateTime?     @db.Date
  clonedFromId      Int? // version history — source plan

  heads        FeePlanHead[]
  installments FeePlanInstallment[]
  studentPlans StudentFeePlan[]

  createdById Int
  createdBy   User     @relation("FeePlanCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, status])
  @@map("fee_plans")
}

// Fee Plan Head — individual fee head in a plan (Tuition, Transport, Lab etc.)
model FeePlanHead {
  id          Int          @id @default(autoincrement())
  planId      Int
  plan        FeePlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  schoolId    Int
  name        String       @db.VarChar(100)
  category    FeeCategory  @default(TUITION)
  amount      Decimal      @db.Decimal(12, 2)
  frequency   FeeFrequency @default(YEARLY)
  isOptional  Boolean      @default(false)
  isMandatory Boolean      @default(true)
  sortOrder   Int          @default(1)
  description String?      @db.VarChar(200)
  School      School       @relation(fields: [schoolId], references: [id])

  @@index([planId])
  @@index([schoolId])
  @@map("fee_plan_heads")
}

// Fee Plan Installment — payment schedule for a plan
model FeePlanInstallment {
  id            Int          @id @default(autoincrement())
  planId        Int
  plan          FeePlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  schoolId      Int
  name          String       @db.VarChar(80) // "Q1 - April", "Term 1", "Installment 1"
  installmentNo Int // 1, 2, 3, 4
  dueDate       DateTime     @db.Date
  amount        Decimal      @db.Decimal(12, 2)
  // Late fine settings
  lateFineMode  LateFineMode @default(NONE)
  lateFineValue Decimal      @default(0) @db.Decimal(10, 2)
  lateFineDays  Int          @default(0) // grace days before fine starts

  studentInstallments StudentFeeInstallment[]
  School              School                  @relation(fields: [schoolId], references: [id])

  @@index([planId])
  @@index([schoolId])
  @@map("fee_plan_installments")
}

// Student Fee Plan — assignment of a fee plan to a student
model StudentFeePlan {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id])
  planId         Int
  plan           FeePlan      @relation(fields: [planId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  totalAmount    Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  fineAmount     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal @db.Decimal(12, 2)

  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  installments StudentFeeInstallment[]
  discounts    FeeDiscount[]

  @@unique([studentId, planId])
  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, academicYearId])
  @@map("student_fee_plans")
}

// Student Fee Installment — per-installment status per student
model StudentFeeInstallment {
  id            Int                @id @default(autoincrement())
  schoolId      Int
  school        School             @relation(fields: [schoolId], references: [id])
  studentPlanId Int
  studentPlan   StudentFeePlan     @relation(fields: [studentPlanId], references: [id], onDelete: Cascade)
  installmentId Int
  installment   FeePlanInstallment @relation(fields: [installmentId], references: [id])
  studentId     Int
  student       Student            @relation(fields: [studentId], references: [id])

  dueAmount      Decimal              @db.Decimal(12, 2)
  paidAmount     Decimal              @default(0) @db.Decimal(12, 2)
  fineAmount     Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount Decimal              @default(0) @db.Decimal(12, 2)
  dueDate        DateTime             @db.Date
  status         FeeInstallmentStatus @default(PENDING)
  paidAt         DateTime?

  @@unique([studentPlanId, installmentId])
  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@index([dueDate, status])
  @@map("student_fee_installments")
}

// Fee Discount — per student discount record
model FeeDiscount {
  id            Int             @id @default(autoincrement())
  schoolId      Int
  school        School          @relation(fields: [schoolId], references: [id])
  studentId     Int
  student       Student         @relation(fields: [studentId], references: [id])
  studentPlanId Int?
  studentPlan   StudentFeePlan? @relation(fields: [studentPlanId], references: [id])

  name            String           @db.VarChar(150)
  discountType    DiscountType     @default(FIXED_AMOUNT)
  category        DiscountCategory @default(CUSTOM)
  value           Decimal          @db.Decimal(10, 2) // % or ₹
  applicableHeads String[] // fee head names — empty = all heads
  academicYearId  Int?
  remarks         String?          @db.VarChar(300)

  approvedById Int?
  approvedBy   User?     @relation("DiscountApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@map("fee_discounts")
}

// Fee Fine — manual or auto fine records
model FeeFine {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  invoiceId Int? // linked invoice if paid via collection
  fineNo    String  @unique @db.VarChar(30)

  reason     String    @db.VarChar(300)
  fineType   FineType  @default(LATE_PAYMENT)
  amount     Decimal   @db.Decimal(10, 2)
  isPaid     Boolean   @default(false)
  paidAt     DateTime?
  waived     Boolean   @default(false)
  waivedById Int?

  createdById Int
  createdBy   User     @relation("FineCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, isPaid])
  @@map("fee_fines")
}

// Fee Refund — refund requests and processing
model FeeRefund {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  refundNo  String  @unique @db.VarChar(30)
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  invoiceId Int // which invoice is being refunded
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount  Decimal      @db.Decimal(12, 2)
  reason  String       @db.VarChar(400)
  status  RefundStatus @default(REQUESTED)
  remarks String?      @db.VarChar(300)

  // Approval
  approvedById   Int?
  approvedBy     User?     @relation("RefundApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?   @db.VarChar(300)

  // Processing
  processedById  Int?
  processedBy    User?          @relation("RefundProcessor", fields: [processedById], references: [id])
  processedAt    DateTime?
  paymentMode    PaymentMethod?
  transactionRef String?        @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("fee_refunds")
}

// Fee Receipt — receipt record linked to Invoice + Payment
model FeeReceipt {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  receiptNo String  @unique @db.VarChar(30)
  invoiceId Int     @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  paymentId Int     @unique
  payment   Payment @relation(fields: [paymentId], references: [id])
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  qrCode String? @db.VarChar(500) // QR verification URL

  // Void/cancel
  isVoid     Boolean   @default(false)
  voidedAt   DateTime?
  voidedById Int?
  voidedBy   User?     @relation("ReceiptVoider", fields: [voidedById], references: [id])
  voidReason String?   @db.VarChar(200)

  printCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([schoolId, createdAt])
  @@map("fee_receipts")
}

model DueNotice {
  id        Int     @id @default(autoincrement())
