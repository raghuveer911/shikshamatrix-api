// ─────────────────────────────────────────
// ACADEMIC YEAR
// ─────────────────────────────────────────

model AcademicYear {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   @db.VarChar(20)
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // ── Session lifecycle (Academic Sessions module) ──────────
  status       SessionStatus @default(DRAFT)
  clonedFromId Int?
  clonedFrom   AcademicYear?  @relation("SessionClone", fields: [clonedFromId], references: [id])
  clonedInto   AcademicYear[] @relation("SessionClone")
  activatedAt  DateTime?
  lockedAt     DateTime?
  archivedAt   DateTime?

  feeStructures         FeeStructure[]
  invoices              Invoice[]
  feePlans              FeePlan[]
  studentFeePlans       StudentFeePlan[]
  sessionFinanceControl SessionFinanceControl?
  carryForwards         CarryForward[]
  carryForwardsTarget   CarryForward[]         @relation("CarryForwardTargetYear")

  // ── Academics reform relations ────────────────────────────
  holidays                Holiday[]
  calendarEvents          CalendarEvent[]
  workingDayConfig        WorkingDayConfig?
  subjectAssignments      SubjectAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  academicPolicy          AcademicPolicy?

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

