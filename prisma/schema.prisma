  subject    String         @db.VarChar(200)
  body       String         @db.Text
  dueAmount  Decimal        @db.Decimal(12, 2)
  dueDate    DateTime?      @db.Date

  status      NoticeStatus @default(DRAFT)
  sentAt      DateTime?
  deliveredAt DateTime?
  failReason  String?      @db.VarChar(200)

  createdById Int
  createdBy   User     @relation("NoticeCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, noticeType])
  @@index([schoolId, status])
  @@map("due_notices")
}

model DueFollowUp {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  invoiceId Int?

  scheduledDate DateTime @db.Date
  scheduledTime String?  @db.VarChar(10)
  assignedToId  Int?
  assignedTo    User?    @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  notes         String?  @db.VarChar(500)
  contactMethod String   @default("PHONE") @db.VarChar(20) // PHONE | WHATSAPP | EMAIL | IN_PERSON

  isDone             Boolean         @default(false)
  doneAt             DateTime?
  result             FollowUpResult?
  resultNotes        String?         @db.VarChar(400)
  expectedPayDate    DateTime?       @db.Date
  expectedAmount     Decimal?        @db.Decimal(12, 2)
  commitmentReceived Boolean         @default(false)

  createdById Int
  createdBy   User     @relation("FollowUpCreator", fields: [createdById], references: [id])
