  // Immutable once applied
  isApplied Boolean          @default(false)
  appliedAt DateTime?

  approvedById   Int?
  approvedBy     User?     @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?   @db.VarChar(300)

  createdById Int
  createdBy   User     @relation("AdjustmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([invoiceId])
  @@index([schoolId, adjustmentType])
  @@map("txn_adjustments")
}

model PaymentReconciliation {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  invoiceId Int     @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  // Gateway side
  gatewayRef       String    @db.VarChar(150)
  gatewayAmount    Decimal   @db.Decimal(12, 2)
  gatewayStatus    String    @db.VarChar(30)
  gatewayTimestamp DateTime?

  // ERP side
  erpAmount Decimal @db.Decimal(12, 2)
  erpStatus String  @db.VarChar(30)

  status         ReconciliationStatus @default(PENDING)
  mismatchReason String?              @db.VarChar(300)
  resolvedById   Int?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([gatewayRef])
  @@map("payment_reconciliations")
}

// Fine Rule — reusable fine templates (global per school)
model FineRule {
  id              Int               @id @default(autoincrement())
  schoolId        Int
  school          School            @relation(fields: [schoolId], references: [id])
  name            String            @db.VarChar(150) // "Standard Late Fee"
  description     String?           @db.VarChar(400)
  gracePeriodDays Int               @default(0) // days before fine starts
  frequency       FineRuleFrequency @default(FIXED)
  amount          Decimal           @db.Decimal(10, 2) // ₹ amount or %
  maxAmount       Decimal?          @db.Decimal(10, 2) // cap for DAILY fines
  applicableTypes String[] // which invoice types
  isActive        Boolean           @default(true)
  isDefault       Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("fine_rules")
}

// Finance Control — per-school global settings (one row per school)
model FinanceControl {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // Payment settings
  allowPartialPayment      Boolean @default(true)
  allowOverPayment         Boolean @default(false)
  minPartialPaymentPercent Int     @default(0) // minimum % for partial payment

  // Auto-features
  autoFineEnabled       Boolean @default(false)
  autoReceiptGeneration Boolean @default(true)
  autoDueReminder       Boolean @default(false)
  duReminderDaysBefore  Int     @default(3)

  // Receipt settings
  receiptPrefix   String  @default("RCP") @db.VarChar(10)
  invoicePrefix   String  @default("INV") @db.VarChar(10)
  showSchoolLogo  Boolean @default(true)
  showQrOnReceipt Boolean @default(true)

  // Approval thresholds
  discountApprovalRequired Boolean @default(true)
  discountApprovalAbove    Decimal @default(5000) @db.Decimal(10, 2)
  refundApprovalRequired   Boolean @default(true)
  waiverApprovalLevels     Int     @default(3) // 1 = accountant, 2 = + principal, 3 = + mgmt

  // Session settings
  financialYearStartMonth Int     @default(4) // April = 4
  lockTransactionsOnClose Boolean @default(true)
  allowBackdatedEntry     Boolean @default(false)
  backdatedDaysAllowed    Int     @default(0)

  allowAdvancePayment     Boolean  @default(false)
  autoSmsEnabled          Boolean  @default(false)
  autoWhatsappEnabled     Boolean  @default(false)
  autoEmailEnabled        Boolean  @default(false)
  defaultCurrency         String   @default("INR") @db.VarChar(5)
  dateFormat              String   @default("DD/MM/YYYY") @db.VarChar(20)
  feeCodePrefix           String   @default("FEE") @db.VarChar(10)
  paymentLinkExpiry       Int      @default(15) // minutes
  activeGatewayId         Int? // FK to PaymentGateway
  autoCarryForward        Boolean  @default(false)
  notifyOnFeeCreation     Boolean  @default(true)
  notifyOnPayment         Boolean  @default(true)
  notifyOnRefund          Boolean  @default(true)
  notifyOnScholarship     Boolean  @default(false)
  logRetentionYears       Int      @default(7)
  sensitiveActionTracking Boolean  @default(true)
  allowFeeEdit            Boolean  @default(false)
  allowReceiptCancel      Boolean  @default(false)
  refundPermissionRoles   String[] // which roles can initiate refund

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_controls")
}

// Session Finance Control — per academic year open/close/lock
model SessionFinanceControl {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId Int          @unique
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  status   SessionStatus @default(OPEN)
  openedAt DateTime?
  lockedAt DateTime?
  closedAt DateTime?

  lockedById Int?
  lockedBy   User?   @relation("SessionLocker", fields: [lockedById], references: [id])
  closedById Int?
  notes      String? @db.VarChar(400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("session_finance_controls")
}

// Carry Forward — dues carried to new session
model CarryForward {
  id                 Int          @id @default(autoincrement())
  schoolId           Int
  school             School       @relation(fields: [schoolId], references: [id])
  studentId          Int
  student            Student      @relation(fields: [studentId], references: [id])
  fromAcademicYearId Int
  fromAcademicYear   AcademicYear @relation(fields: [fromAcademicYearId], references: [id])
  toAcademicYearId   Int
  toAcademicYear     AcademicYear @relation("CarryForwardTargetYear", fields: [toAcademicYearId], references: [id])

  originalInvoiceId Int? // source invoice
  dueAmount         Decimal            @db.Decimal(12, 2)
  carriedAmount     Decimal            @db.Decimal(12, 2)
  reason            String?            @db.VarChar(400)
  status            CarryForwardStatus @default(PENDING)
  newInvoiceId      Int? // invoice created in new session

  appliedAt      DateTime?
  reversedAt     DateTime?
  reversedReason String?   @db.VarChar(300)

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("carry_forwards")
}

// Bulk Operation Log — track bulk actions
model BulkOperationLog {
  id            Int               @id @default(autoincrement())
  schoolId      Int
  school        School            @relation(fields: [schoolId], references: [id])
  operationType BulkOperationType
  description   String            @db.VarChar(400)
  parameters    Json? // filter params used
  targetCount   Int               @default(0) // how many records targeted
  successCount  Int               @default(0)
  failedCount   Int               @default(0)
  status        String            @default("PENDING") @db.VarChar(20) // PENDING | RUNNING | DONE | FAILED
  errors        String?           @db.Text // JSON array of errors
  completedAt   DateTime?

  executedById Int
  executedBy   User     @relation("BulkOpExecutor", fields: [executedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, operationType])
  @@map("bulk_operation_logs")
}

model FinanceAuditLog {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // Actor
  userId    Int?
  user      User?   @relation("AuditLogUser", fields: [userId], references: [id])
  userRole  String? @db.VarChar(50)
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(300)

  // Context
  module      FinanceAuditModule
  action      FinanceAuditAction
  entityType  String             @db.VarChar(50) // "Invoice", "FeeDiscount", etc.
  entityId    Int?
  studentId   Int?
  studentName String?            @db.VarChar(200) // denormalized for history

  // Change tracking
  description String   @db.VarChar(500)
  beforeValue Json? // state before change
  afterValue  Json? // state after change
  amount      Decimal? @db.Decimal(12, 2)
  receiptNo   String?  @db.VarChar(50)

  // Risk
  isSuspicious Boolean @default(false)
  riskScore    Int     @default(0) // 0-100
  riskReason   String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, userId])
  @@index([schoolId, module])
  @@index([schoolId, action])
  @@index([schoolId, isSuspicious])
  @@index([studentId])
  @@index([createdAt])
  @@map("finance_audit_logs")
}

// ── ONLINE PAYMENTS ──────────────────────────────────────────

model PaymentGateway {
  id          Int             @id @default(autoincrement())
  schoolId    Int
  school      School          @relation(fields: [schoolId], references: [id])
  name        String          @db.VarChar(100) // "Razorpay Production"
  provider    GatewayProvider @default(RAZORPAY)
  status      GatewayStatus   @default(SANDBOX)
  isDefault   Boolean         @default(false)
  displayName String?         @db.VarChar(80)
  isActive    Boolean         @default(false)
  webhookUrl  String?         @db.VarChar(400)
  lastTested  DateTime?
  testStatus  String?         @db.VarChar(20)

  // Credentials (stored encrypted in production)
  apiKey        String? @db.VarChar(500)
  apiSecret     String? @db.VarChar(500)
  webhookSecret String? @db.VarChar(500)
  merchantId    String? @db.VarChar(200)
  extraConfig   Json?

  // Stats
  successCount Int     @default(0)
  failureCount Int     @default(0)
  totalVolume  Decimal @default(0) @db.Decimal(16, 2)

  onlinePayments OnlinePayment[]
  settlements    GatewaySettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, provider, status])
  @@index([schoolId])
  @@map("payment_gateways")
}

model OnlinePayment {
  id            Int             @id @default(autoincrement())
  schoolId      Int
  school        School          @relation(fields: [schoolId], references: [id])
  studentId     Int
  student       Student         @relation(fields: [studentId], references: [id])
  invoiceId     Int?
  paymentId     Int? // links to Payment once successful
  gatewayId     Int?
  gateway       PaymentGateway? @relation(fields: [gatewayId], references: [id])
  paymentLinkId Int?
  paymentLink   PaymentLink?    @relation(fields: [paymentLinkId], references: [id])

  // Transaction identifiers
  gatewayOrderId   String? @db.VarChar(200)
  gatewayPaymentId String? @db.VarChar(200)
  gatewaySignature String? @db.VarChar(500)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(5)
  mode     String  @default("UPI") @db.VarChar(30) // UPI | CARD | NB | WALLET

  status        OnlinePaymentStatus @default(INITIATED)
  failureReason String?             @db.VarChar(300)
  attempts      Int                 @default(1)

  initiatedAt    DateTime  @default(now())
  completedAt    DateTime?
  refundedAt     DateTime?
  refundedAmount Decimal?  @db.Decimal(12, 2)

  // Reconciliation
  isReconciled Boolean   @default(false)
  reconciledAt DateTime?

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("online_payments")
}

model PaymentLink {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  invoiceId Int?

  linkCode    String  @unique @db.VarChar(50) // unique token
  shortUrl    String? @db.VarChar(500)
  amount      Decimal @db.Decimal(12, 2)
