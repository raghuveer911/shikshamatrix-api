model InvSettings {
  id                     Int      @id @default(autoincrement())
  schoolId               Int      @unique
  school                 School   @relation(fields: [schoolId], references: [id])
  // General
  itemCodePrefix         String   @default("INV") @db.VarChar(20)
  vendorCodePrefix       String   @default("VEN") @db.VarChar(20)
  requestCodePrefix      String   @default("PR") @db.VarChar(20)
  maintenanceCodePrefix  String   @default("MNT") @db.VarChar(20)
  auditCodePrefix        String   @default("AUD") @db.VarChar(20)
  // Purchase Rules
  requireApproval        Boolean  @default(true)
  approvalLevels         Int      @default(3) // 1=Dept Head, 2=+Principal, 3=+Accounts
  purchaseOrderRequired  Boolean  @default(true)
  // Stock Rules
  defaultMinimumStock    Int      @default(5)
  defaultReorderLevel    Int      @default(10)
  autoLowStockAlert      Boolean  @default(true)
  // Assignment Rules
  requireReturnDate      Boolean  @default(false)
  allowSelfAssignment    Boolean  @default(false)
  maxAssignmentsPerStaff Int      @default(5)
  // Maintenance
  warrantyAlertDays      Int      @default(30)
  amcRenewalAlertDays    Int      @default(30)
  // Audit
  auditFrequencyMonths   Int      @default(6)
  requireAuditApproval   Boolean  @default(true)
  // Permissions (JSON: {role: [actions]})
  rolePermissions        Json     @default("{}")
  // Notification (reuse Communication Engine)
  notifyLowStock         Boolean  @default(true)
  notifyWarrantyExpiry   Boolean  @default(true)
  notifyAmcRenewal       Boolean  @default(true)
  notifyPurchaseApproval Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("inv_settings")
}

model Hostel {
  id           Int          @id @default(autoincrement())
  schoolId     Int
  school       School       @relation(fields: [schoolId], references: [id])
  hostelCode   String       @db.VarChar(30)
  name         String       @db.VarChar(150)
  hostelType   HostelType   @default(BOYS)
  status       HostelStatus @default(ACTIVE)
  // Contact
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(150)
  address      String?      @db.Text
  city         String?      @db.VarChar(80)
  state        String?      @db.VarChar(80)
  // Warden (from HR Staff)
  wardenId     Int?
  warden       Staff?       @relation("HostelWarden", fields: [wardenId], references: [id])
  // Facilities (array of strings)
  facilities   String[] // WiFi, Mess, Laundry, Study Room, CCTV, Water Cooler
  // Capacity (denormalised for speed)
  totalRooms   Int          @default(0)
  totalBeds    Int          @default(0)
  occupiedBeds Int          @default(0)
  description  String?      @db.VarChar(400)
  imageUrl     String?      @db.VarChar(600)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  floors      HostelFloor[]
  rooms       HostelRoom[]
  allocations HostelAllocation[]

  @@unique([schoolId, hostelCode])
  @@index([schoolId])
  @@index([schoolId, hostelType])
  @@map("hostels")
}

model HostelFloor {
  id        Int    @id @default(autoincrement())
  hostelId  Int
  hostel    Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floorNo   Int
  floorName String @db.VarChar(60) // Ground Floor, 1st Floor, 2nd Floor…

  rooms HostelRoom[]

  @@unique([hostelId, floorNo])
  @@index([hostelId])
  @@map("hostel_floors")
}

// ── Room Type (shared across all hostels) ────────────────────

model RoomType {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  name        String   @db.VarChar(100) // Single, Double Sharing, Triple, Dormitory
  capacity    Int // max beds per room
  amenities   String[] // AC, Non-AC, Attached Bathroom, Balcony, Study Table
  monthlyFee  Decimal? @db.Decimal(10, 2)
  annualFee   Decimal? @db.Decimal(10, 2)
  description String?  @db.VarChar(300)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms HostelRoom[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("room_types")
}

// ── Hostel Room ───────────────────────────────────────────────

model HostelRoom {
  id              Int              @id @default(autoincrement())
  hostelId        Int
  hostel          Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floorId         Int?
  floor           HostelFloor?     @relation(fields: [floorId], references: [id])
  roomTypeId      Int?
  roomType        RoomType?        @relation(fields: [roomTypeId], references: [id])
  roomNumber      String           @db.VarChar(20) // 101, 102, G-01 …
  capacity        Int              @default(1) // copied from RoomType; overrideable
  occupiedCount   Int              @default(0)
  status          HostelRoomStatus @default(AVAILABLE)
  maintenanceNote String?          @db.VarChar(200)
  floor_label     String?          @db.VarChar(40) // "Ground", "1st", "2nd"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  beds        HostelBed[]
  allocations HostelAllocation[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
  @@index([hostelId, status])
  @@map("hostel_rooms")
}

// ── Bed ───────────────────────────────────────────────────────

model HostelBed {
  id        Int             @id @default(autoincrement())
  roomId    Int
  room      HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedCode   String          @db.VarChar(10) // A, B, C, D / 1, 2, 3
  status    HostelBedStatus @default(AVAILABLE)
  notes     String?         @db.VarChar(150)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  allocations HostelAllocation[]

  @@unique([roomId, bedCode])
  @@index([roomId])
  @@map("hostel_beds")
}

// ── Student Allocation ────────────────────────────────────────

model HostelAllocation {
  id                   Int                    @id @default(autoincrement())
  schoolId             Int
  school               School                 @relation(fields: [schoolId], references: [id])
  studentId            Int
  student              Student                @relation(fields: [studentId], references: [id])
  hostelId             Int
  hostel               Hostel                 @relation(fields: [hostelId], references: [id])
  roomId               Int
  room                 HostelRoom             @relation(fields: [roomId], references: [id])
  bedId                Int
  bed                  HostelBed              @relation(fields: [bedId], references: [id])
  status               HostelAllocationStatus @default(ACTIVE)
  allocationDate       DateTime               @db.Date
  vacateDate           DateTime?              @db.Date
  vacateReason         HostelVacateReason?
  vacateNote           String?                @db.VarChar(200)
  // Transfer tracking
  previousAllocationId Int?
  academicYear         String                 @db.VarChar(20) // "2025-26"
  remarks              String?                @db.VarChar(200)
  allocatedById        Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([hostelId])
  @@index([roomId])
  @@index([bedId])
  @@index([schoolId, status])
  @@index([schoolId, academicYear])
  @@map("hostel_allocations")
}

model HelpCategory {
  id           Int                    @id @default(autoincrement())
  schoolId     Int
  school       School                 @relation(fields: [schoolId], references: [id])
  name         String                 @db.VarChar(120)
  slug         String                 @db.VarChar(130)
  icon         String                 @default("HelpCircle") @db.VarChar(50) // Lucide icon name
  description  String?                @db.VarChar(300)
  color        String                 @default("#6366f1") @db.VarChar(20)
  visibility   HelpCategoryVisibility @default(EVERYONE)
  parentId     Int? // null = top-level; set = sub-category
  parent       HelpCategory?          @relation("SubCategories", fields: [parentId], references: [id])
  children     HelpCategory[]         @relation("SubCategories")
  sortOrder    Int                    @default(0)
  isActive     Boolean                @default(true)
  // Analytics (denormalised)
  articleCount Int                    @default(0)
  viewCount    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  articles HelpArticle[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@index([schoolId, parentId])
  @@map("help_categories")
}

// ─────────────────────────────────────────────────────────────
// ARTICLE (Knowledge Base)
// ─────────────────────────────────────────────────────────────

model HelpArticle {
  id              Int                     @id @default(autoincrement())
  schoolId        Int
  school          School                  @relation(fields: [schoolId], references: [id])
  categoryId      Int?
  category        HelpCategory?           @relation(fields: [categoryId], references: [id])
  title           String                  @db.VarChar(300)
  slug            String                  @db.VarChar(320)
  content         String                  @db.Text // Rich text / Markdown
  excerpt         String?                 @db.VarChar(400) // Auto-generated summary
  tags            String[]
  status          HelpArticleStatus       @default(DRAFT)
  isFeatured      Boolean                 @default(false)
  // SEO / search
  searchVector    String?                 @db.Text // concatenated for full-text search
  // Visibility (inherit from category if null)
  visibility      HelpCategoryVisibility?
  // Metrics (denormalised)
  viewCount       Int                     @default(0)
  helpfulCount    Int                     @default(0)
  notHelpfulCount Int                     @default(0)
  // Authoring
  authorId        Int?
  author          User?                   @relation("ArticleAuthor", fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  feedback  HelpArticleFeedback[]
  revisions HelpArticleRevision[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@index([schoolId, categoryId])
  @@index([schoolId, status])
  @@index([schoolId, isFeatured])
  @@map("help_articles")
}

model HelpArticleFeedback {
  id        Int         @id @default(autoincrement())
  articleId Int
  article   HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  helpful   Boolean // true = 👍, false = 👎
  comment   String?     @db.VarChar(400)
  createdAt DateTime    @default(now())

  @@index([articleId])
  @@map("help_article_feedback")
}

model HelpArticleRevision {
  id          Int         @id @default(autoincrement())
  articleId   Int
  article     HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  title       String      @db.VarChar(300)
  content     String      @db.Text
  changedById Int?
  changeNote  String?     @db.VarChar(200)
  createdAt   DateTime    @default(now())

  @@index([articleId])
  @@map("help_article_revisions")
}

// ─────────────────────────────────────────────────────────────
// AI CHATBOT
// ─────────────────────────────────────────────────────────────

model HelpChatSession {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  userRole  String   @default("ADMIN") @db.VarChar(30) // ADMIN, TEACHER, STAFF, PARENT, STUDENT
  title     String?  @db.VarChar(200) // auto-set from first message
  // Ratings / feedback
  rating    Int? // 1-5
  feedback  String?  @db.VarChar(300)
  escalated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages HelpChatMessage[]

  @@index([schoolId])
  @@index([userId])
  @@map("help_chat_sessions")
}

model HelpChatMessage {
  id               Int             @id @default(autoincrement())
  sessionId        Int
  session          HelpChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             String          @db.VarChar(20) // "user" | "assistant"
  content          String          @db.Text
  // Source tracing
  sourceArticleIds Int[] // which KB articles were referenced
  helpful          Boolean? // user thumbs up/down on AI response
  createdAt        DateTime        @default(now())

  @@index([sessionId])
  @@map("help_chat_messages")
}

model TransportVehicle {
  id            Int           @id @default(autoincrement())
  schoolId      Int
  school        School        @relation(fields: [schoolId], references: [id])
  vehicleNo     String        @db.VarChar(30) // MH-12-AB-1234
  vehicleName   String?       @db.VarChar(100) // Bus-1, Van-A
  vehicleType   VehicleType   @default(SCHOOL_BUS)
  brand         String?       @db.VarChar(80)
  model         String?       @db.VarChar(80)
  year          Int?
  color         String?       @db.VarChar(40)
  // Capacity
  totalSeats    Int           @default(40)
  reservedSeats Int           @default(0)
  occupiedSeats Int           @default(0) // denormalised — updated on allocation
  // Assignment
  driverId      Int?
  driver        Staff?        @relation("VehicleDriver", fields: [driverId], references: [id])
  conductorId   Int?
  conductor     Staff?        @relation("VehicleConductor", fields: [conductorId], references: [id])
  // Status
  status        VehicleStatus @default(ACTIVE)
  isActive      Boolean       @default(true)
  // GPS device info
  gpsDeviceId   String?       @db.VarChar(60)
  lastLatitude  Float?
  lastLongitude Float?
  lastSeen      DateTime?
  lastSpeed     Float? // km/h
  // Notes
  notes         String?       @db.VarChar(400)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  documents TransportVehicleDoc[]
  routes    TransportRoute[]
  trips     TransportTrip[]
  tracking  TransportTracking[]

  @@unique([schoolId, vehicleNo])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("transport_vehicles")
}

model TransportVehicleDoc {
  id         Int              @id @default(autoincrement())
  vehicleId  Int
  vehicle    TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType    VehicleDocType
  docNumber  String?          @db.VarChar(80)
  issueDate  DateTime?        @db.Date
  expiryDate DateTime?        @db.Date
  fileUrl    String?          @db.VarChar(600)
  notes      String?          @db.VarChar(200)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([vehicleId])
  @@index([vehicleId, docType])
  @@map("transport_vehicle_docs")
}

// ── Route ────────────────────────────────────────────────────

model TransportRoute {
  id                Int               @id @default(autoincrement())
  schoolId          Int
  school            School            @relation(fields: [schoolId], references: [id])
  routeName         String            @db.VarChar(150)
  routeCode         String            @db.VarChar(30) // Route-A, RT-01
  description       String?           @db.VarChar(300)
  status            RouteStatus       @default(ACTIVE)
  // Assigned vehicle
  vehicleId         Int?
  vehicle           TransportVehicle? @relation(fields: [vehicleId], references: [id])
  // Capacity (denormalised from vehicle)
  totalSeats        Int               @default(0)
  occupiedSeats     Int               @default(0)
  // Timing
  morningStart      String?           @db.VarChar(10) // 07:30
  eveningStart      String?           @db.VarChar(10) // 15:45
  estimatedDuration Int? // minutes
  // Area
  coverageArea      String?           @db.VarChar(200)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  stops TransportStop[]
  trips TransportTrip[]

  @@unique([schoolId, routeCode])
  @@index([schoolId])
  @@index([schoolId, vehicleId])
  @@map("transport_routes")
}

model TransportStop {
  id           Int            @id @default(autoincrement())
  routeId      Int
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName     String         @db.VarChar(150)
  landmark     String?        @db.VarChar(200)
  sequence     Int // 1, 2, 3 … — drag-drop order
  latitude     Float?
  longitude    Float?
  pickupTime   String?        @db.VarChar(10) // "07:20"
  dropTime     String?        @db.VarChar(10) // "14:30"
  studentCount Int            @default(0) // denormalised
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([routeId])
  @@index([routeId, sequence])
  @@map("transport_stops")
}

// ── Trip & Tracking ──────────────────────────────────────────

model TransportTrip {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  school         School           @relation(fields: [schoolId], references: [id])
  vehicleId      Int
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id])
  routeId        Int?
  route          TransportRoute?  @relation(fields: [routeId], references: [id])
  driverId       Int?
  driver         Staff?           @relation(fields: [driverId], references: [id])
  tripDate       DateTime         @db.Date
  tripType       String           @default("MORNING") @db.VarChar(20) // MORNING, EVENING, SPECIAL
  status         TripStatus       @default(SCHEDULED)
  scheduledStart DateTime?
  actualStart    DateTime?
  scheduledEnd   DateTime?
  actualEnd      DateTime?
  startLatitude  Float?
  startLongitude Float?
  endLatitude    Float?
  endLongitude   Float?
  totalDistance  Float? // km
  stopsCompleted Int              @default(0)
  notes          String?          @db.VarChar(200)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tracking TransportTracking[]

  @@index([schoolId])
  @@index([vehicleId])
  @@index([schoolId, tripDate])
  @@map("transport_trips")
}

model TransportTracking {
  id        Int              @id @default(autoincrement())
  vehicleId Int
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId    Int?
  trip      TransportTrip?   @relation(fields: [tripId], references: [id])
  latitude  Float
  longitude Float
  speed     Float? // km/h
  heading   Float? // degrees
  accuracy  Float? // meters
  timestamp DateTime         @default(now())
  source    String           @default("GPS") @db.VarChar(20) // GPS, MOBILE, MANUAL

  @@index([vehicleId])
  @@index([vehicleId, timestamp])
  @@index([tripId])
  @@map("transport_tracking")
}

model SchoolSettings {
  id              Int      @id @default(autoincrement())
  schoolId        Int      @unique
  school          School   @relation(fields: [schoolId], references: [id])
  affiliationNo   String?  @db.VarChar(80)
  udiseCode       String?  @db.VarChar(30)
  registrationNo  String?  @db.VarChar(80)
  logoUrl         String?  @db.VarChar(600)
  faviconUrl      String?  @db.VarChar(600)
  watermarkUrl    String?  @db.VarChar(600)
  themeColor      String   @default("#6366f1") @db.VarChar(20)
  address         String?  @db.Text
  state           String?  @db.VarChar(80)
  district        String?  @db.VarChar(80)
  city            String?  @db.VarChar(80)
  pincode         String?  @db.VarChar(10)
  country         String   @default("India") @db.VarChar(60)
  contactEmail    String?  @db.VarChar(150)
  contactPhone    String?  @db.VarChar(20)
  website         String?  @db.VarChar(200)
  defaultCurrency String   @default("INR") @db.VarChar(10)
  language        String   @default("ENGLISH") @db.VarChar(20)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(60)
  dateFormat      String   @default("DD/MM/YYYY") @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("school_settings")
}

// Tracks each change to a rate-limited profile field (school name, owner
// name/phone/email) so we can enforce "N changes per rolling window"
// without needing a separate counter-reset job — the window is always
// computed live against `changedAt` timestamps.
model ProfileFieldChangeLog {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  fieldName String   @db.VarChar(40) // e.g. "schoolName", "adminName", "adminPhone", "adminEmail"
  oldValue  String?  @db.VarChar(300)
  newValue  String?  @db.VarChar(300)
  changedAt DateTime @default(now())

  @@index([schoolId, fieldName, changedAt])
  @@map("profile_field_change_log")
}

// ─── BACKUP ───────────────────────────────────────────────────
model BackupLog {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  backupType  String    @db.VarChar(20)
  trigger     String    @default("MANUAL") @db.VarChar(20)
  status      String    @default("PENDING") @db.VarChar(20)
  sizeBytes   BigInt?
  fileUrl     String?   @db.VarChar(600)
  notes       String?   @db.VarChar(300)
  initiatedBy Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
  @@map("backup_logs")
}

model BackupSchedule {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @unique
  school     School    @relation(fields: [schoolId], references: [id])
  frequency  String    @default("DAILY") @db.VarChar(20)
  backupType String    @default("DATABASE") @db.VarChar(20)
  runAt      String    @default("02:00") @db.VarChar(10)
  isEnabled  Boolean   @default(true)
  lastRun    DateTime?
  nextRun    DateTime?
  updatedAt  DateTime  @updatedAt

  @@map("backup_schedules")
}

model CustomField {
  id          Int             @id @default(autoincrement())
  schoolId    Int
  school      School          @relation(fields: [schoolId], references: [id])
  module      String          @db.VarChar(50)
  fieldName   String          @db.VarChar(80)
  fieldKey    String          @db.VarChar(80)
  fieldType   CustomFieldType @default(TEXT)
  options     String[]
  isRequired  Boolean         @default(false)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  placeholder String?         @db.VarChar(200)
  helpText    String?         @db.VarChar(300)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  values CustomFieldValue[]

  @@unique([schoolId, module, fieldKey])
  @@index([schoolId])
  @@index([schoolId, module])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  recordId      Int
  value         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, recordId])
  @@index([customFieldId])
  @@index([recordId])
  @@map("custom_field_values")
}

// ─── ROLES & PERMISSIONS ─────────────────────────────────────
model Role {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  name        String   @db.VarChar(80)
  slug        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  color       String   @default("#6366f1") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments RoleAssignment[] // ← renamed from userRoles

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("roles")
}

model RolePermission {
  id      Int      @id @default(autoincrement())
  roleId  Int
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String   @db.VarChar(60)
  actions String[]

  @@unique([roleId, module])
  @@index([roleId])
  @@map("role_permissions")
}

// ✅ RENAMED from UserRole → RoleAssignment (avoids conflict with UserRole enum)
model RoleAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  schoolId   Int
  assignedAt DateTime @default(now())

  @@unique([userId, roleId, schoolId])
  @@index([userId])
  @@index([roleId])
  @@map("role_assignments") // ← different table name too
}

// ─── NOTIFICATION SETTINGS ────────────────────────────────────
model NotifSettings {
  id              Int      @id @default(autoincrement())
  schoolId        Int      @unique
  school          School   @relation(fields: [schoolId], references: [id])
  smsEnabled      Boolean  @default(false)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  pushEnabled     Boolean  @default(false)
  smsSenderId     String?  @db.VarChar(20)
  smsProvider     String?  @db.VarChar(30)
  smsApiKey       String?  @db.VarChar(300)
  emailFromName   String?  @db.VarChar(100)
  emailFromAddr   String?  @db.VarChar(150)
  emailProvider   String?  @db.VarChar(30)
  emailHost       String?  @db.VarChar(150)
  emailPort       Int?
  emailUser       String?  @db.VarChar(150)
  emailPass       String?  @db.VarChar(300)
  waApiKey        String?  @db.VarChar(300)
  waPhoneId       String?  @db.VarChar(80)
  quietStart      String?  @db.VarChar(10)
  quietEnd        String?  @db.VarChar(10)
  policies        Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@map("notif_settings")
}

// ─── ADMISSION SETTINGS ───────────────────────────────────────
model AdmissionSettings {
  id                   Int      @id @default(autoincrement())
  schoolId             Int      @unique
  school               School   @relation(fields: [schoolId], references: [id])
  admissionNoFormat    String   @default("ADM-{SESSION}-{NUMBER}") @db.VarChar(80)
  rollNoFormat         String   @default("{CLASS}-{NUMBER}") @db.VarChar(80)
  defaultStatus        String   @default("ACTIVE") @db.VarChar(20)
  workflowSteps        String[] @default(["ENQUIRY", "REGISTRATION", "ADMISSION"])
  mandatoryDocs        String[] @default(["BIRTH_CERTIFICATE", "TRANSFER_CERTIFICATE", "PASSPORT_PHOTO"])
  autoApprove          Boolean  @default(false)
  requireApproval      Boolean  @default(true)
  allowOnlineAdmission Boolean  @default(false)
  sequenceStart        Int      @default(1)
  updatedAt            DateTime @updatedAt

  @@map("admission_settings")
}

// ─── SUBSCRIPTION ─────────────────────────────────────────────
model SubscriptionPlan {
  id              Int              @id @default(autoincrement())
  tier            SubscriptionTier @unique
  name            String
  maxStudents     Int              // 0 = unlimited (Enterprise)
  minStudents     Int              @default(0) // billing floor, not an enrollment block
  maxStaff        Int
  storageGB       Int
  monthlyPrice    Decimal          @db.Decimal(10, 2)
  perStudentPrice Decimal?         @db.Decimal(10, 2)
  capabilities    Json
  smsCredits      Int
  whatsappCredits Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  schoolSubscriptions SchoolSubscription[]
}

model SchoolSubscription {
  id                Int                 @id @default(autoincrement())
  schoolId          Int                 @unique
  school            School              @relation(fields: [schoolId], references: [id])
  planId            Int
  plan              SubscriptionPlan    @relation(fields: [planId], references: [id])
  status            SubscriptionStatus  @default(ACTIVE)
  source            SubscriptionSource  @default(SELF_PURCHASED)

  // Trial tracking
  isTrial           Boolean             @default(false)
  trialEndsAt       DateTime?

  // Admin-assigned tracking (audit — who granted it and why)
  assignedByAdminId Int?
  assignmentNote    String?             // e.g. "Pilot partnership Q3 2026"

  billingCycleStart DateTime
  billingCycleEnd   DateTime
  billingCycleType  BillingCycleType    @default(MONTHLY)
  autoRenew         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  creditWallet      CreditWallet?
  auditLogs         SubscriptionAuditLog[]
  history           SubscriptionHistory[]

  @@index([schoolId])
  @@index([status, billingCycleEnd])
}
model TrialHistory {
  id          Int      @id @default(autoincrement())
  schoolId    Int      @unique
  school      School   @relation(fields: [schoolId], references: [id])
  usedAt      DateTime @default(now())
  trialTier   SubscriptionTier @default(PROFESSIONAL)
}
model CreditWallet {
  id                   Int      @id @default(autoincrement())
  schoolSubscriptionId Int      @unique
  schoolSubscription   SchoolSubscription @relation(fields: [schoolSubscriptionId], references: [id])
  smsBalance           Int      @default(0)
  whatsappBalance      Int      @default(0)
  lastResetAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transactions         CreditTransaction[]
}
model CreditTransaction {
  id        Int        @id @default(autoincrement())
  walletId  Int
  wallet    CreditWallet @relation(fields: [walletId], references: [id])
  type      CreditType
  amount    Int
  reason    String
  createdAt DateTime   @default(now())

  @@index([walletId, createdAt])
}
model SubscriptionAuditLog {
  id                   Int      @id @default(autoincrement())
  schoolSubscriptionId Int
  schoolSubscription   SchoolSubscription @relation(fields: [schoolSubscriptionId], references: [id])
  action               String   // "TRIAL_STARTED" | "PLAN_PURCHASED" | "ADMIN_ASSIGNED" | "UPGRADED" | "DOWNGRADED" | "CANCELLED"
  fromValue            String?
  toValue              String?
  actorUserId          Int?     // null if system/cron-triggered
  createdAt            DateTime @default(now())
}
model SubscriptionHistory {
  id             Int                @id @default(autoincrement())
  subscriptionId Int
  subscription   SchoolSubscription @relation(fields: [subscriptionId], references: [id])
  schoolId       Int
  event          String             @db.VarChar(50)
  description    String?            @db.VarChar(300)
  amount         Decimal?           @db.Decimal(10, 2)
  invoiceUrl     String?            @db.VarChar(600)
  paymentId      String?            @db.VarChar(100)
  createdAt      DateTime           @default(now())

  commissionTransaction CommissionTransaction?

  @@index([subscriptionId])
  @@index([schoolId])
  @@map("subscription_history")
}

// ─── DISCOUNT CODES ───────────────────────────────────────────
enum SubscriptionDiscountType {
  PERCENTAGE
  FLAT
}

enum DiscountScope {
  GLOBAL           // any school can use it
  SCHOOL_SPECIFIC  // only the one targeted school can use it
}

enum DiscountApplyTo {
  FIRST_CYCLE // discount applies once, to the first billing cycle only
  LIFETIME    // discount applies to every recurring cycle
}

model DiscountCode {
  id                      Int               @id @default(autoincrement())
  code                    String            @unique @db.VarChar(40)
  type                    SubscriptionDiscountType
  value                   Decimal           @db.Decimal(10, 2) // percent (0-100) or flat ₹ amount, per `type`
  scope                   DiscountScope     @default(GLOBAL)
  targetSchoolId          Int?              // required when scope = SCHOOL_SPECIFIC
  targetSchool            School?           @relation("DiscountTargetSchool", fields: [targetSchoolId], references: [id])
  minTier                 SubscriptionTier? // optional — code only valid on this tier or above
  maxRedemptions          Int?              // total uses across all schools; null = unlimited
  maxRedemptionsPerSchool Int               @default(1) // how many times ONE school may use this code
  redemptionCount         Int               @default(0) // denormalized running total for fast checks
  applyTo                 DiscountApplyTo   @default(FIRST_CYCLE)
  validFrom               DateTime          @default(now())
  validTo                 DateTime?         // null = no expiry
  isActive                Boolean           @default(true) // manual kill-switch, independent of dates/limits
  note                    String?           @db.VarChar(300) // internal note, e.g. "Independence Day campaign"
  createdByAdminId        Int?
  createdAt               DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  redemptions             DiscountRedemption[]

  @@index([code])
  @@index([scope, isActive])
}

model DiscountRedemption {
  id               Int          @id @default(autoincrement())
  discountCodeId   Int
  discountCode     DiscountCode @relation(fields: [discountCodeId], references: [id])
  schoolId         Int
  school           School       @relation(fields: [schoolId], references: [id])
  amountDiscounted Decimal?     @db.Decimal(10, 2)
  razorpayOrderId  String?      @db.VarChar(100) // links to the actual payment, once gateway is live
  redeemedAt       DateTime     @default(now())

  @@index([discountCodeId])
  @@index([schoolId])
}

// ─── PAYMENT GATEWAY (Razorpay) ────────────────────────────────
// Guards against a webhook being processed twice (Razorpay retries on
// timeout/non-200, so the same event.id can arrive more than once).
model ProcessedWebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @db.VarChar(100) // Razorpay's x-razorpay-event-id / payload event id
  eventType   String   @db.VarChar(50)
  processedAt DateTime @default(now())
}

// A checkout the school started but hasn't necessarily finished paying —
// created when the Razorpay order is generated, confirmed/updated when
// the webhook reports payment.captured. Lets the webhook know which
// school/tier/discount an incoming payment belongs to (Razorpay orders
// carry only an id + notes, not our internal relations).
enum BillingCycleType {
  MONTHLY
  ANNUAL
  ACADEMIC_SESSION // billed till the school's current academic year ends
}

model PendingCheckout {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  school           School           @relation(fields: [schoolId], references: [id])
  razorpayOrderId  String           @unique @db.VarChar(100)
  tier             SubscriptionTier
  billingCycleType BillingCycleType @default(MONTHLY)
  amount           Decimal          @db.Decimal(10, 2)
  discountCodeId   Int?
  status           String           @default("PENDING") @db.VarChar(20) // PENDING | PAID | FAILED | EXPIRED
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([schoolId])
  @@index([status])
}

// ─── MODULE MANAGEMENT ────────────────────────────────────────
model ModuleConfig {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  moduleKey String    @db.VarChar(50)
  isEnabled Boolean   @default(true)
  config    Json      @default("{}")
  enabledAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([schoolId, moduleKey])
  @@index([schoolId])
  @@map("module_configs")
}

// ─── BIOMETRIC DEVICES ────────────────────────────────────────
model BiometricDevice {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  deviceName  String    @db.VarChar(100)
  deviceCode  String    @db.VarChar(40)
  brand       String    @default("ZKTECO") @db.VarChar(30)
  model       String?   @db.VarChar(80)
  ipAddress   String    @db.VarChar(50)
  port        Int       @default(4370)
  location    String?   @db.VarChar(100)
  purpose     String    @default("BOTH") @db.VarChar(20)
  isActive    Boolean   @default(true)
  lastSync    DateTime?
  syncStatus  String?   @db.VarChar(20)
  syncMessage String?   @db.VarChar(200)
  totalLogs   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, deviceCode])
  @@index([schoolId])
  @@map("biometric_devices")
}

// ─── SCHOOL WEBSITE ──────────────────────────────────────────
model WebsiteConfig {
  id        Int    @id @default(autoincrement())
  schoolId  Int    @unique
  school    School @relation(fields: [schoolId], references: [id])
  isEnabled Boolean @default(false)

  // Domain — subdomain is auto-derived from school.slug (always works,
  // zero setup). Custom domain is NOT implemented yet — the field is
  // kept so the schema doesn't need another migration when it ships,
  // but nothing reads/verifies it today; the admin UI should show
  // "Coming soon" and not let anyone type into it.
  customDomain String? @db.VarChar(200)

  theme        String @default("DEFAULT") @db.VarChar(30)
  primaryColor String @default("#6366f1") @db.VarChar(20)

  // Hero
  heroTagline  String? @db.VarChar(300)
  heroImageUrl String? @db.VarChar(600)

  // About (plain text, NOT HTML — rendered with line breaks preserved)
  aboutText     String? @db.Text
  aboutImageUrl String? @db.VarChar(600)

  // Admissions
  admissionsText  String? @db.Text
  admissionsPhone String? @db.VarChar(20)
  admissionsEmail String? @db.VarChar(150)

  // Principal's Message — a personal, trust-building touch
  principalName    String? @db.VarChar(150)
  principalMessage String? @db.Text
  principalPhotoUrl String? @db.VarChar(600)

  // Trust stat bar — 4 free-form stat/label pairs, e.g. "25+" / "Years of Excellence"
  stat1Value String? @db.VarChar(20)
  stat1Label String? @db.VarChar(60)
  stat2Value String? @db.VarChar(20)
  stat2Label String? @db.VarChar(60)
  stat3Value String? @db.VarChar(20)
  stat3Label String? @db.VarChar(60)
  stat4Value String? @db.VarChar(20)
  stat4Label String? @db.VarChar(60)

  // Extra CTAs
  brochureUrl    String? @db.VarChar(600) // PDF — "Download Brochure" button
  virtualTourUrl String? @db.VarChar(600) // YouTube/video link — "Watch Video" button

  // Section toggles
  showAbout            Boolean @default(true)
  showAdmissions       Boolean @default(true)
  showGallery          Boolean @default(true)
  showContact          Boolean @default(true)
  showNotices          Boolean @default(true)
  showTestimonials     Boolean @default(false)
  showPrincipalMessage Boolean @default(false)
  showFacilities       Boolean @default(false)
  showFAQs             Boolean @default(false)

  enquiryEnabled Boolean @default(true)
  enquiryEmail   String? @db.VarChar(150)

  metaTitle String? @db.VarChar(200)
  metaDesc  String? @db.VarChar(400)
  updatedAt DateTime @updatedAt

  galleryImages WebsiteGalleryImage[]
  testimonials  WebsiteTestimonial[]
  facilities    WebsiteFacility[]
  faqs          WebsiteFAQ[]

  @@map("website_configs")
}

model WebsiteGalleryImage {
  id        Int           @id @default(autoincrement())
  configId  Int
  config    WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  imageUrl  String        @db.VarChar(600)
  caption   String?       @db.VarChar(200)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([configId])
  @@map("website_gallery_images")
}

model WebsiteTestimonial {
  id         Int           @id @default(autoincrement())
  configId   Int
  config     WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  authorName String        @db.VarChar(150)
  role       String?       @db.VarChar(100) // "Parent", "Class 10 Student", etc.
  quote      String        @db.VarChar(500)
  photoUrl   String?       @db.VarChar(600)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([configId])
  @@map("website_testimonials")
}

model WebsiteFacility {
  id          Int           @id @default(autoincrement())
  configId    Int
  config      WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  icon        String        @default("Building2") @db.VarChar(40) // a lucide-react icon name, picked from a fixed list in the admin UI
  title       String        @db.VarChar(150)
  description String?       @db.VarChar(300)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([configId])
  @@map("website_facilities")
}

model WebsiteFAQ {
  id        Int           @id @default(autoincrement())
  configId  Int
  config    WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  question  String        @db.VarChar(300)
  answer    String        @db.Text
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([configId])
  @@map("website_faqs")
}

model Task {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  title       String       @db.VarChar(300)
  description String?      @db.VarChar(600)
  type        TaskType     @default(CUSTOM)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  module      String       @db.VarChar(50) // "students","academics","finance","hr","library","transport","hostel","system"

  // Deep link — exact Expo Router path
  route       String? @db.VarChar(400)
  // Reference to source entity (e.g. leaveId, issueId)
  referenceId String? @db.VarChar(50)

  // Assignment
  assignedToId      Int?
  assignedTo        User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById      Int?
  assignedBy        User?   @relation("TaskAssigner", fields: [assignedById], references: [id])
  isSystemGenerated Boolean @default(false)

  // Time
  dueDate      DateTime?
  snoozedUntil DateTime?
  completedAt  DateTime?

  remarks String? @db.VarChar(400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs TaskLog[]

  @@index([schoolId])
  @@index([schoolId, assignedToId])
  @@index([schoolId, status])
  @@index([schoolId, type])
  @@index([schoolId, dueDate])
  @@map("tasks")
}

model TaskTemplate {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  code        String       @db.VarChar(60) // "attendance_pending"
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(400)
  type        TaskType
  module      String       @db.VarChar(50)
  priority    TaskPriority @default(MEDIUM)
  route       String?      @db.VarChar(400)
  autoCreate  Boolean      @default(true)
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("task_templates")
}

model TaskLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(50) // "created","completed","status_changed","snoozed","cancelled"
  note      String?  @db.VarChar(300)
  byUserId  Int?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_logs")
}

model WebsiteInquiry {
  id     String        @id @default(cuid())
  type   InquiryType   @default(CONTACT)
  status InquiryStatus @default(NEW)

  schoolName   String
  contactName  String
  designation  String? // Principal / Director / Owner / Admin
  email        String
  phone        String
  city         String?
  state        String?
  studentCount Int? // school size — helps sales prioritise
  message      String? @db.Text

  source      String? // which section/CTA fired it: hero, pricing, footer...
  utmCampaign String?

  notes       String? @db.Text // internal sales notes (superadmin)
  handledById String? // superadmin user id who took it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ─────────────────────────────────────────
// LEAVE MANAGEMENT
// ─────────────────────────────────────────

model LeaveRequest {
  id            Int           @id @default(autoincrement())
  schoolId      Int
  applicantType ApplicantType
  staffId       Int?
  staff         Staff?        @relation("StaffLeaves", fields: [staffId], references: [id])
  studentUserId Int?
  studentUser   User?         @relation("StudentLeaves", fields: [studentUserId], references: [id])

  fromDate      DateTime
  toDate        DateTime
  totalDays     Int
  reason        String      @db.VarChar(500)
  attachmentUrl String?     @db.VarChar(255)
  status        LeaveStatus @default(PENDING)
  approvedById  Int?
  approvedBy    User?       @relation("LeaveApprovals", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectionNote String?     @db.VarChar(255)
  notifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([schoolId])
  @@index([staffId])
  @@index([studentUserId])
  @@index([status])
  @@index([fromDate])
  @@map("leave_requests")
}

// ─────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────

model Conversation {
  id                 Int                       @id @default(autoincrement())
  schoolId           Int
  school             School                    @relation(fields: [schoolId], references: [id])
  type               ConversationType          @default(DIRECT)
  title              String?                   @db.VarChar(100)
  description        String?                   @db.VarChar(255)
  isPinned           Boolean                   @default(false)
  isArchived         Boolean                   @default(false)
  createdById        Int
  createdBy          User                      @relation("ConvCreator", fields: [createdById], references: [id])
  lastMessageAt      DateTime?
  lastMessagePreview String?                   @db.VarChar(200)
  participants       ConversationParticipant[]
  messages           Message[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation("ConvParticipant", fields: [userId], references: [id])
  isMuted        Boolean      @default(false)
  isAdmin        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             Int           @id @default(autoincrement())
  conversationId Int
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User          @relation("MessageSender", fields: [senderId], references: [id])
  content        String        @db.VarChar(2000)
  type           MessageType   @default(TEXT)
  fileUrl        String?       @db.VarChar(500)
  fileName       String?       @db.VarChar(255)
  fileSize       Int?
  replyToId      Int?
  replyTo        Message?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies        Message[]     @relation("MessageReply")
  isDeleted      Boolean       @default(false)
  reads          MessageRead[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageRead {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("MessageReads", fields: [userId], references: [id])
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

model NotificationSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // Email
  emailEnabled       Boolean @default(true)
  emailLeaveApproval Boolean @default(true)
  emailFeeReminder   Boolean @default(true)
  emailAnnouncements Boolean @default(false)

  // SMS
  smsEnabled         Boolean @default(false)
  smsLeaveApproval   Boolean @default(false)
  smsFeeReminder     Boolean @default(true)
  smsAttendanceAlert Boolean @default(false)

  // In-App
  inAppEnabled       Boolean @default(true)
  inAppLeaves        Boolean @default(true)
  inAppFees          Boolean @default(true)
  inAppAnnouncements Boolean @default(true)
  inAppMessages      Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// ─────────────────────────────────────────
// NOTIFICATION INBOX (per-user)
// ─────────────────────────────────────────
// Created by fan-out when a CommNotice is published or a CommBroadcast is
// sent — one row per recipient, so the dashboard "Notifications" page has
// something concrete to read/paginate/mark-read, independent of the
// source Notice/Broadcast record.
enum NotificationSourceType {
  NOTICE
  BROADCAST
  SYSTEM
}

model Notification {
  id         Int                    @id @default(autoincrement())
  schoolId   Int
  school     School                 @relation(fields: [schoolId], references: [id])
  userId     Int
  user       User                   @relation(fields: [userId], references: [id])
  sourceType NotificationSourceType
  sourceId   Int? // CommNotice.id or CommBroadcast.id — null for SYSTEM
  category   String                 @db.VarChar(30) // mirrors CommNoticeCategory / sourceModule, kept as a plain string so it works for both sources
  priority   CommNoticePriority     @default(NORMAL) // URGENT sorts first on the inbox page
  title      String                 @db.VarChar(300)
  body       String                 @db.VarChar(1000)
  isRead     Boolean                @default(false)
  readAt     DateTime?
  createdAt  DateTime               @default(now())

  @@index([schoolId, userId, isRead])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("notifications")
}

// A device's Expo push token — one user can have several (phone + tablet,
// or reinstalled app generating a new token). Fan-out sends to ALL of a
// user's tokens; stale/invalid ones get pruned when Expo's push API
// reports them as DeviceNotRegistered.
model PushToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  platform   String?  @db.VarChar(10) // "ios" | "android"
  deviceInfo String?  @db.VarChar(200)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ─────────────────────────────────────────
// STUDENT AI STUDY BUDDY (chat + quiz)
// ─────────────────────────────────────────
// Separate from the admin Help Center chatbot — this one IS meant for
// academic tutoring/doubt-clearing/quizzes. Quiz questions store their
// correct answer server-side at generation time, so grading is a plain
// DB comparison, never a re-ask to the LLM to "remember" what it wrote.

model StudyBuddySession {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  title     String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages StudyBuddyMessage[]

  @@index([schoolId, studentId])
  @@map("study_buddy_sessions")
}

model StudyBuddyMessage {
  id        Int               @id @default(autoincrement())
  sessionId Int
  session   StudyBuddySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String            @db.VarChar(10) // "user" | "assistant"
  content   String            @db.Text
  createdAt DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@map("study_buddy_messages")
}

enum StudyQuizStatus {
  IN_PROGRESS
  COMPLETED
}

model StudyQuizSession {
  id             Int             @id @default(autoincrement())
  schoolId       Int
  school         School          @relation(fields: [schoolId], references: [id])
  studentId      Int
  student        Student         @relation(fields: [studentId], references: [id])
  subject        String          @db.VarChar(100)
  topic          String?         @db.VarChar(150)
  board          String?         @db.VarChar(20) // RBSE, CBSE, ICSE...
  classLevel     String?         @db.VarChar(20)
  status         StudyQuizStatus @default(IN_PROGRESS)
  totalQuestions Int
  score          Int? // correct-answer count, set once completed
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  questions StudyQuizQuestion[]

  @@index([schoolId, studentId])
  @@map("study_quiz_sessions")
}

model StudyQuizQuestion {
  id            Int              @id @default(autoincrement())
  sessionId     Int
  session       StudyQuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNo    Int
  questionText  String           @db.Text
  optionA       String           @db.VarChar(300)
  optionB       String           @db.VarChar(300)
  optionC       String           @db.VarChar(300)
  optionD       String           @db.VarChar(300)
  correctOption String           @db.VarChar(1) // "A" | "B" | "C" | "D" — set at generation time, never re-derived from the LLM later
  explanation   String?          @db.Text
  studentAnswer String?          @db.VarChar(1)
  isCorrect     Boolean?

  @@index([sessionId, questionNo])
  @@map("study_quiz_questions")
}

// ─────────────────────────────────────────
// CALENDAR EVENTS
// ─────────────────────────────────────────

model SchoolEvent {
  id            Int            @id @default(autoincrement())
  schoolId      Int
  school        School         @relation(fields: [schoolId], references: [id])
  title         String         @db.VarChar(150)
  description   String?        @db.VarChar(500)
  eventType     EventType      @default(EVENT)
  color         String         @default("#6366f1") @db.VarChar(20)
  startDate     DateTime
  endDate       DateTime
  isAllDay      Boolean        @default(true)
  startTime     String?        @db.VarChar(5)
  endTime       String?        @db.VarChar(5)
  forAllClasses Boolean        @default(true)
  classIds      Int[]
  recurrence    RecurrenceType @default(NONE)
  recurrenceEnd DateTime?
  reminderDays  Int            @default(0)
  createdById   Int?
  createdBy     User?          @relation("EventCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
  @@index([startDate])
  @@index([eventType])
  @@map("school_events")
}

// ─────────────────────────────────────────
// REVENUE-SHARING AGENTS
// ─────────────────────────────────────────

enum AgentLevel {
  BRONZE // 5–20 schools  → 5%
  SILVER // 21–50 schools → 8%
  GOLD   // 50+ schools   → 10%
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

// How a school got linked to an agent — matters for audit, both routes
// write to the same AgentSchoolMapping table.
enum AgentMappingSource {
  MANUAL_BY_SUPERADMIN // stopgap until registration referral field ships
  REFERRAL_CODE        // school entered the agent's code at signup
}

enum AgentMappingStatus {
  ACTIVE
  REMOVED
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model Agent {
  id       Int         @id @default(autoincrement())
  name     String      @db.VarChar(100)
  email    String      @unique @db.VarChar(150)
  phone    String      @unique @db.VarChar(15)

  panCard           String? @db.VarChar(20)
  bankAccountName   String? @db.VarChar(100)
  bankAccountNumber String? @db.VarChar(30)
  bankIfsc          String? @db.VarChar(15)

  // Agent's own login — created only by a SuperAdmin, no self-signup.
  username     String @unique @db.VarChar(50)
  passwordHash String @db.VarChar(255)

  // Code the agent shares with schools; will power the future
  // registration-page referral field without any schema change.
  referralCode String @unique @db.VarChar(20)

  // Cached, not authoritative — always recomputed from the count of
  // ACTIVE AgentSchoolMapping rows whenever that count changes, so the
  // level shown here can never drift out of sync with reality.
  level       AgentLevel  @default(BRONZE)
  schoolCount Int         @default(0)
  status      AgentStatus @default(ACTIVE)

  createdByAdminId Int?
  createdByAdmin   SuperAdmin? @relation(fields: [createdByAdminId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  schoolMappings          AgentSchoolMapping[]
  commissionTransactions  CommissionTransaction[]
  payouts                 AgentPayout[]

  @@index([level])
  @@index([status])
  @@map("agents")
}

model AgentSchoolMapping {
  id       Int    @id @default(autoincrement())
  agentId  Int
  agent    Agent  @relation(fields: [agentId], references: [id])
  schoolId Int    @unique // a school can belong to only one agent at a time
  school   School @relation(fields: [schoolId], references: [id])

  source     AgentMappingSource @default(MANUAL_BY_SUPERADMIN)
  status     AgentMappingStatus @default(ACTIVE)
  assignedAt DateTime           @default(now())
  removedAt  DateTime?

  @@index([agentId, status])
  @@map("agent_school_mappings")
}

model CommissionTransaction {
  id      Int   @id @default(autoincrement())
  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  // The exact payment event this commission was earned from — one
  // commission row per payment, never split across cycles/EMIs.
  subscriptionHistoryId Int                 @unique
  subscriptionHistory   SubscriptionHistory @relation(fields: [subscriptionHistoryId], references: [id])

  paymentAmount    Decimal          @db.Decimal(10, 2) // exactly what the school paid this event
  billingCycleType BillingCycleType
  agentLevelAtTime AgentLevel       // snapshot — later level changes must not rewrite history
  commissionPercent Decimal         @db.Decimal(5, 2)
  commissionAmount  Decimal         @db.Decimal(10, 2)

  status          CommissionStatus @default(PENDING)
  approvedByAdminId Int?
  approvedByAdmin   SuperAdmin?    @relation("CommissionApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt        DateTime?
  rejectionReason   String?        @db.VarChar(300)

  payoutId Int?
  payout   AgentPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())

  @@index([agentId, status])
  @@index([schoolId])
  @@map("commission_transactions")
}

model AgentPayout {
  id     Int   @id @default(autoincrement())
  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id])

  totalAmount Decimal      @db.Decimal(10, 2)
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(PENDING)
  referenceId String?      @db.VarChar(100) // bank transfer UTR etc., filled when marked paid

  createdByAdminId Int?
  createdByAdmin   SuperAdmin? @relation(fields: [createdByAdminId], references: [id])

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  commissions CommissionTransaction[]

  @@index([agentId])
  @@map("agent_payouts")
}
