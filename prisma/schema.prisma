// ─────────────────────────────────────────────────────────────
// HR SETTINGS MODEL
// ─────────────────────────────────────────────────────────────

// Comprehensive HR configuration — one row per school
model HrSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // ── General ─────────────────────────────────────────────────
  employeeIdFormat       String   @default("EMP-{YYYY}-{SEQ}") @db.VarChar(50)
  employeeIdStartSeq     Int      @default(1)
  defaultAcademicSession String?  @db.VarChar(20)
  workingDays            String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  fiscalYearStart        Int      @default(4) // April

  // ── Employee Settings ────────────────────────────────────────
  employmentTypes       String[] @default(["PERMANENT", "CONTRACT", "PROBATION", "PART_TIME", "VISITING"])
  staffCategories       String[] @default(["TEACHING", "NON_TEACHING", "MANAGEMENT", "TRANSPORT", "SUPPORT"])
  defaultProbationDays  Int      @default(90)
  confirmationAlertDays Int      @default(15)

  // ── Attendance Settings ──────────────────────────────────────
  attendanceMethods       String[] @default(["MANUAL"])
  graceMins               Int      @default(15)
  halfDayAfterMins        Int      @default(240) // 4 hrs
  autoMarkAbsent          Boolean  @default(false)
  autoMarkTime            String   @default("10:30") @db.VarChar(5)
  overtimeEnabled         Boolean  @default(false)
  missedPunchAlertEnabled Boolean  @default(true)

  // ── Leave Settings ───────────────────────────────────────────
  leaveYearStartMonth   Int     @default(4)
  maxConsecutiveLeave   Int     @default(15)
  sandwichRuleEnabled   Boolean @default(true)
  backdatedLeaveAllowed Boolean @default(false)
  backdatedLeaveDays    Int     @default(3)
  autoLeaveApprovalDays Int     @default(0)
  compOffExpiryDays     Int     @default(90)
  encashmentAllowed     Boolean @default(true)

  // ── Recruitment Settings ─────────────────────────────────────
  vacancyApprovalRequired  Boolean @default(true)
  defaultCandidatePipeline Json    @default("[\"APPLIED\",\"SCREENING\",\"INTERVIEW\",\"SELECTED\",\"OFFERED\",\"JOINED\"]")
  interviewReminderHours   Int     @default(24)
  offerLetterExpiryDays    Int     @default(7)

  // ── Performance Settings ─────────────────────────────────────
  reviewFrequency        String  @default("QUARTERLY") @db.VarChar(20)
  kpiAutoCalculate       Boolean @default(true)
  performanceGoalEnabled Boolean @default(true)
  appraisalCycle         String  @default("YEARLY") @db.VarChar(20)
  minKpiScore            Decimal @default(40) @db.Decimal(5, 2)

  // ── Document Settings ────────────────────────────────────────
  docExpiryAlertDays  Int[]   @default([7, 15, 30])
  requiredDocsByType  Json    @default("{}") // {TEACHING: ["AADHAAR","PAN","CERTIFICATE"], ...}
  autoComplianceCheck Boolean @default(true)
  bgCheckRequired     Boolean @default(false)

  // ── ID Card Settings ─────────────────────────────────────────
  idCardValidYears       Int     @default(3)
  idCardAutoGenerate     Boolean @default(false)
  idCardQrEnabled        Boolean @default(true)
  idCardDigitalSignature Boolean @default(false)

  // ── Notification Settings ────────────────────────────────────
  notifyLeaveRequest     Boolean @default(true)
  notifyLeaveApproval    Boolean @default(true)
  notifyAttendanceAlert  Boolean @default(true)
  notifyDocExpiry        Boolean @default(true)
  notifyContractExpiry   Boolean @default(true)
  notifyRecruitmentEvent Boolean @default(true)
  notifyAppraisalDue     Boolean @default(true)
  notifyViaEmail         Boolean @default(true)
  notifyViaSms           Boolean @default(false)
  notifyViaPush          Boolean @default(false)

  // ── Approval Workflows (JSON config) ─────────────────────────
  leaveApprovalFlow    Json @default("[\"HOD\",\"HR\"]")
  loanApprovalFlow     Json @default("[\"HR\",\"ACCOUNTS\",\"MANAGEMENT\"]")
  salaryApprovalFlow   Json @default("[\"HR\",\"ACCOUNTS\"]")
  transferApprovalFlow Json @default("[\"HOD\",\"HR\",\"MANAGEMENT\"]")
  docVerificationFlow  Json @default("[\"HR\"]")

  // ── Security Settings ────────────────────────────────────────
  salaryVisible        String[] @default(["HR_EXECUTIVE", "ACCOUNTANT"])
  staffDataAccess      String   @default("ROLE_BASED") @db.VarChar(20)
  documentAccessLevel  String   @default("HR_ONLY") @db.VarChar(20)
  sensitiveDataMasking Boolean  @default(true)

  // ── Audit Settings ───────────────────────────────────────────
  logRetentionYears       Int     @default(7)
  auditEnabled            Boolean @default(true)
  sensitiveActionsTracked Boolean @default(true)
  suspiciousActivityAlert Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hr_settings")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATE TEMPLATES
// ─────────────────────────────────────────────────────────────

// Reusable, versioned certificate template with drag-drop layout
model CertTemplate {
  id               Int            @id @default(autoincrement())
  schoolId         Int
  school           School         @relation(fields: [schoolId], references: [id])
  category         CertCategory   @default(STUDENT)
  certType         CertType       @default(BONAFIDE)
  name             String         @db.VarChar(200)
  description      String?        @db.VarChar(400)
  // Design layout — full JSON (elements, positions, styles)
  layoutJson       Json           @default("{}")
  // Raw HTML body with {{placeholders}}
  htmlContent      String?        @db.Text
  // Styling
  primaryColor     String         @default("#1e3a8a") @db.VarChar(20)
  accentColor      String         @default("#f59e0b") @db.VarChar(20)
  fontFamily       String         @default("Inter") @db.VarChar(50)
  paperSize        String         @default("A4") @db.VarChar(10)
  orientation      String         @default("PORTRAIT") @db.VarChar(12)
  // Features
  showQrCode       Boolean        @default(true)
  showLogo         Boolean        @default(true)
  showSignature    Boolean        @default(true)
  showWatermark    Boolean        @default(false)
  watermarkText    String?        @db.VarChar(60)
  signatureLabel   String?        @db.VarChar(100) // "Principal" / "HR Manager"
  headerHtml       String?        @db.Text
  footerHtml       String?        @db.Text
  // Dynamic variables list (for UI hints)
  variables        String[] // ["{{studentName}}","{{class}}",...]
  // Lifecycle
  version          Int            @default(1)
  parentId         Int? // Previous version ID
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  usageCount       Int            @default(0)
  targetType       CertTargetType @default(STUDENT)
  // Approval required before generate
  needsApproval    Boolean        @default(false)
  approvalRoles    String[]       @default(["SYSTEM_ADMIN", "TEACHER"])
  // Expiry settings
  expiresAfterDays Int? // null = no expiry
  createdById      Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  certIssued CertIssued[]

  @@index([schoolId])
  @@index([schoolId, category])
  @@index([schoolId, certType])
  @@index([schoolId, isActive])
  @@map("cert_templates")
}

// ─────────────────────────────────────────────────────────────
// ISSUED CERTIFICATES (Central repository)
// ─────────────────────────────────────────────────────────────

model CertIssued {
  id             Int            @id @default(autoincrement())
  schoolId       Int
  school         School         @relation(fields: [schoolId], references: [id])
  templateId     Int?
  template       CertTemplate?  @relation(fields: [templateId], references: [id])
  certNumber     String         @db.VarChar(60)
  category       CertCategory
  certType       CertType
  targetType     CertTargetType @default(STUDENT)
  // Recipient
  studentId      Int?
  student        Student?       @relation("StudentCerts", fields: [studentId], references: [id])
  staffId        Int?
  staff          Staff?         @relation("StaffCerts", fields: [staffId], references: [id])
  recipientName  String         @db.VarChar(150) // denormalized for fast lookup
  // Content
  title          String         @db.VarChar(200)
  issuedDate     DateTime       @db.Date
  validUntil     DateTime?      @db.Date
  purposeNote    String?        @db.VarChar(300)
  // The data snapshot used to generate (for re-print fidelity)
  dataSnapshot   Json?
  // Output
  htmlContent    String?        @db.Text
  pdfUrl         String?        @db.VarChar(600)
  qrCode         String?        @db.VarChar(500)
  verifyUrl      String?        @db.VarChar(500)
  // Lifecycle
  status         CertStatus     @default(VALID)
  revokedAt      DateTime?
  revokeReason   String?        @db.VarChar(300)
  reissuedFromId Int?
  // Meta
  sourceModule   String?        @db.VarChar(30) // "EXAMS","SPORTS","HR","STUDENTS","ACTIVITIES"
  sourceRefId    Int? // exam_id / event_id etc.
  bulkBatchId    String?        @db.VarChar(60) // groups bulk-issued certs
  issuedById     Int?
  issuedBy       User?          @relation("CertIssuedBy", fields: [issuedById], references: [id])
  printCount     Int            @default(0)
  downloadCount  Int            @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request CertRequest?

  @@unique([schoolId, certNumber])
  @@index([schoolId])
  @@index([schoolId, certType])
  @@index([schoolId, category])
  @@index([studentId])
  @@index([staffId])
  @@index([bulkBatchId])
  @@index([sourceModule, sourceRefId])
  @@map("cert_issued")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATE REQUESTS (student / parent portal flow)
// ─────────────────────────────────────────────────────────────

model CertRequest {
  id              Int               @id @default(autoincrement())
  schoolId        Int
  school          School            @relation(fields: [schoolId], references: [id])
  studentId       Int?
  student         Student?          @relation(fields: [studentId], references: [id])
  requestedById   Int
  requestedBy     User              @relation("CertRequester", fields: [requestedById], references: [id])
  certType        CertType
  purpose         String?           @db.VarChar(400)
  urgency         String            @default("NORMAL") @db.VarChar(10)
  copies          Int               @default(1)
  status          CertRequestStatus @default(PENDING)
  approvedById    Int?
  approvedBy      User?             @relation("CertApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?           @db.VarChar(300)
  certIssuedId    Int?              @unique
  certIssued      CertIssued?       @relation(fields: [certIssuedId], references: [id])
  notes           String?           @db.VarChar(300)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("cert_requests")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATE SETTINGS (per school)
// ─────────────────────────────────────────────────────────────

model CertSettings {
  id                      Int      @id @default(autoincrement())
  schoolId                Int      @unique
  school                  School   @relation(fields: [schoolId], references: [id])
  // Numbering
  certNumberFormat        String   @default("CERT-{YYYY}-{SEQ}") @db.VarChar(50)
  certNumberStartSeq      Int      @default(1)
  currentSeq              Int      @default(0)
  // Features
  qrVerificationEnabled   Boolean  @default(true)
  digitalSignatureEnabled Boolean  @default(false)
  publicVerifyEnabled     Boolean  @default(true)
  // Approval rules per cert type (JSON: {BONAFIDE: ["OFFICE"], TRANSFER: ["PRINCIPAL"]})
  approvalRules           Json     @default("{}")
  // Expiry per cert type (JSON: {BONAFIDE: null, TRANSFER: null})
  expiryRules             Json     @default("{}")
  // Auto-generation triggers
  autoGenOnExamResult     Boolean  @default(false)
  autoGenTopN             Int      @default(3)
  autoGenOnSportsWin      Boolean  @default(false)
  // Email / print
  emailOnGenerate         Boolean  @default(false)
  watermarkDefault        Boolean  @default(false)
  defaultSignatureLabel   String   @default("Principal") @db.VarChar(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("cert_settings")
}

model StudyCurriculum {
  id           Int         @id @default(autoincrement())
  schoolId     Int
  school       School      @relation(fields: [schoolId], references: [id])
  name         String      @db.VarChar(200) // "CBSE 2025-26", "Custom Science Curriculum"
  board        SchoolBoard @default(CBSE)
  academicYear String      @db.VarChar(20) // "2025-26"
  description  String?     @db.VarChar(400)
  isActive     Boolean     @default(true)
  isDefault    Boolean     @default(false)
  clonedFromId Int? // Parent curriculum if cloned from previous year
  createdById  Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chapters StudyChapter[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
  @@index([schoolId, board])
  @@map("study_curriculums")
}

// ─────────────────────────────────────────────────────────────
// CHAPTERS
// ─────────────────────────────────────────────────────────────

// Chapters belong to a Subject within a Curriculum
model StudyChapter {
  id             Int               @id @default(autoincrement())
  schoolId       Int
  school         School            @relation(fields: [schoolId], references: [id])
  curriculumId   Int
  curriculum     StudyCurriculum   @relation(fields: [curriculumId], references: [id])
  // Grade-level, NOT tied to one class-section's Subject row — this is
  // what lets "Class 5-A" and "Class 5-B" share the same curriculum for
  // "Mathematics" instead of needing it duplicated per section.
  classNumber    String            @db.VarChar(5)
  subjectName    String            @db.VarChar(100)
  name           String            @db.VarChar(200)
  chapterNumber  Int               @default(1)
  description    String?           @db.VarChar(400)
  estimatedHours Int               @default(0)
  importance     ChapterImportance @default(MEDIUM)
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  topics      StudyTopic[]
  materials   StudyMaterial[]
  assignments StudyAssignment[]
  lessonPlans StudyLessonPlan[]

  @@unique([curriculumId, classNumber, subjectName, chapterNumber])
  @@index([schoolId])
  @@index([curriculumId])
  @@index([schoolId, classNumber, subjectName])
  @@map("study_chapters")
}

// ─────────────────────────────────────────────────────────────
// TOPICS
// ─────────────────────────────────────────────────────────────

model StudyTopic {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  school        School       @relation(fields: [schoolId], references: [id])
  chapterId     Int
  chapter       StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name          String       @db.VarChar(200)
  topicNumber   Int          @default(1)
  description   String?      @db.VarChar(400)
  estimatedMins Int          @default(45) // estimated class periods (in mins)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subTopics   StudySubTopic[]
  trackers    StudySyllabusTracker[]
  materials   StudyMaterial[]
  assignments StudyAssignment[]
  lessonPlans StudyLessonPlan[]

  @@index([schoolId])
  @@index([chapterId])
  @@map("study_topics")
}

// ─────────────────────────────────────────────────────────────
// SUB TOPICS (optional granularity)
// ─────────────────────────────────────────────────────────────

model StudySubTopic {
  id        Int        @id @default(autoincrement())
  schoolId  Int
  school    School     @relation(fields: [schoolId], references: [id])
  topicId   Int
  topic     StudyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(200)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@index([topicId])
  @@index([schoolId])
  @@map("study_sub_topics")
}

// ─────────────────────────────────────────────────────────────
// SYLLABUS TRACKER — per teacher, per topic, per class
// ─────────────────────────────────────────────────────────────

model StudySyllabusTracker {
  id           Int            @id @default(autoincrement())
  schoolId     Int
  school       School         @relation(fields: [schoolId], references: [id])
  topicId      Int
  topic        StudyTopic     @relation(fields: [topicId], references: [id])
  staffId      Int // teacher who is teaching this
  staff        Staff          @relation(fields: [staffId], references: [id])
  classId      Int // which class section — progress is always tracked per-section
  academicYear String         @db.VarChar(20)
  status       SyllabusStatus @default(NOT_STARTED)
  progressPct  Int            @default(0) // 0-100
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?        @db.VarChar(300)
  updatedAt    DateTime       @updatedAt

  @@unique([topicId, staffId, classId, academicYear])
  @@index([schoolId])
  @@index([staffId])
  @@index([classId])
  @@map("study_syllabus_trackers")
}

model StudyMaterial {
  id            Int                     @id @default(autoincrement())
  schoolId      Int
  school        School                  @relation(fields: [schoolId], references: [id])
  uploadedById  Int?
  uploadedBy    Staff?                  @relation("MaterialUploader", fields: [uploadedById], references: [id])
  // Academic mapping (all optional — material can be school-wide).
  // classId = pin to ONE specific section only (rare — e.g. a note just
  // for "5-A"). classNumber+subjectName = grade-level, visible to every
  // section teaching that subject (the common case).
  classId       Int?
  class         Class?                  @relation(fields: [classId], references: [id])
  classNumber   String?                 @db.VarChar(5)
  subjectName   String?                 @db.VarChar(100)
  chapterId     Int?
  chapter       StudyChapter?           @relation(fields: [chapterId], references: [id])
  topicId       Int?
  topic         StudyTopic?             @relation(fields: [topicId], references: [id])
  // Content
  title         String                  @db.VarChar(300)
  description   String?                 @db.VarChar(600)
  type          StudyMaterialType       @default(PDF)
  visibility    StudyMaterialVisibility @default(STUDENT_VISIBLE)
  fileUrl       String?                 @db.VarChar(800)
  fileName      String?                 @db.VarChar(300)
  fileSizeKb    Int?
  mimeType      String?                 @db.VarChar(100)
  thumbnailUrl  String?                 @db.VarChar(600)
  externalUrl   String?                 @db.VarChar(800) // YouTube / Drive link
  tags          String[]
  // Metrics
  viewCount     Int                     @default(0)
  downloadCount Int                     @default(0)
  // Lifecycle
  isArchived    Boolean                 @default(false)
  version       Int                     @default(1)
  parentId      Int? // previous version
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  assignmentMaterials StudyAssignmentMaterial[]
  lessonPlanMaterials StudyLessonPlanMaterial[]
  libDigitalResources LibDigitalResource[]

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, classNumber, subjectName])
  @@index([schoolId, chapterId])
  @@index([schoolId, classId])
  @@index([schoolId, isArchived])
  @@map("study_materials")
}

// ─────────────
// ASSIGNMENTS
// ──────────────
model StudyAssignment {
  id           Int                 @id @default(autoincrement())
  schoolId     Int
  school       School              @relation(fields: [schoolId], references: [id])
  createdById  Int
  createdBy    Staff               @relation(fields: [createdById], references: [id])
  // Academic mapping — see StudyMaterial's comment on classId vs classNumber
  classId      Int?
  class        Class?              @relation(fields: [classId], references: [id])
  classNumber  String?             @db.VarChar(5)
  subjectName  String?             @db.VarChar(100)
  chapterId    Int?
  chapter      StudyChapter?       @relation(fields: [chapterId], references: [id])
  topicId      Int?
  topic        StudyTopic?         @relation(fields: [topicId], references: [id])
  // Details
  title        String              @db.VarChar(300)
  instructions String?             @db.Text
  totalMarks   Int                 @default(10)
  dueDate      DateTime?
  type         StudyAssignmentType @default(HOMEWORK)
  isReusable   Boolean             @default(false) // bank assignment
  isActive     Boolean             @default(true)
  academicYear String?             @db.VarChar(20)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  submissions StudyAssignmentSubmission[]
  materials   StudyAssignmentMaterial[]

  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([schoolId, classNumber, subjectName])
  @@index([schoolId, isReusable])
  @@index([schoolId, type])
  @@map("study_assignments")
}

// Join: assignment ↔ study material (reuse without re-upload)
model StudyAssignmentMaterial {
  id           Int             @id @default(autoincrement())
  assignmentId Int
  assignment   StudyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  materialId   Int
  material     StudyMaterial   @relation(fields: [materialId], references: [id])
  sortOrder    Int             @default(0)

  @@unique([assignmentId, materialId])
  @@map("study_assignment_materials")
}

// Student submission for an assignment
model StudyAssignmentSubmission {
  id            Int                   @id @default(autoincrement())
  assignmentId  Int
  assignment    StudyAssignment       @relation(fields: [assignmentId], references: [id])
  studentId     Int
  student       Student               @relation(fields: [studentId], references: [id])
  fileUrl       String?               @db.VarChar(800)
  fileName      String?               @db.VarChar(300)
  notes         String?               @db.VarChar(600)
  status        StudySubmissionStatus @default(PENDING)
  marks         Decimal?              @db.Decimal(6, 2)
  feedback      String?               @db.VarChar(600)
  isLate        Boolean               @default(false)
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  evaluatedById Int?
  evaluatedBy   Staff?                @relation("SubmissionEvaluator", fields: [evaluatedById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([assignmentId, status])
  @@map("study_assignment_submissions")
}

// ──────────────
// LESSON PLANS
// ──────────────

model StudyLessonPlan {
  id             Int                       @id @default(autoincrement())
  schoolId       Int
  school         School                    @relation(fields: [schoolId], references: [id])
  staffId        Int
  staff          Staff                     @relation(fields: [staffId], references: [id])
  // Academic mapping — see StudyMaterial's comment on classId vs classNumber
  classId        Int?
  class          Class?                    @relation(fields: [classId], references: [id])
  classNumber    String?                   @db.VarChar(5)
  subjectName    String?                   @db.VarChar(100)
  chapterId      Int?
  chapter        StudyChapter?             @relation(fields: [chapterId], references: [id])
  topicId        Int?
  topic          StudyTopic?               @relation(fields: [topicId], references: [id])
  // Plan details
  title          String                    @db.VarChar(300)
  objectives     String[] // learning objectives
  teachingMethod StudyTeachingMethod       @default(LECTURE)
  durationMins   Int                       @default(45)
  outcomes       String[] // expected learning outcomes
  notes          String?                   @db.VarChar(600)
  // Calendar
  academicYear   String                    @db.VarChar(20)
  weekNumber     Int?
  monthNumber    Int?
  plannedDate    DateTime?                 @db.Date
  // Progress & Approval
  status         StudyLessonStatus         @default(NOT_STARTED)
  approvalStatus StudyLessonApprovalStatus @default(DRAFT)
  approvedById   Int?
  approvedBy     Staff?                    @relation("LessonApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  completedAt    DateTime?
  clonedFromId   Int?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  materials StudyLessonPlanMaterial[]

  @@index([schoolId])
  @@index([schoolId, staffId])
  @@index([schoolId, classNumber, subjectName])
  @@index([schoolId, academicYear])
  @@index([schoolId, weekNumber])
  @@index([schoolId, approvalStatus])
  @@map("study_lesson_plans")
}

// Join: lesson plan ↔ study material (reuse same file)
model StudyLessonPlanMaterial {
  id           Int             @id @default(autoincrement())
  lessonPlanId Int
  lessonPlan   StudyLessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  materialId   Int
  material     StudyMaterial   @relation(fields: [materialId], references: [id])
  sortOrder    Int             @default(0)

  @@unique([lessonPlanId, materialId])
  @@map("study_lesson_plan_materials")
}

// ─────────────
// NOTICE BOARD
// ─────────────

model CommNotice {
  id             Int                @id @default(autoincrement())
  schoolId       Int
  school         School             @relation(fields: [schoolId], references: [id])
  noticeNumber   String?            @db.VarChar(60)
  title          String             @db.VarChar(300)
  category       CommNoticeCategory @default(GENERAL)
  priority       CommNoticePriority @default(NORMAL)
  status         CommNoticeStatus   @default(DRAFT)
  // Content
  content        String             @db.Text // rich-text HTML
  summary        String?            @db.VarChar(400) // short plain-text preview
  // Attachments stored as JSON array [{name, url, type, sizeKb}]
  attachments    Json               @default("[]")
  // Target audience
  audienceType   CommAudienceType   @default(ALL)
  targetClassIds Int[] // when CLASS_WISE
  targetUserIds  Int[] // when custom
  // Publishing
  isPinned       Boolean            @default(false)
  showOnWebsite  Boolean            @default(false) // staff opts in — public school website shows only these
  publishAt      DateTime?
  expiresAt      DateTime?
  // Approval
  createdById    Int
  createdBy      User               @relation("NoticeCreator", fields: [createdById], references: [id])
  approvedById   Int?
  approvedBy     User?              @relation("NoticeApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionNote  String?            @db.VarChar(300)
  // Metrics (denormalised for speed)
  viewCount      Int                @default(0)
  downloadCount  Int                @default(0)
  // Timestamps
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  seenBy CommNoticeSeen[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, category])
  @@index([schoolId, publishAt])
  @@index([schoolId, isPinned])
  @@index([schoolId, showOnWebsite, status])
  @@map("comm_notices")
}

// Track which users have seen/read a notice
model CommNoticeSeen {
  id         Int        @id @default(autoincrement())
  noticeId   Int
  notice     CommNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  seenAt     DateTime   @default(now())
  downloaded Boolean    @default(false)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@map("comm_notice_seen")
}

// ───────────────────────
// COMMUNICATION TEMPLATES
// ───────────────────────

model CommTemplate {
  id          Int                    @id @default(autoincrement())
  schoolId    Int
  school      School                 @relation(fields: [schoolId], references: [id])
  name        String                 @db.VarChar(200)
  type        CommTemplateType       @default(GENERAL)
  subject     String?                @db.VarChar(300) // for email
  body        String                 @db.Text // {{variables}} supported
  variables   String[] // ["{{studentName}}", "{{dueAmount}}"]
  channels    CommBroadcastChannel[] // which channels this template works for
  isDefault   Boolean                @default(false)
  isActive    Boolean                @default(true)
  usageCount  Int                    @default(0)
  createdById Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  broadcasts CommBroadcast[]
  versions   CommTemplateVersion[]

  @@index([schoolId])
  @@index([schoolId, type])
  @@map("comm_templates")
}

// ─────────────────
// BROADCAST CENTER
// ─────────────────

// A single broadcast campaign (one message to many)
model CommBroadcast {
  id              Int                    @id @default(autoincrement())
  schoolId        Int
  school          School                 @relation(fields: [schoolId], references: [id])
  createdById     Int
  createdBy       User                   @relation("BroadcastCreator", fields: [createdById], references: [id])
  templateId      Int?
  template        CommTemplate?          @relation(fields: [templateId], references: [id])
  // Identity
  title           String                 @db.VarChar(300)
  campaignName    String?                @db.VarChar(200)
  // Audience
  audienceType    CommAudienceType       @default(ALL)
  targetClassIds  Int[]
  targetUserIds   Int[]
  segmentId       Int?
  segment         CommAudienceSegment?   @relation(fields: [segmentId], references: [id])
  totalRecipients Int                    @default(0)
  // Channels
  channels        CommBroadcastChannel[]
  // Content per channel (stored as JSON {APP_NOTIFICATION: {title, body}, SMS: {body}, EMAIL: {subject, body, html}})
  content         Json                   @default("{}")
  attachments     Json                   @default("[]")
  // Scheduling
  status          CommBroadcastStatus    @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  // Delivery stats (denormalised for speed)
  sentCount       Int                    @default(0)
  deliveredCount  Int                    @default(0)
  readCount       Int                    @default(0)
  failedCount     Int                    @default(0)
  // Retry
  retryCount      Int                    @default(0)
  lastRetryAt     DateTime?
  // Source module (who triggered this broadcast)
  sourceModule    String?                @db.VarChar(40) // "EXAMS", "FINANCE", "HR", "TRANSPORT", "MANUAL"
  sourceRefId     Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  deliveries CommDelivery[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, audienceType])
  @@index([schoolId, scheduledAt])
  @@index([sourceModule, sourceRefId])
  @@map("comm_broadcasts")
}

// Per-recipient delivery record
model CommDelivery {
  id            Int                  @id @default(autoincrement())
  broadcastId   Int
  broadcast     CommBroadcast        @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId        Int? // null = external (phone number only)
  phone         String?              @db.VarChar(20)
  email         String?              @db.VarChar(200)
  channel       CommBroadcastChannel
  status        CommDeliveryStatus   @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?              @db.VarChar(200)
  providerMsgId String?              @db.VarChar(200) // SMS gateway / push service message ID
  retryCount    Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([broadcastId])
  @@index([broadcastId, status])
  @@index([userId])
  @@index([channel, status])
  @@map("comm_deliveries")
}

// Reusable audience segments
model CommAudienceSegment {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  school         School           @relation(fields: [schoolId], references: [id])
  name           String           @db.VarChar(200)
  description    String?          @db.VarChar(400)
  audienceType   CommAudienceType
  // Filters stored as JSON: {classIds, sectionIds, routeIds, feeDefaulter: true, ...}
  filters        Json             @default("{}")
  // Resolved user IDs cache (refreshed on use)
  userIdCache    Int[]
  cacheUpdatedAt DateTime?
  isActive       Boolean          @default(true)
  usageCount     Int              @default(0)
  createdById    Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  broadcasts CommBroadcast[]

  @@index([schoolId])
  @@map("comm_audience_segments")
}

// Scheduled future messages (cron-driven)
model CommScheduledMessage {
  id             Int                    @id @default(autoincrement())
  schoolId       Int
  school         School                 @relation(fields: [schoolId], references: [id])
  title          String                 @db.VarChar(200)
  broadcastId    Int? // created when executed
  templateId     Int?
  audienceType   CommAudienceType
  targetClassIds Int[]
  channels       CommBroadcastChannel[]
  content        Json                   @default("{}")
  scheduledAt    DateTime
  recurrence     String?                @db.VarChar(20) // ONCE, DAILY, WEEKLY, MONTHLY
  isActive       Boolean                @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  runCount       Int                    @default(0)
  sourceModule   String?                @db.VarChar(40)
  createdById    Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  executions CommScheduleExecution[]

  @@index([schoolId])
  @@index([schoolId, scheduledAt])
  @@index([schoolId, isActive])
  @@map("comm_scheduled_messages")
}

model CommConversation {
  id            Int                  @id @default(autoincrement())
  schoolId      Int
  school        School               @relation(fields: [schoolId], references: [id])
  type          CommConversationType @default(DIRECT)
  title         String?              @db.VarChar(200) // for group conversations
  groupId       Int?
  group         CommGroup?           @relation(fields: [groupId], references: [id])
  lastMessageAt DateTime?
  lastMessage   String?              @db.VarChar(300) // preview text
  isArchived    Boolean              @default(false)
  isPinned      Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  participants CommConversationParticipant[]
  messages     CommMessage[]

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, lastMessageAt])
  @@map("comm_conversations")
}

model CommConversationParticipant {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  isAdmin        Boolean          @default(false)
  isMuted        Boolean          @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("comm_conversation_participants")
}

model CommAutomationRule {
  id            Int                    @id @default(autoincrement())
  schoolId      Int
  school        School                 @relation(fields: [schoolId], references: [id])
  name          String                 @db.VarChar(200)
  description   String?                @db.VarChar(400)
  trigger       CommAutomationTrigger
  status        CommAutomationStatus   @default(ACTIVE)
  // Trigger conditions (JSON — varies by trigger type)
  // e.g. FEE_DUE: {daysBefore: 3, dueDateField: "dueDate"}
  // e.g. STUDENT_ABSENT: {consecutiveDays: 2}
  conditions    Json                   @default("{}")
  // Communication config
  templateId    Int?
  audienceType  CommAudienceType       @default(ALL_PARENTS)
  channels      CommBroadcastChannel[]
  // Delay after trigger (in minutes, 0 = immediate)
  delayMins     Int                    @default(0)
  // Cooldown — don't re-send to same recipient within N hours
  cooldownHours Int                    @default(24)
  // Stats
  runCount      Int                    @default(0)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  // Meta
  createdById   Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, trigger])
  @@map("comm_automation_rules")
}

// ─────────────────────────────────────────────────────────────
// SCHEDULE EXECUTION LOGS
// ─────────────────────────────────────────────────────────────

model CommScheduleExecution {
  id               Int                  @id @default(autoincrement())
  schoolId         Int
  school           School               @relation(fields: [schoolId], references: [id])
  scheduledMsgId   Int
  scheduledMessage CommScheduledMessage @relation(fields: [scheduledMsgId], references: [id], onDelete: Cascade)
  status           CommExecutionStatus
  recipientsCount  Int                  @default(0)
  broadcastId      Int? // created broadcast for this execution
  errorMessage     String?              @db.VarChar(400)
  executedAt       DateTime             @default(now())

  @@index([schoolId])
  @@index([scheduledMsgId])
  @@index([schoolId, status])
  @@map("comm_schedule_executions")
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATION SETTINGS (per school, single row)
// ─────────────────────────────────────────────────────────────

model CommSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int    @unique
  school   School @relation(fields: [schoolId], references: [id])

  // ── General ─────────────────────────────────────────────────
  commIdFormat     String  @default("MSG-{YYYY}-{SEQ}") @db.VarChar(50)
  commIdCurrentSeq Int     @default(0)
  defaultTimezone  String  @default("Asia/Kolkata") @db.VarChar(50)
  academicYearAuto Boolean @default(true)

  // ── Channel Priority (ordered list) ──────────────────────────
  channelPriority String[] @default(["APP_NOTIFICATION", "WHATSAPP", "SMS", "EMAIL"])

  // ── Delivery Settings ────────────────────────────────────────
  retryEnabled        Boolean @default(true)
  maxRetryAttempts    Int     @default(3)
  retryIntervalMins   Int     @default(15)
  messageExpiryHours  Int     @default(24)
  // Per-channel daily limits
  smsLimitPerDay      Int     @default(5000)
  emailLimitPerDay    Int     @default(10000)
  whatsappLimitPerDay Int     @default(5000)
  pushLimitPerDay     Int     @default(50000)

  // ── Scheduling Settings ──────────────────────────────────────
  maxScheduleAheadDays Int     @default(365)
  // Default send window (e.g. only send between 8am-9pm)
  sendWindowFrom       String  @default("08:00") @db.VarChar(5)
  sendWindowTo         String  @default("21:00") @db.VarChar(5)
  respectSendWindow    Boolean @default(true)
  // Quiet hours (e.g. 10pm-7am = no sends)
  quietHoursFrom       String  @default("22:00") @db.VarChar(5)
  quietHoursTo         String  @default("07:00") @db.VarChar(5)
  respectQuietHours    Boolean @default(true)

  // ── Automation Settings ──────────────────────────────────────
  automationEnabled      Boolean @default(true)
  feeReminderEnabled     Boolean @default(true)
  attendanceAlertEnabled Boolean @default(true)
  examNotifEnabled       Boolean @default(true)
  birthdayMsgEnabled     Boolean @default(false)

  // ── Template Settings ────────────────────────────────────────
  defaultSenderName String   @default("School Admin") @db.VarChar(100)
  defaultEmailFrom  String?  @db.VarChar(200)
  allowedVariables  String[] @default(["{{studentName}}", "{{class}}", "{{feeDue}}", "{{examDate}}", "{{schoolName}}"])
  requireApproval   Boolean  @default(false)
  approvalRoles     String[] @default(["PRINCIPAL", "ADMIN"])

  // ── Permission Settings ──────────────────────────────────────
  // JSON: {TEACHER: ["CREATE","SEND"], ACCOUNTANT: ["CREATE","SCHEDULE"]}
  rolePermissions Json @default("{}")

  // ── Notification Settings ────────────────────────────────────
  notifyOnFailure       Boolean  @default(true)
  notifyOnLowBalance    Boolean  @default(true)
  notifyOnGatewayDown   Boolean  @default(true)
  notifyEmailRecipients String[] @default([])
  lowBalanceThreshold   Int      @default(100) // SMS credits

  // ── Security Settings ────────────────────────────────────────
  antiSpamEnabled           Boolean  @default(true)
  sameRecipientCooldownMins Int      @default(60)
  // Blacklisted phone number patterns
  blacklistedPatterns       String[] @default([])
  // Allowed sender IDs for SMS
  smsAllowedSenderIds       String[] @default([])

  // ── Audit Settings ───────────────────────────────────────────
  auditEnabled      Boolean @default(true)
  logRetentionDays  Int     @default(365)
  trackReadReceipts Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comm_settings")
}

// ─────────────────────────────────────────────────────────────
// CHANNEL CONFIGURATIONS (per channel per school)
// ─────────────────────────────────────────────────────────────

model CommChannelConfig {
  id           Int                   @id @default(autoincrement())
  schoolId     Int
  school       School                @relation(fields: [schoolId], references: [id])
  type         CommChannelConfigType
  name         String                @db.VarChar(100) // "Primary SMS Gateway"
  isActive     Boolean               @default(false)
  isPrimary    Boolean               @default(false)
  // Config stored as encrypted JSON
  // SMS: {provider, apiKey, senderId, apiUrl}
  // Email: {host, port, user, pass, from, tls}
  // WhatsApp: {apiKey, phoneNumberId, businessAccountId}
  // Push: {fcmKey, apnsKey, apnsCertPath}
  config       Json                  @default("{}")
  // Test status
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  testError    String?               @db.VarChar(300)
  // Usage stats
  sentToday    Int                   @default(0)
  sentTotal    Int                   @default(0)
  failedTotal  Int                   @default(0)
  createdById  Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([schoolId, type, name])
  @@index([schoolId])
  @@index([schoolId, type])
  @@map("comm_channel_configs")
}

// ─────────────────────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────────────────────

model CommMessage {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   CommConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User              @relation("MessageSender", fields: [senderId], references: [id])
  type           CommMessageType   @default(TEXT)
  body           String?           @db.Text
  // Attachment (reuses Content Library concept — stored as JSON)
  attachment     Json? // {url, name, type, sizeKb, thumbnailUrl}
  // Reply threading
  replyToId      Int?
  replyTo        CommMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        CommMessage[]     @relation("MessageReplies")
  // Status
  status         CommMessageStatus @default(SENT)
  isStarred      Boolean           @default(false)
  isDeleted      Boolean           @default(false)
  editedAt       DateTime?
  sentAt         DateTime          @default(now())

  readBy CommMessageRead[]

  @@index([conversationId])
  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("comm_messages")
}

// Per-user read receipts
model CommMessageRead {
  id        Int         @id @default(autoincrement())
  messageId Int
  message   CommMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("comm_message_reads")
}

// ─────────────────────────────────────────────────────────────
// GROUPS
// ─────────────────────────────────────────────────────────────

model CommGroup {
  id          Int           @id @default(autoincrement())
  schoolId    Int
  school      School        @relation(fields: [schoolId], references: [id])
  name        String        @db.VarChar(200)
  description String?       @db.VarChar(400)
  type        CommGroupType @default(CUSTOM)
  avatarUrl   String?       @db.VarChar(600)
  // Filter snapshot for auto-groups (class, dept, route, etc.)
  filters     Json          @default("{}")
  isActive    Boolean       @default(true)
  memberCount Int           @default(0) // denormalised
  createdById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members       CommGroupMember[]
  conversations CommConversation[]

  @@index([schoolId])
  @@index([schoolId, type])
  @@map("comm_groups")
}

model CommGroupMember {
  id       Int       @id @default(autoincrement())
  groupId  Int
  group    CommGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   Int
  user     User      @relation(fields: [userId], references: [id])
  isAdmin  Boolean   @default(false)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("comm_group_members")
}

// ─────────────────────────────────────────────────────────────
// TEMPLATE VERSION HISTORY (extends existing CommTemplate)
// ─────────────────────────────────────────────────────────────

model CommTemplateVersion {
  id          Int          @id @default(autoincrement())
  templateId  Int
  template    CommTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  schoolId    Int
  school      School       @relation(fields: [schoolId], references: [id])
  version     Int // 1, 2, 3...
  name        String       @db.VarChar(200)
  subject     String?      @db.VarChar(300)
  body        String       @db.Text
  variables   String[]
  changelog   String?      @db.VarChar(300)
  createdById Int?
  createdAt   DateTime     @default(now())

  @@unique([templateId, version])
  @@index([templateId])
  @@map("comm_template_versions")
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS — SAVED CUSTOM REPORTS
// ─────────────────────────────────────────────────────────────

model CommSavedReport {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  title       String   @db.VarChar(200)
  reportType  String   @db.VarChar(60) // CHANNEL, DELIVERY, ENGAGEMENT, CAMPAIGN, TEMPLATE, USER
  filters     Json     @default("{}") // {dateFrom, dateTo, channels, audienceType}
  format      String   @default("PDF") @db.VarChar(10)
  fileUrl     String?  @db.VarChar(600)
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@map("comm_saved_reports")
}

model LibBookCategory {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  name        String   @db.VarChar(100)
  code        String?  @db.VarChar(20)
  description String?  @db.VarChar(300)
  color       String   @default("#6366f1") @db.VarChar(20)
  isActive    Boolean  @default(true)
  bookCount   Int      @default(0) // denormalised
  createdAt   DateTime @default(now())

  books LibBook[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("lib_book_categories")
}

model LibAuthor {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @db.VarChar(200)
  bio       String?  @db.VarChar(400)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  books LibBook[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("lib_authors")
}

model LibPublisher {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @db.VarChar(200)
  city      String?  @db.VarChar(100)
  website   String?  @db.VarChar(300)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  books LibBook[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("lib_publishers")
}

// ─────────────────────────────────────────────────────────────
// BOOK CATALOG (master record — one row per title)
// ─────────────────────────────────────────────────────────────

model LibBook {
  id           Int              @id @default(autoincrement())
  schoolId     Int
  school       School           @relation(fields: [schoolId], references: [id])
  isbn         String?          @db.VarChar(30)
  title        String           @db.VarChar(400)
  categoryId   Int?
  category     LibBookCategory? @relation(fields: [categoryId], references: [id])
  authorId     Int?
  author       LibAuthor?       @relation(fields: [authorId], references: [id])
  publisherId  Int?
  publisher    LibPublisher?    @relation(fields: [publisherId], references: [id])
  // Academic mapping (optional). classId = pin to one specific section
  // (rare). classNumber+subjectName = grade-level, matches every section.
  classId      Int?
  class        Class?           @relation(fields: [classId], references: [id])
  classNumber  String?          @db.VarChar(10)
  subjectName  String?          @db.VarChar(100)
  // Book details
  edition      String?          @db.VarChar(50)
  language     LibBookLanguage  @default(ENGLISH)
  pages        Int?
  description  String?          @db.Text
  coverUrl     String?          @db.VarChar(600)
  tags         String[]
  // Stock
  totalCopies  Int              @default(1)
  // Cost
  costPrice    Decimal?         @db.Decimal(10, 2)
  purchaseDate DateTime?        @db.Date
  // Lifecycle
  isActive     Boolean          @default(true)
  createdById  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  copies              LibBookCopy[]
  procurementRequests LibProcurementRequest[]
  LibReservation      LibReservation[]

  @@index([schoolId])
  @@index([schoolId, categoryId])
  @@index([schoolId, authorId])
  @@index([isbn])
  @@map("lib_books")
}

// ─────────────────────────────────────────────────────────────
// BOOK COPIES (one row per physical copy)
// ─────────────────────────────────────────────────────────────

model LibBookCopy {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  school    School        @relation(fields: [schoolId], references: [id])
  bookId    Int
  book      LibBook       @relation(fields: [bookId], references: [id])
  copyCode  String        @db.VarChar(60) // LIB-BOOK-0001-C01
  barcode   String?       @db.VarChar(100)
  status    LibCopyStatus @default(AVAILABLE)
  location  String?       @db.VarChar(100) // shelf location
  condition String        @default("GOOD") @db.VarChar(20)
  lostAt    DateTime?
  damagedAt DateTime?
  notes     String?       @db.VarChar(300)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  issues            LibIssue[]
  inventoryLogs     LibInventoryLog[]
  verificationItems LibStockVerificationItem[]

  @@unique([schoolId, copyCode])
  @@index([schoolId, bookId])
  @@index([schoolId, status])
  @@map("lib_book_copies")
}

// ─────────────────────────────────────────────────────────────
// BOOK ISSUE RECORDS
// ─────────────────────────────────────────────────────────────

model LibIssue {
  id              Int            @id @default(autoincrement())
  schoolId        Int
  school          School         @relation(fields: [schoolId], references: [id])
  copyId          Int
  copy            LibBookCopy    @relation(fields: [copyId], references: [id])
  // Member (one of these will be set)
  memberType      LibMemberType
  studentId       Int?
  student         Student?       @relation("StudentIssues", fields: [studentId], references: [id])
  staffId         Int?
  staff           Staff?         @relation("StaffIssues", fields: [staffId], references: [id])
  // Issue details
  issueDate       DateTime       @db.Date
  dueDate         DateTime       @db.Date
  returnDate      DateTime?      @db.Date
  status          LibIssueStatus @default(ACTIVE)
  renewalCount    Int            @default(0)
  lastRenewedAt   DateTime?
  // Return details
  returnCondition String?        @db.VarChar(20) // GOOD, DAMAGED, LOST
  returnNotes     String?        @db.VarChar(300)
  // Processed by
  issuedById      Int?
  issuedBy        Staff?         @relation("LibraryStaff", fields: [issuedById], references: [id])
  returnedById    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fine LibFine?

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([staffId])
  @@index([copyId])
  @@index([schoolId, dueDate])
  @@map("lib_issues")
}

// ─────────────────────────────────────────────────────────────
// LIBRARY FINES (links to Finance module)
// ─────────────────────────────────────────────────────────────

model LibFine {
  id           Int           @id @default(autoincrement())
  schoolId     Int
  school       School        @relation(fields: [schoolId], references: [id])
  issueId      Int           @unique
  issue        LibIssue      @relation(fields: [issueId], references: [id])
  memberType   LibMemberType
  studentId    Int?
  student      Student?      @relation("StudentFines", fields: [studentId], references: [id])
  staffId      Int?
  staff        Staff?        @relation("StaffFines", fields: [staffId], references: [id])
  // Fine calculation
  overdueDays  Int           @default(0)
  ratePerDay   Decimal       @db.Decimal(8, 2)
  extraCharge  Decimal       @default(0) @db.Decimal(10, 2) // for damage/loss
  totalAmount  Decimal       @db.Decimal(10, 2)
  reason       String        @default("LATE_RETURN") @db.VarChar(30) // LATE_RETURN, DAMAGE, LOSS
  status       LibFineStatus @default(PENDING)
  paidAt       DateTime?
  waivedAt     DateTime?
  waivedById   Int?
  notes        String?       @db.VarChar(300)
  // Links to Finance module payment if integrated
  financeRefId Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  waiver LibFineWaiver?

  @@index([schoolId])
  @@index([studentId])
  @@index([staffId])
  @@index([schoolId, status])
  @@map("lib_fines")
}

// ─────────────────────────────────────────────────────────────
// LIBRARY SETTINGS (per school)
// ─────────────────────────────────────────────────────────────

model LibSettings {
  id                   Int      @id @default(autoincrement())
  schoolId             Int      @unique
  school               School   @relation(fields: [schoolId], references: [id])
  // Book code prefix
  bookCodePrefix       String   @default("LIB") @db.VarChar(20)
  copyCodeFormat       String   @default("{PREFIX}-{BOOKNO}-C{COPYNO}") @db.VarChar(50)
  // Due periods (days)
  studentDueDays       Int      @default(14)
  teacherDueDays       Int      @default(30)
  staffDueDays         Int      @default(21)
  parentDueDays        Int      @default(14)
  // Renewal
  maxRenewals          Int      @default(2)
  renewalDays          Int      @default(7)
  requireApprovalRenew Boolean  @default(false)
  // Issue limits
  maxBooksStudent      Int      @default(3)
  maxBooksTeacher      Int      @default(5)
  maxBooksStaff        Int      @default(3)
  // Fine
  fineEnabled          Boolean  @default(true)
  fineRatePerDay       Decimal  @default(2) @db.Decimal(6, 2)
  fineDamageRate       Decimal  @default(100) @db.Decimal(8, 2)
  fineLossRate         Decimal  @default(500) @db.Decimal(8, 2)
  fineGracePeriodDays  Int      @default(0)
  // Library hours
  workingDays          String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  openTime             String   @default("08:00") @db.VarChar(5)
  closeTime            String   @default("17:00") @db.VarChar(5)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("lib_settings")
}

model LibMembership {
  id                      Int             @id @default(autoincrement())
  schoolId                Int
  school                  School          @relation(fields: [schoolId], references: [id])
  memberType              LibMemberType
  studentId               Int?            @unique
  student                 Student?        @relation("StudentMembership", fields: [studentId], references: [id])
  staffId                 Int?            @unique
  staff                   Staff?          @relation("StaffMembership", fields: [staffId], references: [id])
  // Library card
  libraryCardNo           String?         @db.VarChar(40)
  // Status
  status                  LibMemberStatus @default(ACTIVE)
  blockedReason           String?         @db.VarChar(300)
  blockedAt               DateTime?
  // Overrides (null = use LibSettings defaults)
  maxBooksOverride        Int?
  dueDaysOverride         Int?
  maxRenewalsOverride     Int?
  maxReservationsOverride Int?
  // Stats (denormalised for speed)
  totalIssued             Int             @default(0)
  totalReturned           Int             @default(0)
  totalFines              Int             @default(0)
  totalOverdues           Int             @default(0)
  totalLost               Int             @default(0)
  lastActivityAt          DateTime?
  joinedAt                DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([schoolId])
  @@index([schoolId, memberType])
  @@index([schoolId, status])
  @@map("lib_memberships")
}

// ─────────────────────────────────────────────────────────────
// DIGITAL LIBRARY
// ─────────────────────────────────────────────────────────────

// Thin wrapper over StudyMaterial — organises for library browsing
// StudyMaterial handles the actual file storage (centralised content library)
model LibDigitalResource {
  id              Int                    @id @default(autoincrement())
  schoolId        Int
  school          School                 @relation(fields: [schoolId], references: [id])
  studyMaterialId Int? // links to Study Center content (optional)
  // studyMaterial StudyMaterial?        @relation(fields: [studyMaterialId], references: [id])
  // Direct fields for resources added directly in library (not via Study Center)
  title           String                 @db.VarChar(400)
  description     String?                @db.VarChar(600)
  resourceType    LibDigitalResourceType @default(EBOOK)
  author          String?                @db.VarChar(200)
  publisher       String?                @db.VarChar(200)
  isbn            String?                @db.VarChar(30)
  edition         String?                @db.VarChar(50)
  language        String                 @default("English") @db.VarChar(30)
  // Academic mapping. classId = pin to one specific section (rare).
  // classNumber+subjectName = grade-level, matches every section.
  classId         Int?
  class           Class?                 @relation(fields: [classId], references: [id])
  classNumber     String?                @db.VarChar(10)
  subjectName     String?                @db.VarChar(100)
  // Content
  fileUrl         String?                @db.VarChar(800)
  thumbnailUrl    String?                @db.VarChar(600)
  externalUrl     String?                @db.VarChar(800)
  fileSizeKb      Int?
  totalPages      Int?
  tags            String[]
  // Access control
  accessRoles     String[]               @default(["STUDENT", "TEACHER", "STAFF"])
  // Metrics
  viewCount       Int                    @default(0)
  downloadCount   Int                    @default(0)
  bookmarkCount   Int                    @default(0)
  isActive        Boolean                @default(true)
  isFeatured      Boolean                @default(false)
  createdById     Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  bookmarks     LibResourceBookmark[]
  views         LibResourceView[]
  StudyMaterial StudyMaterial?        @relation(fields: [studyMaterialId], references: [id])

  @@index([schoolId])
  @@index([schoolId, resourceType])
  @@index([schoolId, classId])
  @@index([schoolId, isActive])
  @@map("lib_digital_resources")
}

// User bookmarks on digital resources
model LibResourceBookmark {
  id         Int                @id @default(autoincrement())
  resourceId Int
  resource   LibDigitalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId  Int?
  student    Student?           @relation(fields: [studentId], references: [id])
  staffId    Int?
  staff      Staff?             @relation(fields: [staffId], references: [id])
  pageNo     Int? // last page read / bookmarked
  createdAt  DateTime           @default(now())

  @@unique([resourceId, studentId])
  @@unique([resourceId, staffId])
  @@index([studentId])
  @@index([staffId])
  @@map("lib_resource_bookmarks")
}

// Usage tracking per resource per user
model LibResourceView {
  id         Int                @id @default(autoincrement())
  resourceId Int
  resource   LibDigitalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId  Int?
  student    Student?           @relation(fields: [studentId], references: [id])
  staffId    Int?
  staff      Staff?             @relation(fields: [staffId], references: [id])
  viewType   String             @default("VIEW") @db.VarChar(20) // VIEW | DOWNLOAD
  viewedAt   DateTime           @default(now())

  @@index([resourceId])
  @@index([studentId])
  @@index([staffId])
  @@map("lib_resource_views")
}

// ─────────────────────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────────────────────

model LibReservation {
  id            Int                  @id @default(autoincrement())
  schoolId      Int
  school        School               @relation(fields: [schoolId], references: [id])
  bookId        Int
  book          LibBook              @relation(fields: [bookId], references: [id])
  // Member (one of these will be set — reuse existing data)
  memberType    LibMemberType
  studentId     Int?
  student       Student?             @relation("StudentReservations", fields: [studentId], references: [id])
  staffId       Int?
  staff         Staff?               @relation("StaffReservations", fields: [staffId], references: [id])
  // Queue
  queuePosition Int                  @default(1)
  priority      Int                  @default(100) // lower = higher priority
  status        LibReservationStatus @default(PENDING)
  // Timing
  reservedAt    DateTime             @default(now())
  availableAt   DateTime? // when book became available
  expiresAt     DateTime? // collection window deadline
  collectedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?              @db.VarChar(200)
  // Linked issue when collected
  issueId       Int?
  // Notification tracking
  notifiedAt    DateTime?
  notifiedVia   String?              @db.VarChar(20) // APP | SMS | EMAIL
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@index([schoolId, bookId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([staffId])
  @@index([schoolId, bookId, queuePosition])
  @@map("lib_reservations")
}


// Per-school reservation rules
model LibReservationRule {
  id                     Int      @id @default(autoincrement())
  schoolId               Int      @unique
  school                 School   @relation(fields: [schoolId], references: [id])
  // Limits
  maxReservationsStudent Int      @default(2)
  maxReservationsTeacher Int      @default(5)
  maxReservationsStaff   Int      @default(2)
  // Validity
  collectionWindowHours  Int      @default(48) // time to collect once notified
  reservationExpiryDays  Int      @default(30) // auto-cancel if book not returned in N days
  // Priority
  teacherPriority        Int      @default(10) // lower = higher priority
  studentPriority        Int      @default(50)
  staffPriority          Int      @default(30)
  // Notification
  notifyOnAvailable      Boolean  @default(true)
  notifyChannels         String[] @default(["APP_NOTIFICATION", "SMS"])
  notifyAdvanceDays      Int      @default(0) // notify N days before expiry
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("lib_reservation_rules")
}

model LibFineWaiver {
  id                Int             @id @default(autoincrement())
  schoolId          Int
  school            School          @relation(fields: [schoolId], references: [id])
  fineId            Int             @unique
  fine              LibFine         @relation(fields: [fineId], references: [id])
  // Requester
  requestedByUserId Int?
  requestedByName   String          @db.VarChar(200) // could be student/parent
  reason            String          @db.Text
  // Approval workflow
  status            LibWaiverStatus @default(PENDING)
  reviewedByUserId  Int?
  reviewedByName    String?         @db.VarChar(200)
  reviewNote        String?         @db.VarChar(400)
  reviewedAt        DateTime?
  // Partial waiver
  waivedAmount      Decimal?        @db.Decimal(10, 2) // null = full waiver
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("lib_fine_waivers")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY — PROCUREMENT REQUESTS
// ─────────────────────────────────────────────────────────────

model LibProcurementRequest {
  id              Int                  @id @default(autoincrement())
  schoolId        Int
  school          School               @relation(fields: [schoolId], references: [id])
  bookId          Int?
  book            LibBook?             @relation(fields: [bookId], references: [id])
  // Can also be for a new book not yet in catalog
  bookTitle       String               @db.VarChar(400)
  isbn            String?              @db.VarChar(30)
  authorName      String?              @db.VarChar(200)
  publisherName   String?              @db.VarChar(200)
  categoryId      Int?
  // Request details
  copiesRequested Int                  @default(1)
  copiesReceived  Int                  @default(0)
  estimatedCost   Decimal?             @db.Decimal(10, 2)
  actualCost      Decimal?             @db.Decimal(10, 2)
  reason          String?              @db.VarChar(400)
  priority        String               @default("NORMAL") @db.VarChar(20) // LOW, NORMAL, HIGH, URGENT
  status          LibProcurementStatus @default(DRAFT)
  // Approval
  requestedById   Int?
  approvedById    Int?
  approvedAt      DateTime?
  rejectionNote   String?              @db.VarChar(300)
  // Order details
  orderedAt       DateTime?
  receivedAt      DateTime?
  vendorName      String?              @db.VarChar(200)
  purchaseOrderNo String?              @db.VarChar(80)
  notes           String?              @db.VarChar(400)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, bookId])
  @@map("lib_procurement_requests")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY — STOCK VERIFICATION SESSION
// ─────────────────────────────────────────────────────────────

model LibStockVerification {
  id            Int       @id @default(autoincrement())
  schoolId      Int
  school        School    @relation(fields: [schoolId], references: [id])
  title         String    @db.VarChar(200) // e.g. "Annual Verification 2025-26"
  description   String?   @db.VarChar(400)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  isComplete    Boolean   @default(false)
  // Summary (populated on completion)
  totalChecked  Int       @default(0)
  totalVerified Int       @default(0)
  totalMissing  Int       @default(0)
  totalDamaged  Int       @default(0)
  conductedById Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items LibStockVerificationItem[]

  @@index([schoolId])
  @@map("lib_stock_verifications")
}

model LibStockVerificationItem {
  id             Int                   @id @default(autoincrement())
  verificationId Int
  verification   LibStockVerification  @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  copyId         Int
  copy           LibBookCopy           @relation(fields: [copyId], references: [id])
  status         LibVerificationStatus @default(VERIFIED)
  notes          String?               @db.VarChar(200)
  checkedAt      DateTime              @default(now())
  checkedById    Int?

  @@unique([verificationId, copyId])
  @@index([verificationId])
  @@index([copyId])
  @@map("lib_stock_verification_items")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY — AUDIT LOG (every copy status change)
// ─────────────────────────────────────────────────────────────

model LibInventoryLog {
  id        Int                @id @default(autoincrement())
  schoolId  Int
  school    School             @relation(fields: [schoolId], references: [id])
  copyId    Int
  copy      LibBookCopy        @relation(fields: [copyId], references: [id])
  action    LibInventoryAction
  // Before / After state
  oldValue  String?            @db.VarChar(200)
  newValue  String?            @db.VarChar(200)
  note      String?            @db.VarChar(200)
  userId    Int?
  createdAt DateTime           @default(now())

  @@index([schoolId])
  @@index([copyId])
  @@index([schoolId, action])
  @@index([schoolId, createdAt])
  @@map("lib_inventory_logs")
}

model InvCategory {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  color       String   @default("#6366f1") @db.VarChar(20)
  icon        String   @default("Package") @db.VarChar(50)
  isActive    Boolean  @default(true)
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())

  items  InvItem[]
  audits InvAudit[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("inv_categories")
}

model InvUnit {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  school    School  @relation(fields: [schoolId], references: [id])
  name      String  @db.VarChar(50) // Piece, Box, Pack, Kg, Liter, Ream, Set
  shortName String  @db.VarChar(20) // Pc, Bx, Kg, L
  isActive  Boolean @default(true)

  items InvItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("inv_units")
}

model InvBrand {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items InvItem[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("inv_brands")
}

model InvLocation {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @db.VarChar(100) // Main Store, Science Lab, IT Room
  code      String?  @db.VarChar(30)
  type      String   @default("STORE") @db.VarChar(30) // STORE, LAB, CLASSROOM, OFFICE
  floor     String?  @db.VarChar(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks        InvStock[]
  assignments   InvAssetAssignment[]
  auditItems    InvAuditItem[]
  audits        InvAudit[]
  transFromHere InvTransaction[]     @relation("InvFromLocation")
  transToHere   InvTransaction[]     @relation("InvToLocation")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("inv_locations")
}

// ── Item Master ───────────────────────────────────────────────

model InvItem {
  id                 Int             @id @default(autoincrement())
  schoolId           Int
  school             School          @relation(fields: [schoolId], references: [id])
  itemCode           String          @db.VarChar(40) // INV-0001
  barcode            String?         @db.VarChar(100)
  name               String          @db.VarChar(300)
  description        String?         @db.VarChar(500)
  categoryId         Int?
  category           InvCategory?    @relation(fields: [categoryId], references: [id])
  unitId             Int?
  unit               InvUnit?        @relation(fields: [unitId], references: [id])
  brandId            Int?
  brand              InvBrand?       @relation(fields: [brandId], references: [id])
  model              String?         @db.VarChar(150)
  trackingType       InvTrackingType @default(CONSUMABLE)
  status             InvItemStatus   @default(ACTIVE)
  // Financial
  purchasePrice      Decimal?        @db.Decimal(12, 2)
  expectedLifeMonths Int?
  // Asset-specific (only when trackingType = ASSET)
  assetStatus        InvAssetStatus? @default(AVAILABLE)
  serialNumber       String?         @db.VarChar(100)
  assetTag           String?         @db.VarChar(60)
  warrantyUntil      DateTime?       @db.Date
  // Stock thresholds
  minimumLevel       Int             @default(0)
  reorderLevel       Int             @default(0)
  // Image
  imageUrl           String?         @db.VarChar(600)
  // Meta
  tags               String[]
  isActive           Boolean         @default(true)
  createdById        Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  stocks            InvStock[]
  transactions      InvTransaction[]
  assignments       InvAssetAssignment[]
  transfers         InvAssetTransfer[]
  maintenanceReqs   InvMaintenanceRequest[]
  maintenanceAMCs   InvMaintenanceAMC[]
  maintenanceScheds InvMaintenanceSchedule[]
  auditItems        InvAuditItem[]
  requestItems      InvPurchaseRequestItem[]

  @@unique([schoolId, itemCode])
  @@index([schoolId])
  @@index([schoolId, categoryId])
  @@index([schoolId, trackingType])
  @@index([schoolId, status])
  @@map("inv_items")
}

// ── Stock (current quantity per item per location) ─────────

model InvStock {
  id         Int         @id @default(autoincrement())
  schoolId   Int
  school     School      @relation(fields: [schoolId], references: [id])
  itemId     Int
  item       InvItem     @relation(fields: [itemId], references: [id])
  locationId Int
  location   InvLocation @relation(fields: [locationId], references: [id])
  quantity   Int         @default(0)
  reserved   Int         @default(0)
  updatedAt  DateTime    @updatedAt

  @@unique([itemId, locationId])
  @@index([schoolId])
  @@index([itemId])
  @@index([locationId])
  @@map("inv_stocks")
}

// ── Transaction Ledger (every movement) ──────────────────────

model InvTransaction {
  id               Int                  @id @default(autoincrement())
  schoolId         Int
  school           School               @relation(fields: [schoolId], references: [id])
  txnCode          String               @db.VarChar(40) // INV-TXN-00001
  type             InvTransactionType
  itemId           Int
  item             InvItem              @relation(fields: [itemId], references: [id])
  quantity         Int
  // Source / Destination
  fromLocationId   Int?
  fromLocation     InvLocation?         @relation("InvFromLocation", fields: [fromLocationId], references: [id])
  toLocationId     Int?
  toLocation       InvLocation?         @relation("InvToLocation", fields: [toLocationId], references: [id])
  // Stock In fields
  source           InvStockInSource?
  supplierName     String?              @db.VarChar(200)
  purchasePrice    Decimal?             @db.Decimal(12, 2)
  invoiceNo        String?              @db.VarChar(80)
  // Stock Out fields
  destination      InvStockOutDest?
  issuedToStaffId  Int?
  issuedToStaff    Staff?               @relation("InvIssuedTo", fields: [issuedToStaffId], references: [id])
  purpose          String?              @db.VarChar(300)
  departmentName   String?              @db.VarChar(100)
  // Adjustment
  adjustmentReason InvAdjustmentReason?
  // Notes
  notes            String?              @db.VarChar(400)
  referenceNo      String?              @db.VarChar(80)
  txnDate          DateTime             @db.Date
  // Processed by
  processedById    Int?
  processedBy      Staff?               @relation("InvIssuedBy", fields: [processedById], references: [id])
  createdAt        DateTime             @default(now())

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([itemId])
  @@index([schoolId, txnDate])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("inv_transactions")
}

model InvPurchaseRequest {
  id             Int                @id @default(autoincrement())
  schoolId       Int
  school         School             @relation(fields: [schoolId], references: [id])
  requestCode    String             @db.VarChar(30) // PR-00001
  title          String             @db.VarChar(300)
  requestSource  String             @db.VarChar(100) // Library, Science Lab, etc.
  departmentName String?            @db.VarChar(100)
  priority       InvRequestPriority @default(MEDIUM)
  status         InvRequestStatus   @default(DRAFT)
  justification  String?            @db.Text
  // Budget
  estimatedCost  Decimal?           @db.Decimal(12, 2)
  approvedBudget Decimal?           @db.Decimal(12, 2)
  actualCost     Decimal?           @db.Decimal(12, 2)
  // Vendor (set when ordered)
  vendorId       Int?
  vendor         InvVendor?         @relation(fields: [vendorId], references: [id])
  invoiceNo      String?            @db.VarChar(80)
  // Workflow — who approved at each stage
  requestedById  Int?
  requestedBy    Staff?             @relation("InvReqRequestedBy", fields: [requestedById], references: [id])
  reviewedById   Int? // Dept Head
  reviewedAt     DateTime?
  approvedById   Int? // Principal
  approvedAt     DateTime?
  accountsById   Int? // Accounts
  accountsAt     DateTime?
  rejectedById   Int?
  rejectedAt     DateTime?
  rejectionNote  String?            @db.VarChar(300)
  orderedAt      DateTime?
  receivedAt     DateTime?
  closedAt       DateTime?
  notes          String?            @db.VarChar(400)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items InvPurchaseRequestItem[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, priority])
  @@map("inv_purchase_requests")
}

model InvPurchaseRequestItem {
  id          Int                @id @default(autoincrement())
  requestId   Int
  request     InvPurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        InvItem?           @relation(fields: [itemId], references: [id])
  itemName    String             @db.VarChar(300) // denormalised — also captures new items
  quantity    Int
  unitPrice   Decimal?           @db.Decimal(10, 2)
  totalPrice  Decimal?           @db.Decimal(12, 2)
  receivedQty Int                @default(0)
  notes       String?            @db.VarChar(200)

  @@index([requestId])
  @@map("inv_purchase_request_items")
}

model InvVendorCategory {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendors InvVendor[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("inv_vendor_categories")
}

model InvVendor {
  id                 Int                @id @default(autoincrement())
  schoolId           Int
  school             School             @relation(fields: [schoolId], references: [id])
  vendorCode         String             @db.VarChar(30)
  name               String             @db.VarChar(200)
  contactPerson      String?            @db.VarChar(100)
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(150)
  address            String?            @db.Text
  gstNumber          String?            @db.VarChar(30)
  panNumber          String?            @db.VarChar(20)
  categoryId         Int?
  category           InvVendorCategory? @relation(fields: [categoryId], references: [id])
  status             InvVendorStatus    @default(ACTIVE)
  isPreferred        Boolean            @default(false)
  // Performance metrics (denormalised)
  totalOrders        Int                @default(0)
  totalPurchaseValue Decimal            @default(0) @db.Decimal(14, 2)
  avgDeliveryDays    Int?
  qualityScore       Int? // 1–5
  deliveryScore      Int? // 1–5
  overallRating      Decimal?           @db.Decimal(3, 1) // 1.0–5.0
  // Contracts
  contractStart      DateTime?          @db.Date
  contractEnd        DateTime?          @db.Date
  warrantyTerms      String?            @db.VarChar(300)
  notes              String?            @db.VarChar(400)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  ratings             InvVendorRating[]
  purchaseRequests    InvPurchaseRequest[]
  maintenanceRequests InvMaintenanceRequest[]
  maintenanceAMCs     InvMaintenanceAMC[]

  @@unique([schoolId, vendorCode])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("inv_vendors")
}

model InvVendorRating {
  id        Int       @id @default(autoincrement())
  vendorId  Int
  vendor    InvVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating    Int // 1–5
  review    String?   @db.VarChar(400)
  orderId   Int? // link to purchase request
  ratedById Int?
  createdAt DateTime  @default(now())

  @@index([vendorId])
  @@map("inv_vendor_ratings")
}

model InvAssetAssignment {
  id                 Int                 @id @default(autoincrement())
  schoolId           Int
  school             School              @relation(fields: [schoolId], references: [id])
  itemId             Int
  item               InvItem             @relation(fields: [itemId], references: [id])
  assignmentCode     String              @db.VarChar(30)
  // Assignee — one of these
  staffId            Int?
  staff              Staff?              @relation("InvAssignedTo", fields: [staffId], references: [id])
  departmentName     String?             @db.VarChar(100)
  locationId         Int?
  location           InvLocation?        @relation(fields: [locationId], references: [id])
  // Assignment details
  status             InvAssignmentStatus @default(ACTIVE)
  issueDate          DateTime            @db.Date
  expectedReturnDate DateTime?           @db.Date
  actualReturnDate   DateTime?           @db.Date
  remarks            String?             @db.VarChar(300)
  returnNotes        String?             @db.VarChar(300)
  // Processed by
  assignedById       Int?
  returnedById       Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([schoolId])
  @@index([itemId])
  @@index([staffId])
  @@index([schoolId, status])
  @@map("inv_asset_assignments")
}

model InvAssetTransfer {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id])
  itemId       Int
  item         InvItem  @relation(fields: [itemId], references: [id])
  fromStaffId  Int?
  fromStaff    Staff?   @relation("InvTransferFrom", fields: [fromStaffId], references: [id])
  fromDept     String?  @db.VarChar(100)
  toStaffId    Int?
  toStaff      Staff?   @relation("InvTransferTo", fields: [toStaffId], references: [id])
  toDept       String?  @db.VarChar(100)
  transferDate DateTime @db.Date
  reason       String?  @db.VarChar(300)
  approvedById Int?
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([itemId])
  @@map("inv_asset_transfers")
}

model InvMaintenanceRequest {
  id             Int                    @id @default(autoincrement())
  schoolId       Int
  school         School                 @relation(fields: [schoolId], references: [id])
  requestCode    String                 @db.VarChar(30)
  itemId         Int
  item           InvItem                @relation(fields: [itemId], references: [id])
  type           InvMaintenanceType     @default(CORRECTIVE)
  priority       InvMaintenancePriority @default(MEDIUM)
  status         InvMaintenanceStatus   @default(OPEN)
  problemTitle   String                 @db.VarChar(300)
  description    String?                @db.Text
  vendorId       Int?
  vendor         InvVendor?             @relation(fields: [vendorId], references: [id])
  // Dates
  reportedDate   DateTime               @db.Date
  scheduledDate  DateTime?              @db.Date
  resolvedDate   DateTime?              @db.Date
  closedDate     DateTime?              @db.Date
  // Cost
  estimatedCost  Decimal?               @db.Decimal(10, 2)
  actualCost     Decimal?               @db.Decimal(10, 2)
  // Resolution
  resolutionNote String?                @db.VarChar(400)
  partsReplaced  String?                @db.VarChar(300)
  // Personnel
  reportedById   Int?
  assignedTo     String?                @db.VarChar(100)
  amcId          Int?
  amc            InvMaintenanceAMC?     @relation(fields: [amcId], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([schoolId])
  @@index([itemId])
  @@index([schoolId, status])
  @@index([schoolId, type])
  @@map("inv_maintenance_requests")
}

model InvMaintenanceAMC {
  id                     Int        @id @default(autoincrement())
  schoolId               Int
  school                 School     @relation(fields: [schoolId], references: [id])
  amcCode                String     @db.VarChar(30)
  title                  String     @db.VarChar(200)
  itemId                 Int?
  item                   InvItem?   @relation(fields: [itemId], references: [id])
  vendorId               Int?
  vendor                 InvVendor? @relation(fields: [vendorId], references: [id])
  startDate              DateTime   @db.Date
  endDate                DateTime   @db.Date
  renewalDate            DateTime?  @db.Date
  contractValue          Decimal?   @db.Decimal(10, 2)
  serviceFrequencyMonths Int?       @default(6)
  terms                  String?    @db.Text
  isActive               Boolean    @default(true)
  notes                  String?    @db.VarChar(300)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  maintenanceRequests InvMaintenanceRequest[]

  @@index([schoolId])
  @@index([itemId])
  @@map("inv_maintenance_amcs")
}

model InvMaintenanceSchedule {
  id              Int                @id @default(autoincrement())
  schoolId        Int
  school          School             @relation(fields: [schoolId], references: [id])
  itemId          Int
  item            InvItem            @relation(fields: [itemId], references: [id])
  title           String             @db.VarChar(200)
  type            InvMaintenanceType @default(PREVENTIVE)
  frequencyDays   Int                @default(180)
  lastServiceDate DateTime?          @db.Date
  nextServiceDate DateTime?          @db.Date
  vendorId        Int?
  estimatedCost   Decimal?           @db.Decimal(10, 2)
  isActive        Boolean            @default(true)
  notes           String?            @db.VarChar(300)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([schoolId])
  @@index([itemId])
  @@map("inv_maintenance_schedules")
}

model InvAudit {
  id            Int            @id @default(autoincrement())
  schoolId      Int
  school        School         @relation(fields: [schoolId], references: [id])
  auditCode     String         @db.VarChar(30)
  title         String         @db.VarChar(200)
  description   String?        @db.VarChar(400)
  locationId    Int?
  location      InvLocation?   @relation(fields: [locationId], references: [id])
  categoryId    Int?
  category      InvCategory?   @relation(fields: [categoryId], references: [id])
  status        InvAuditStatus @default(IN_PROGRESS)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  // Summary
  totalItems    Int            @default(0)
  verified      Int            @default(0)
  discrepancies Int            @default(0)
  conductedById Int?
  approvedById  Int?
  notes         String?        @db.VarChar(300)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items InvAuditItem[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("inv_audits")
}

model InvAuditItem {
  id                Int                 @id @default(autoincrement())
